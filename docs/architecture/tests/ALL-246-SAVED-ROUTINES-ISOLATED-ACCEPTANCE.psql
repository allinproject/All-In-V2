-- ALL-246. ONLY FOR DISPOSABLE ISOLATED POSTGRES WITH TWO SYNTHETIC
-- Supabase Auth users, v2_profiles and CURRENT auth.sessions.
-- Never use against hosted/production V2. Candidate SQL is not deployable.
--
-- Required psql variables supplied by the local fixture creator:
--   -v disposable_test=1 -v user_a=<UUID> -v session_a=<UUID>
--   -v user_b=<UUID> -v session_b=<UUID>
-- Preapply BOTH review-only candidate SQL files on the isolated database.
-- All temporary authenticated grants and test data are ROLLED BACK.
\set ON_ERROR_STOP on
\if :{?disposable_test}
\else
 \echo 'REFUSING: explicit disposable_test marker required'
 \quit 1
\endif
\if :{?user_a}
\else
 \echo 'REFUSING: seeded user_a missing'
 \quit 1
\endif
\if :{?session_a}
\else
 \echo 'REFUSING: seeded session_a missing'
 \quit 1
\endif
\if :{?user_b}
\else
 \echo 'REFUSING: seeded user_b missing'
 \quit 1
\endif
\if :{?session_b}
\else
 \echo 'REFUSING: seeded session_b missing'
 \quit 1
\endif

-- Verify candidate roles have zero table access and no EXECUTE BEFORE
-- the disposable transaction temporarily grants authenticated testing.
DO $closed$
DECLARE v_role text; v_table text; v_fn text;
BEGIN
 FOREACH v_role IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  FOREACH v_table IN ARRAY ARRAY[
    'public.v2_training_routines','public.v2_training_routine_versions',
    'allin_private.v2_training_routine_owner_epochs',
    'allin_private.v2_training_routine_actions'
  ] LOOP
   IF pg_catalog.has_table_privilege(v_role,v_table,'SELECT') OR
     pg_catalog.has_table_privilege(v_role,v_table,'INSERT') OR
     pg_catalog.has_table_privilege(v_role,v_table,'UPDATE') OR
     pg_catalog.has_table_privilege(v_role,v_table,'DELETE') THEN
    RAISE EXCEPTION 'FAIL: unexpected Routine table privilege for % on %',v_role,v_table;
   END IF;
  END LOOP;
  FOREACH v_fn IN ARRAY ARRAY[
   'allin_private.v2_training_routine_write_candidate(uuid,uuid,bigint,uuid,text,text,text,jsonb)',
   'allin_private.v2_training_routine_archive_candidate(uuid,uuid,bigint,uuid)',
   'allin_private.v2_training_routine_export_fragment_candidate(uuid)',
   'public.v2_training_routines_list_candidate(uuid,bigint,uuid,integer)',
   'public.v2_training_routine_version_candidate(uuid,bigint,uuid,bigint)'
  ] LOOP
   IF pg_catalog.has_function_privilege(v_role,v_fn,'EXECUTE') THEN
    RAISE EXCEPTION 'FAIL: unexpected Routine EXECUTE for % on %',v_role,v_fn;
   END IF;
  END LOOP;
 END LOOP;
END;
$closed$;

BEGIN;
-- Testing privilege grant exists ONLY inside this rolled-back transaction.
GRANT USAGE ON SCHEMA allin_private TO authenticated;
GRANT EXECUTE ON FUNCTION allin_private.v2_training_routine_assert_owner_candidate(uuid)
 TO authenticated;
GRANT EXECUTE ON FUNCTION allin_private.v2_training_routine_write_candidate(
 uuid,uuid,bigint,uuid,text,text,text,jsonb) TO authenticated;
GRANT EXECUTE ON FUNCTION allin_private.v2_training_routine_archive_candidate(
 uuid,uuid,bigint,uuid) TO authenticated;
GRANT EXECUTE ON FUNCTION public.v2_training_routines_list_candidate(
 uuid,bigint,uuid,integer) TO authenticated;
GRANT EXECUTE ON FUNCTION public.v2_training_routine_version_candidate(
 uuid,bigint,uuid,bigint) TO authenticated;
GRANT EXECUTE ON FUNCTION allin_private.v2_training_routine_export_fragment_candidate(uuid)
 TO authenticated;

SELECT pg_catalog.set_config('allin.test.user_a',:'user_a',true);
SELECT pg_catalog.set_config('allin.test.user_b',:'user_b',true);
SELECT pg_catalog.set_config('allin.test.session_a',:'session_a',true);
SELECT pg_catalog.set_config('allin.test.session_b',:'session_b',true);
SELECT pg_catalog.set_config('request.jwt.claim.sub',:'user_a',true);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',:'session_a',true);
SELECT pg_catalog.gen_random_uuid() AS test_create_action \gset
-- Actual fixture is explicitly authored; performance history is never
-- fabricated from Completed Activity evidence.
\set workout_block '[{"id":"draft-1","kind":"strength","exercise":"Squat","equipment":null,"notes":"","sets":3,"reps":"5","weight":null,"restSeconds":90,"setType":"working","groupId":null}]'

SET LOCAL ROLE authenticated;
DO $deny$
BEGIN
 BEGIN
  PERFORM 1 FROM public.v2_training_routines;
  RAISE EXCEPTION 'FAIL: direct table read unexpectedly allowed';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END;
$deny$;
-- Create once, then verify exact idempotent replay does not bump version.
SELECT (result->>'routineId')::uuid AS test_routine_a,
       (result->>'version')::bigint AS test_version
FROM (SELECT allin_private.v2_training_routine_write_candidate(
 :'user_a'::uuid,NULL,0,:'test_create_action'::uuid,
 'Strength A','strength','',:'workout_block'::jsonb) AS result) x \gset

SELECT (result->>'replayed')::boolean AS test_replayed,
       (result->>'version')::bigint AS test_replay_version,
       (result->>'routineId')::uuid AS test_replay_routine
FROM (SELECT allin_private.v2_training_routine_write_candidate(
 :'user_a'::uuid,NULL,0,:'test_create_action'::uuid,
 'Strength A','strength','',:'workout_block'::jsonb) AS result) x \gset
\if :test_replayed
\else
 \echo 'FAIL: exact action replay was not recognized'
 \quit 1
\endif
SELECT pg_catalog.set_config('allin.test.create_action',:'test_create_action',true);
SELECT pg_catalog.set_config('allin.test.replay_version',:'test_replay_version',true);
DO $replay$
BEGIN
 IF pg_catalog.current_setting('allin.test.replay_version')::bigint<>1 THEN
  RAISE EXCEPTION 'FAIL: replay changed the immutable version';
 END IF;
END;
$replay$;
-- Reusing the same action ID with altered workout content MUST reject the
-- replay, not return the earlier success or silently overwrite version 1.
DO $changed_replay$
BEGIN
 BEGIN
  PERFORM allin_private.v2_training_routine_write_candidate(
   pg_catalog.current_setting('allin.test.user_a')::uuid,NULL,0,
   pg_catalog.current_setting('allin.test.create_action')::uuid,'Changed after retry','strength','',
   '[{"id":"draft-1","kind":"strength","exercise":"Squat","equipment":null,"notes":"","sets":3,"reps":"5","weight":null,"restSeconds":90,"setType":"working","groupId":null}]'::jsonb);
  RAISE EXCEPTION 'FAIL: conflicting action replay accepted';
 EXCEPTION WHEN unique_violation THEN NULL;
 END;
END;
$changed_replay$;

DO $check$
DECLARE v_id uuid:=pg_catalog.current_setting('allin.test.user_a')::uuid;
BEGIN
 IF v_id IS NULL THEN RAISE EXCEPTION 'Fixture owner missing'; END IF;
END;
$check$;
SELECT pg_catalog.set_config('allin.test.routine_a',:'test_routine_a',true);
DO $check$
DECLARE v_record jsonb;
BEGIN
 v_record:=public.v2_training_routine_version_candidate(
  pg_catalog.current_setting('allin.test.user_a')::uuid,1,
  pg_catalog.current_setting('allin.test.routine_a')::uuid,1);
 IF v_record->>'name'<>'Strength A' OR
  pg_catalog.jsonb_array_length(v_record->'blocks')<>1 THEN
  RAISE EXCEPTION 'FAIL: source-backed exact owner version'; END IF;
END;
$check$;

DO $deny$
DECLARE v_id uuid:=pg_catalog.current_setting('allin.test.routine_a')::uuid;
 v_owner uuid:=pg_catalog.current_setting('allin.test.user_a')::uuid;
BEGIN
 BEGIN
  PERFORM allin_private.v2_training_routine_write_candidate(
   v_owner,v_id,0,pg_catalog.gen_random_uuid(),
   'Bad stale change','strength','',
   '[{"id":"draft-1","kind":"strength","exercise":"Squat","equipment":null,"notes":"","sets":3,"reps":"5","weight":null,"restSeconds":90,"setType":"working","groupId":null}]'::jsonb);
  RAISE EXCEPTION 'FAIL: stale version unexpectedly accepted';
 EXCEPTION WHEN serialization_failure THEN NULL;
 END;
END;
$deny$;

RESET ROLE;
SELECT pg_catalog.set_config('request.jwt.claim.sub',:'user_b',true);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',:'session_b',true);
SET LOCAL ROLE authenticated;
DO $isolate$
DECLARE v_detail jsonb;v_page jsonb;
BEGIN
 v_detail:=public.v2_training_routine_version_candidate(
  pg_catalog.current_setting('allin.test.user_b')::uuid,1,
  pg_catalog.current_setting('allin.test.routine_a')::uuid,1);
 IF v_detail IS NOT NULL THEN
  RAISE EXCEPTION 'FAIL: user B can read user A routine'; END IF;
 v_page:=public.v2_training_routines_list_candidate(
  pg_catalog.current_setting('allin.test.user_b')::uuid,1,NULL,100);
 IF pg_catalog.jsonb_array_length(v_page->'records')<>0 THEN
  RAISE EXCEPTION 'FAIL: user B can list user A routine'; END IF;
 BEGIN
  PERFORM public.v2_training_routine_version_candidate(
   pg_catalog.current_setting('allin.test.user_a')::uuid,1,
   pg_catalog.current_setting('allin.test.routine_a')::uuid,1);
  RAISE EXCEPTION 'FAIL: B can impersonate expected user A';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
 BEGIN
  PERFORM allin_private.v2_training_routine_write_candidate(
   pg_catalog.current_setting('allin.test.user_a')::uuid,
   pg_catalog.current_setting('allin.test.routine_a')::uuid,1,
   pg_catalog.gen_random_uuid(),'Hijacked','strength','',
   '[{"id":"draft-1","kind":"strength","exercise":"Squat","equipment":null,"notes":"","sets":3,"reps":"5","weight":null,"restSeconds":90,"setType":"working","groupId":null}]'::jsonb);
  RAISE EXCEPTION 'FAIL: B can write A routine';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END;
$isolate$;
-- B owns a separate routine; deleting A later must preserve B's history.
SELECT pg_catalog.gen_random_uuid() AS test_create_action_b \gset
SELECT (result->>'routineId')::uuid AS test_routine_b
FROM (SELECT allin_private.v2_training_routine_write_candidate(
 :'user_b'::uuid,NULL,0,:'test_create_action_b'::uuid,
 'Strength B','strength','',:'workout_block'::jsonb) AS result) x \gset
DO $export_b$
DECLARE v jsonb;
BEGIN
 v:=allin_private.v2_training_routine_export_fragment_candidate(
   pg_catalog.current_setting('allin.test.user_b')::uuid);
 IF v->>'completeAccountExport'<>'false'
   OR pg_catalog.jsonb_array_length(v#>'{records,public.v2_training_routines}')<>1
   OR v#>>'{records,public.v2_training_routines,0,user_id}'<>
     pg_catalog.current_setting('allin.test.user_b') THEN
  RAISE EXCEPTION 'FAIL: B export is incomplete or leaked another owner';
 END IF;
 BEGIN
  PERFORM allin_private.v2_training_routine_export_fragment_candidate(
   pg_catalog.current_setting('allin.test.user_a')::uuid);
  RAISE EXCEPTION 'FAIL: user B could export user A routines';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END;
$export_b$;
RESET ROLE;
-- Archive is a soft lifecycle operation, not a completed-workout deletion.
SELECT pg_catalog.set_config('request.jwt.claim.sub',:'user_a',true);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',:'session_a',true);
SELECT pg_catalog.gen_random_uuid() AS test_archive_action \gset
SET LOCAL ROLE authenticated;
SELECT (result->>'archived')::boolean AS test_archived,
       (result->>'replayed')::boolean AS test_archive_replayed
FROM (SELECT allin_private.v2_training_routine_archive_candidate(
 :'user_a'::uuid,:'test_routine_a'::uuid,1,:'test_archive_action'::uuid
) AS result) x \gset
\if :test_archived
\else
 \echo 'FAIL: archive was not recorded'
 \quit 1
\endif
DO $archive$
DECLARE v_detail jsonb;v_page jsonb;
BEGIN
 v_detail:=public.v2_training_routine_version_candidate(
  pg_catalog.current_setting('allin.test.user_a')::uuid,1,
  pg_catalog.current_setting('allin.test.routine_a')::uuid,1);
 IF v_detail IS NOT NULL THEN
  RAISE EXCEPTION 'FAIL: archived Routine still served as active'; END IF;
 v_page:=public.v2_training_routines_list_candidate(
  pg_catalog.current_setting('allin.test.user_a')::uuid,1,NULL,100);
 IF pg_catalog.jsonb_array_length(v_page->'records')<>0 THEN
  RAISE EXCEPTION 'FAIL: archived Routine listed as active'; END IF;
END;
$archive$;
RESET ROLE;
DO $history$
BEGIN
 IF NOT EXISTS(
  SELECT 1 FROM public.v2_training_routine_versions v
  WHERE v.routine_id=pg_catalog.current_setting('allin.test.routine_a')::uuid
    AND v.user_id=pg_catalog.current_setting('allin.test.user_a')::uuid
    AND v.version=1
 ) THEN RAISE EXCEPTION 'FAIL: archive destroyed immutable Routine version'; END IF;
END;
$history$;
-- Export includes archived immutable versions and private owner action receipts.
SET LOCAL ROLE authenticated;
DO $export_a$
DECLARE v jsonb;
BEGIN
 v:=allin_private.v2_training_routine_export_fragment_candidate(
   pg_catalog.current_setting('allin.test.user_a')::uuid);
 IF pg_catalog.jsonb_array_length(v#>'{records,public.v2_training_routines}')<>1
   OR pg_catalog.jsonb_array_length(v#>'{records,public.v2_training_routine_versions}')<>1
   OR pg_catalog.jsonb_array_length(v#>'{records,allin_private.v2_training_routine_owner_epochs}')<>1
   OR pg_catalog.jsonb_array_length(v#>'{records,allin_private.v2_training_routine_actions}')<>2
   OR v->>'completeAccountExport'<>'false' THEN
  RAISE EXCEPTION 'FAIL: A Routine export fragment omitted owner data';
 END IF;
END;
$export_a$;
RESET ROLE;
CREATE TEMP TABLE all246_restore_snapshot AS
 SELECT allin_private.v2_training_routine_export_fragment_candidate(
 pg_catalog.current_setting('allin.test.user_a')::uuid) AS payload;
-- A syntactically valid session belonging to a different user is not
-- sufficient authorization, even if request.jwt.claim.sub still says A.
SELECT pg_catalog.set_config('request.jwt.claim.session_id',:'session_b',true);
SET LOCAL ROLE authenticated;
DO $revoke$
BEGIN
 BEGIN
  PERFORM public.v2_training_routines_list_candidate(
   pg_catalog.current_setting('allin.test.user_a')::uuid,1,NULL,100);
  RAISE EXCEPTION 'FAIL: cross-account Auth session accepted for Routine read';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
 BEGIN
  PERFORM allin_private.v2_training_routine_export_fragment_candidate(
   pg_catalog.current_setting('allin.test.user_a')::uuid);
  RAISE EXCEPTION 'FAIL: cross-account Auth session accepted for Routine export';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END;
$revoke$;
RESET ROLE;
SELECT pg_catalog.set_config('request.jwt.claim.session_id',:'session_a',true);
-- Synthetic account deletion is performed by the disposable fixture owner,
-- not by any client or proposed account-deletion API. The user's other domains
-- remain under ALL-251 canonical account-deletion acceptance.
DELETE FROM auth.users WHERE id=:'user_a'::uuid;
DO $teardown$
DECLARE v_owner uuid:=pg_catalog.current_setting('allin.test.user_a')::uuid;
 v_other uuid:=pg_catalog.current_setting('allin.test.user_b')::uuid;
BEGIN
 IF EXISTS(SELECT 1 FROM public.v2_training_routines WHERE user_id=v_owner)
  OR EXISTS(SELECT 1 FROM public.v2_training_routine_versions WHERE user_id=v_owner)
  OR EXISTS(SELECT 1 FROM allin_private.v2_training_routine_owner_epochs WHERE user_id=v_owner)
  OR EXISTS(SELECT 1 FROM allin_private.v2_training_routine_actions WHERE user_id=v_owner)
  OR EXISTS(SELECT 1 FROM auth.sessions WHERE user_id=v_owner)
  THEN RAISE EXCEPTION 'FAIL: routine private owner graph survived Auth deletion'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.v2_training_routines WHERE user_id=v_other)
  OR NOT EXISTS(SELECT 1 FROM public.v2_training_routine_versions WHERE user_id=v_other)
  OR NOT EXISTS(SELECT 1 FROM auth.sessions WHERE user_id=v_other)
  THEN RAISE EXCEPTION 'FAIL: deleting user A damaged B routines'; END IF;
END;
$teardown$;
-- Recreate the same synthetic Auth owner and restore ONLY from the captured,
-- owner-scoped Routine fragment (not another user's rows).
INSERT INTO auth.users(id) VALUES (:'user_a'::uuid);
INSERT INTO auth.sessions(id,user_id) VALUES (:'session_a'::uuid,:'user_a'::uuid);
INSERT INTO public.v2_profiles(user_id) VALUES (:'user_a'::uuid);
INSERT INTO public.v2_training_routines(
 id,user_id,current_version,is_favorite,archived_at,created_at,updated_at
) SELECT x.id,x.user_id,x.current_version,x.is_favorite,
 x.archived_at,x.created_at,x.updated_at
 FROM all246_restore_snapshot s,
 pg_catalog.jsonb_to_recordset(s.payload#>'{records,public.v2_training_routines}')
 AS x(id uuid,user_id uuid,current_version bigint,is_favorite boolean,
      archived_at timestamptz,created_at timestamptz,updated_at timestamptz);
INSERT INTO public.v2_training_routine_versions(
 routine_id,user_id,version,schema_version,name,sport,notes,blocks,source_kind,created_at
) SELECT x.routine_id,x.user_id,x.version,x.schema_version,
 x.name,x.sport,x.notes,x.blocks,x.source_kind,x.created_at
 FROM all246_restore_snapshot s,
 pg_catalog.jsonb_to_recordset(s.payload#>'{records,public.v2_training_routine_versions}')
 AS x(routine_id uuid,user_id uuid,version bigint,schema_version integer,
      name text,sport text,notes text,blocks jsonb,source_kind text,created_at timestamptz);
INSERT INTO allin_private.v2_training_routine_owner_epochs(user_id,epoch)
 SELECT x.user_id,x.epoch
 FROM all246_restore_snapshot s,
 pg_catalog.jsonb_to_recordset(s.payload#>'{records,allin_private.v2_training_routine_owner_epochs}')
 AS x(user_id uuid,epoch bigint);
INSERT INTO allin_private.v2_training_routine_actions(
 user_id,action_id,payload_digest,routine_id,result_version,created_at
) SELECT x.user_id,x.action_id,x.payload_digest,x.routine_id,x.result_version,x.created_at
 FROM all246_restore_snapshot s,
 pg_catalog.jsonb_to_recordset(s.payload#>'{records,allin_private.v2_training_routine_actions}')
 AS x(user_id uuid,action_id uuid,payload_digest text,routine_id uuid,
      result_version bigint,created_at timestamptz);
DO $restored$
DECLARE a uuid:=pg_catalog.current_setting('allin.test.user_a')::uuid;
 b uuid:=pg_catalog.current_setting('allin.test.user_b')::uuid;
 v jsonb;
BEGIN
 IF (SELECT count(*) FROM public.v2_training_routines WHERE user_id=a)<>1
 OR (SELECT count(*) FROM public.v2_training_routine_versions WHERE user_id=a)<>1
 OR (SELECT count(*) FROM allin_private.v2_training_routine_owner_epochs WHERE user_id=a)<>1
 OR (SELECT count(*) FROM allin_private.v2_training_routine_actions WHERE user_id=a)<>2
 OR (SELECT count(*) FROM public.v2_training_routines WHERE user_id=b)<>1 THEN
   RAISE EXCEPTION 'FAIL: restored Routine graph does not match isolated snapshot';
 END IF;
 v:=allin_private.v2_training_routine_export_fragment_candidate(a);
 IF (v->'records') IS DISTINCT FROM
   (SELECT payload->'records' FROM all246_restore_snapshot) THEN
   RAISE EXCEPTION 'FAIL: re-export differs after Routine restore round trip';
 END IF;
END;
$restored$;
-- Revoking the Auth session invalidates all Routine read/write/export paths.
DELETE FROM auth.sessions WHERE id=:'session_a'::uuid;
SET LOCAL ROLE authenticated;
DO $revoked_session$
DECLARE v_owner uuid:=pg_catalog.current_setting('allin.test.user_a')::uuid;
 v_id uuid:=pg_catalog.current_setting('allin.test.routine_a')::uuid;
BEGIN
 BEGIN
  PERFORM public.v2_training_routines_list_candidate(v_owner,1,NULL,100);
  RAISE EXCEPTION 'FAIL: revoked session could list routines';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_routine_version_candidate(v_owner,1,v_id,1);
  RAISE EXCEPTION 'FAIL: revoked session could open version';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_training_routine_export_fragment_candidate(v_owner);
  RAISE EXCEPTION 'FAIL: revoked session could export';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_training_routine_write_candidate(
   v_owner,v_id,1,pg_catalog.gen_random_uuid(),
   'Revoked session change','strength','',
   '[{"id":"draft-1","kind":"strength","exercise":"Squat","equipment":null,"notes":"","sets":3,"reps":"5","weight":null,"restSeconds":90,"setType":"working","groupId":null}]'::jsonb);
  RAISE EXCEPTION 'FAIL: revoked session could write';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END;
$revoked_session$;
RESET ROLE;
ROLLBACK;
\echo 'PASS only if every assertion completed; test data and test grants rolled back'
