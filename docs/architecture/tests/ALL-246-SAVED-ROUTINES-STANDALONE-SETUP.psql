\set ON_ERROR_STOP on
-- ALL-246: disposable PostgreSQL 17 acceptance fixture.
-- Run ONLY inside a fresh scratch PostgreSQL cluster, never Supabase hosted.
-- This creates synthetic Auth-compatible principals, not real accounts.
\if :{?disposable_test}
\else
 \echo 'REFUSING: disposable_test marker required'
 \quit 1
\endif
CREATE ROLE anon NOLOGIN;
CREATE ROLE authenticated NOLOGIN;
CREATE ROLE service_role NOLOGIN;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users (id uuid PRIMARY KEY);
CREATE TABLE auth.sessions (
 id uuid PRIMARY KEY,
 user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE
);
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $uid$
 SELECT NULLIF(
   pg_catalog.current_setting('request.jwt.claim.sub',true),''
 )::uuid;
$uid$;
CREATE FUNCTION auth.jwt() RETURNS jsonb LANGUAGE sql STABLE AS $jwt$
 SELECT pg_catalog.jsonb_build_object('sub',
   NULLIF(pg_catalog.current_setting('request.jwt.claim.sub',true),''),
   'session_id',
   NULLIF(pg_catalog.current_setting('request.jwt.claim.session_id',true),''));
$jwt$;
GRANT USAGE ON SCHEMA auth TO authenticated;
GRANT EXECUTE ON FUNCTION auth.uid() TO authenticated;
CREATE TABLE public.v2_profiles (
 user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE
);
INSERT INTO auth.users(id) VALUES
 ('11111111-1111-4111-8111-111111111111'),
 ('22222222-2222-4222-8222-222222222222');
INSERT INTO auth.sessions(id,user_id) VALUES
 ('aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','11111111-1111-4111-8111-111111111111'),
 ('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','22222222-2222-4222-8222-222222222222');
INSERT INTO public.v2_profiles(user_id) SELECT id FROM auth.users;

\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SAVED-ROUTINES-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SAVED-ROUTINES-READ-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SAVED-ROUTINES-ARCHIVE-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SAVED-ROUTINES-EXPORT-FRAGMENT-CANDIDATE.sql

-- Session fixtures are constrained to a genuine matching record in this
-- isolated auth.sessions table. Real hosted Supabase auth is NOT substituted.
\set user_a 11111111-1111-4111-8111-111111111111
\set session_a aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
\set user_b 22222222-2222-4222-8222-222222222222
\set session_b bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
\i /tmp/allin/docs/architecture/tests/ALL-246-SAVED-ROUTINES-ISOLATED-ACCEPTANCE.psql
\i /tmp/allin/docs/architecture/tests/ALL-246-SAVED-ROUTINES-GATEWAY-ACCEPTANCE.psql
