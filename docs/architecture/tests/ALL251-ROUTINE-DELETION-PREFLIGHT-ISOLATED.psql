\set ON_ERROR_STOP on
-- ALL-251/246: disposable PG17 only. Execute after the two-user Routine
-- standalone setup. Nothing is deployed, no account deletion is performed.
\if :{?disposable_test}
\else
 \echo 'REFUSING non-disposable Routine deletion preflight test'
 \quit 1
\endif
BEGIN;
CREATE SCHEMA IF NOT EXISTS storage;
CREATE TABLE storage.buckets(id text PRIMARY KEY);
CREATE TABLE allin_private.v2_account_deletion_processor_config(
 singleton boolean PRIMARY KEY CHECK(singleton),
 execution_enabled boolean NOT NULL DEFAULT false
);
INSERT INTO allin_private.v2_account_deletion_processor_config
 VALUES(true,false);
CREATE TABLE allin_private.v2_account_deletion_requests(
 user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
 request_id uuid UNIQUE NOT NULL,
 status text NOT NULL,
 requested_at timestamptz NOT NULL DEFAULT now(),
 updated_at timestamptz NOT NULL DEFAULT now()
);
INSERT INTO allin_private.v2_account_deletion_requests(user_id,request_id,status)
VALUES('11111111-1111-4111-8111-111111111111',
 'c1111111-1111-4111-8111-111111111111','requested');
\i /tmp/allin/docs/architecture/sql/V2-ALL251-ROUTINE-DELETE-CASCADE-PREFLIGHT-REVIEW-CANDIDATE.sql
DO $grants$
BEGIN
 IF pg_catalog.has_function_privilege('anon',
 'public.v2_claim_account_deletion_for_processing(uuid,uuid)','EXECUTE')
 OR pg_catalog.has_function_privilege('authenticated',
 'public.v2_claim_account_deletion_for_processing(uuid,uuid)','EXECUTE')
 OR NOT pg_catalog.has_function_privilege('service_role',
 'public.v2_claim_account_deletion_for_processing(uuid,uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'FAIL: deletion-claim service-only grants changed'; END IF;
END;
$grants$;
SET LOCAL ROLE service_role;
DO $default_off$
BEGIN
 BEGIN
  PERFORM public.v2_claim_account_deletion_for_processing(
   '11111111-1111-4111-8111-111111111111',
   'c1111111-1111-4111-8111-111111111111');
  RAISE EXCEPTION 'FAIL: disabled account deletion processor claimed owner';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END;
$default_off$;
RESET ROLE;
UPDATE allin_private.v2_account_deletion_processor_config
 SET execution_enabled=true WHERE singleton=true;
-- Any unreviewed user_id table without verified cascade must STILL block.
SAVEPOINT unreviewed;
CREATE TABLE public.v2_all251_unreviewed_cascade_probe (
 user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE NO ACTION
);
SET LOCAL ROLE service_role;
DO $unreviewed$
BEGIN
 BEGIN
  PERFORM public.v2_claim_account_deletion_for_processing(
   '11111111-1111-4111-8111-111111111111',
   'c1111111-1111-4111-8111-111111111111');
  RAISE EXCEPTION 'FAIL: noncascading future user table was ignored';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END;$unreviewed$;
RESET ROLE;
ROLLBACK TO SAVEPOINT unreviewed;
-- If the composite Routine-version cascade is removed, claim must reject.
SAVEPOINT broken_routine_fk;
DO $break_fk$
DECLARE v_constraint text;
BEGIN
 SELECT conname INTO v_constraint FROM pg_catalog.pg_constraint
 WHERE conrelid='public.v2_training_routine_versions'::regclass
   AND confrelid='public.v2_training_routines'::regclass
   AND contype='f' AND confdeltype='c';
 IF v_constraint IS NULL THEN RAISE EXCEPTION 'FAIL: expected version FK absent'; END IF;
 EXECUTE pg_catalog.format(
 'ALTER TABLE public.v2_training_routine_versions DROP CONSTRAINT %I',v_constraint);
END;$break_fk$;
SET LOCAL ROLE service_role;
DO $no_fk$
BEGIN
 BEGIN
  PERFORM public.v2_claim_account_deletion_for_processing(
   '11111111-1111-4111-8111-111111111111',
   'c1111111-1111-4111-8111-111111111111');
  RAISE EXCEPTION 'FAIL: broken Routine owner cascade was ignored';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END;$no_fk$;
RESET ROLE;
ROLLBACK TO SAVEPOINT broken_routine_fk;
-- Exact reviewed chain is now accepted, without changing any source rows.
SET LOCAL ROLE service_role;
DO $accepted$
DECLARE v jsonb;
BEGIN
 v:=public.v2_claim_account_deletion_for_processing(
  '11111111-1111-4111-8111-111111111111',
  'c1111111-1111-4111-8111-111111111111');
 IF v->>'status'<>'processing'
 THEN RAISE EXCEPTION 'FAIL: verified Routine cascade still blocks claim'; END IF;
END;$accepted$;
RESET ROLE;
ROLLBACK;
\echo 'PASS ALL-251: Routine composite Auth cascade accepted; broken/unreviewed FK and disabled processor denied'
