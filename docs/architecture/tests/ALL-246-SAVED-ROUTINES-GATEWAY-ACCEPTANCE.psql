\set ON_ERROR_STOP on
-- ALL-246: disposable PG17 only; run AFTER standalone Auth/Routine setup.
-- All granted client RPCs are tested as authenticated role; no shared staging.
\if :{?disposable_test}
\else
 \echo 'REFUSING non-disposable gateway test'
 \quit 1
\endif
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SAVED-ROUTINES-AUTH-GATEWAY-CANDIDATE.sql

DO $permissions$
DECLARE v_fn text;v_role text;
BEGIN
 FOREACH v_fn IN ARRAY ARRAY[
 'public.v2_training_routine_list_owner_candidate(uuid,bigint,uuid,integer)',
 'public.v2_training_routine_read_owner_candidate(uuid,bigint,uuid,bigint)',
 'public.v2_training_routine_save_owner_candidate(uuid,uuid,bigint,uuid,text,text,text,jsonb)',
 'public.v2_training_routine_archive_owner_candidate(uuid,uuid,bigint,uuid)'
 ] LOOP
  IF NOT pg_catalog.has_function_privilege('authenticated',v_fn,'EXECUTE')
  OR pg_catalog.has_function_privilege('anon',v_fn,'EXECUTE')
  OR pg_catalog.has_function_privilege('service_role',v_fn,'EXECUTE')
  THEN RAISE EXCEPTION 'FAIL: incorrect gateway ACL for %',v_fn; END IF;
 END LOOP;
 FOREACH v_role IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF pg_catalog.has_function_privilege(v_role,
    'allin_private.v2_training_routine_write_candidate(uuid,uuid,bigint,uuid,text,text,text,jsonb)','EXECUTE')
  OR pg_catalog.has_table_privilege(v_role,'public.v2_training_routines','SELECT')
  OR pg_catalog.has_table_privilege(v_role,'public.v2_training_routines','INSERT')
  OR pg_catalog.has_table_privilege(v_role,'public.v2_training_routine_versions','SELECT')
  THEN RAISE EXCEPTION 'FAIL: direct private/table privilege leaked to %',v_role; END IF;
 END LOOP;
END;
$permissions$;

BEGIN;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '11111111-1111-4111-8111-111111111111',true);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',true);
SELECT pg_catalog.gen_random_uuid() AS test_gateway_action \gset
\set gateway_block '[{"kind":"strength","id":"draft-1","exercise":"Squat","equipment":null,"notes":"","sets":3,"reps":"5","weight":null,"restSeconds":90,"setType":"working","groupId":null}]'
SET LOCAL ROLE authenticated;
DO $unauthorized$
BEGIN
 BEGIN
  PERFORM 1 FROM public.v2_training_routines;
  RAISE EXCEPTION 'FAIL: direct Routine table read available to client';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_training_routine_write_candidate(
   '11111111-1111-4111-8111-111111111111',NULL,0,
   pg_catalog.gen_random_uuid(),'Denied','strength','',
   '[]'::jsonb);
  RAISE EXCEPTION 'FAIL: private writer callable by client';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END;
$unauthorized$;
SELECT (v->>'routineId')::uuid AS test_gateway_routine,
 (v->>'version')::bigint AS test_gateway_version
FROM (SELECT public.v2_training_routine_save_owner_candidate(
 '11111111-1111-4111-8111-111111111111',NULL,0,:'test_gateway_action'::uuid,
 'Gateway Strength','strength','',:'gateway_block'::jsonb) AS v) x \gset
SELECT pg_catalog.set_config('allin.test.gateway_routine',:'test_gateway_routine',true);
DO $owner$
DECLARE v_owner uuid:='11111111-1111-4111-8111-111111111111';
 v_routine uuid:=pg_catalog.current_setting('allin.test.gateway_routine')::uuid;
 v_page jsonb;v_detail jsonb;
BEGIN
 v_page:=public.v2_training_routine_list_owner_candidate(v_owner,1,NULL,100);
 v_detail:=public.v2_training_routine_read_owner_candidate(v_owner,1,v_routine,1);
 IF pg_catalog.jsonb_array_length(v_page->'records')<>1
 OR v_page#>>'{records,0,routineId}'<>v_routine::text
 OR v_page->>'snapshotVersion' IS NULL
 OR v_detail->>'name'<>'Gateway Strength' OR
 v_detail->>'identity'<>'canonical_saved_routine'
 THEN RAISE EXCEPTION 'FAIL: authenticated owner could not list/read saved Routine'; END IF;
 BEGIN
  PERFORM public.v2_training_routine_list_owner_candidate(
   '22222222-2222-4222-8222-222222222222',1,NULL,100);
  RAISE EXCEPTION 'FAIL: owner A listed B';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_routine_save_owner_candidate(
   '22222222-2222-4222-8222-222222222222',v_routine,1,
   pg_catalog.gen_random_uuid(),'Hijack','strength','',
   '[{"kind":"strength","id":"draft-1","exercise":"Squat","equipment":null,"notes":"","sets":3,"reps":"5","weight":null,"restSeconds":90,"setType":"working","groupId":null}]'::jsonb);
  RAISE EXCEPTION 'FAIL: owner A changed B';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END;
$owner$;
RESET ROLE;
-- Switch to B with B's real synthetic active session; a guessed exact
-- Routine ID and version still MUST not return A's records.
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '22222222-2222-4222-8222-222222222222',true);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',true);
SET LOCAL ROLE authenticated;
DO $b$
DECLARE v uuid:=pg_catalog.current_setting('allin.test.gateway_routine')::uuid;
BEGIN
 IF public.v2_training_routine_read_owner_candidate(
  '22222222-2222-4222-8222-222222222222',1,v,1) IS NOT NULL
 THEN RAISE EXCEPTION 'FAIL: guessed A Routine exposed to B'; END IF;
 IF pg_catalog.jsonb_array_length((
  public.v2_training_routine_list_owner_candidate(
   '22222222-2222-4222-8222-222222222222',1,NULL,100))->'records')<>0
 THEN RAISE EXCEPTION 'FAIL: B listed A routines'; END IF;
END;
$b$;
RESET ROLE;
-- A's valid but foreign B session is not sufficient authorization.
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '11111111-1111-4111-8111-111111111111',true);
SET LOCAL ROLE authenticated;
DO $mismatch$
BEGIN
 BEGIN
  PERFORM public.v2_training_routine_list_owner_candidate(
   '11111111-1111-4111-8111-111111111111',1,NULL,100);
  RAISE EXCEPTION 'FAIL: mismatched Auth session accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END;
$mismatch$;
RESET ROLE;
ROLLBACK;
\echo 'PASS ALL-246: four owner RPCs, least-privilege ACL, own CRUD and foreign sessions denied'
