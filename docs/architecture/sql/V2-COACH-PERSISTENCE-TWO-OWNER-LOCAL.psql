\set ON_ERROR_STOP on
-- ALL-222 disposable LOCAL Supabase only, never run on production.
-- Prerequisite: install docs/architecture/sql/V2-COACH-PERSISTENCE-CANDIDATE.sql
-- and run V2-COACH-PERSISTENCE-SECURITY-CHECKS.sql on this same local database.
-- Full transaction rollback leaves NO synthetic athlete rows behind.
BEGIN;

-- Supabase Auth user trigger creates the linked V2 profile/settings rows.
INSERT INTO auth.users (instance_id,id,aud,role,email,encrypted_password,
  email_confirmed_at,created_at,updated_at)
VALUES
('00000000-0000-0000-0000-000000000000',
 'a1111111-1111-4111-8111-111111111111','authenticated','authenticated',
 'coach-fixture-a@invalid.example','','2026-11-11 12:00+00',now(),now()),
('00000000-0000-0000-0000-000000000000',
 'b2222222-2222-4222-8222-222222222222','authenticated','authenticated',
 'coach-fixture-b@invalid.example','','2026-11-11 12:00+00',now(),now());

SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub', 'a1111111-1111-4111-8111-111111111111', true);
SELECT thread_id AS a_thread INTO TEMP TABLE _coach_a_thread
  FROM public.v2_coach_get_or_create_thread();
DO $$
BEGIN
 IF (SELECT thread_id FROM public.v2_coach_get_or_create_thread())
    IS DISTINCT FROM (SELECT thread_id FROM _coach_a_thread) THEN
  RAISE EXCEPTION 'owner A first-open not stable';
 END IF;
END $$;

GRANT SELECT ON _coach_a_thread TO service_role;
CREATE TEMP TABLE _coach_a_message AS
SELECT public.v2_coach_append_user_message(
  (SELECT thread_id FROM _coach_a_thread),
  'a1111111-0000-4000-8000-111111111111', 'First runner message'
) AS id;

DO $$
DECLARE v_id uuid;
BEGIN
 SELECT public.v2_coach_append_user_message(
   (SELECT thread_id FROM _coach_a_thread),
   'a1111111-0000-4000-8000-111111111111', 'First runner message'
 ) INTO v_id;
 IF v_id IS DISTINCT FROM (SELECT id FROM _coach_a_message) THEN
  RAISE EXCEPTION 'exact retry generated duplicate id';
 END IF;
 BEGIN
  PERFORM public.v2_coach_append_user_message(
   (SELECT thread_id FROM _coach_a_thread),
   'a1111111-0000-4000-8000-111111111111', 'Different payload'
  );
  RAISE EXCEPTION 'same action ID with changed payload unexpectedly accepted';
 EXCEPTION WHEN unique_violation THEN NULL;
 END;
 IF (SELECT count(*) FROM public.v2_coach_read_messages(
   (SELECT thread_id FROM _coach_a_thread))) <> 1 THEN
  RAISE EXCEPTION 'wrong owner A history count';
 END IF;
END $$;

-- Switch auth principal without logging out the database connection.
SELECT set_config('request.jwt.claim.sub', 'b2222222-2222-4222-8222-222222222222', true);
GRANT SELECT ON _coach_a_message TO service_role;
CREATE TEMP TABLE _coach_b_thread AS
 SELECT thread_id FROM public.v2_coach_get_or_create_thread();
DO $$
BEGIN
 IF (SELECT thread_id FROM _coach_b_thread) =
    (SELECT thread_id FROM _coach_a_thread) THEN
  RAISE EXCEPTION 'thread identity crossed users';
 END IF;
 BEGIN
  PERFORM * FROM public.v2_coach_read_messages(
    (SELECT thread_id FROM _coach_a_thread));
  RAISE EXCEPTION 'owner B read owner A history';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
 BEGIN
  PERFORM public.v2_coach_append_user_message(
    (SELECT thread_id FROM _coach_a_thread),
    'b2222222-0000-4000-8000-222222222222', 'Cross owner write'
  );
  RAISE EXCEPTION 'owner B wrote owner A thread';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END $$;
RESET ROLE;

SET LOCAL ROLE service_role;
SELECT public.v2_coach_record_assistant_reply(
 'a1111111-1111-4111-8111-111111111111',
 (SELECT thread_id FROM _coach_a_thread),
 (SELECT id FROM _coach_a_message),
 'a1111111-2222-4222-8222-111111111111', 'Coach response'
) AS id \gset
DO $
DECLARE v_id uuid;
BEGIN
 SELECT public.v2_coach_record_assistant_reply(
  'a1111111-1111-4111-8111-111111111111',
  (SELECT thread_id FROM _coach_a_thread),
  (SELECT id FROM _coach_a_message),
  'a1111111-2222-4222-8222-111111111111', 'Coach response'
 ) INTO v_id;
 IF v_id IS DISTINCT FROM (
  SELECT id FROM public.v2_coach_messages
  WHERE user_id = 'a1111111-1111-4111-8111-111111111111'
    AND response_id = 'a1111111-2222-4222-8222-111111111111'
 ) THEN
  RAISE EXCEPTION 'response retry generated duplicate id';
 END IF;
 BEGIN
  PERFORM public.v2_coach_record_assistant_reply(
   'b2222222-2222-4222-8222-222222222222',
   (SELECT thread_id FROM _coach_a_thread),
   (SELECT id FROM _coach_a_message),
   'b2222222-2222-4222-8222-222222222222', 'Cross owner reply');
  RAISE EXCEPTION 'cross owner service reply incorrectly accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END $$;
RESET ROLE;

-- Owner A now sees the user/assistant history. Neither role has raw table reads.
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub', 'a1111111-1111-4111-8111-111111111111', true);
DO $$
BEGIN
 IF (SELECT count(*) FROM public.v2_coach_read_messages(
    (SELECT thread_id FROM _coach_a_thread))) <> 2 THEN
   RAISE EXCEPTION 'owner A missing canonical assistant reply';
 END IF;
END $$;
RESET ROLE;

-- Database owner asserts exact durable rows + ledger then discards fixtures.
DO $$
BEGIN
 IF (SELECT count(*) FROM public.v2_coach_messages
     WHERE user_id = 'a1111111-1111-4111-8111-111111111111') <> 2 OR
    (SELECT count(*) FROM allin_private.v2_coach_message_actions
     WHERE user_id = 'a1111111-1111-4111-8111-111111111111') <> 1 OR
    (SELECT count(*) FROM public.v2_coach_threads
     WHERE user_id IN (
      'a1111111-1111-4111-8111-111111111111',
      'b2222222-2222-4222-8222-222222222222')) <> 2 THEN
   RAISE EXCEPTION 'canonical message/action/thread counts mismatch';
 END IF;
END $$;
ROLLBACK;
\echo 'PASS ALL-222 COACH two-owner functional smoke (rolled back)'
