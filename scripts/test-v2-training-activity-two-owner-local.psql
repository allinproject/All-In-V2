INSERT INTO public.v2_activity_sources
 (id,activity_id,user_id,provider,source_kind,source_record_id,quality,source_payload_hash)
VALUES
 ('a3333333-3333-4333-8333-333333333333','a1111111-1111-4111-8111-111111111111','11111111-1111-4111-8111-111111111111','manual','manual_record','test-source-a','trusted',repeat('a',64)),
 ('b4444444-4444-4444-8444-444444444444','b2222222-2222-4222-8222-222222222222','22222222-2222-4222-8222-222222222222','manual','manual_record','test-source-b','trusted',repeat('b',64));
DO $constraints$
BEGIN
 BEGIN
  INSERT INTO public.v2_activity_sources(id,activity_id,user_id,provider,source_kind,source_record_id,quality)
  VALUES('a5555555-5555-4555-8555-555555555555','a1111111-1111-4111-8111-111111111111',
   '11111111-1111-4111-8111-111111111111','manual','manual_record','test-source-a','trusted');
  RAISE EXCEPTION 'FAIL: duplicate source accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
  INSERT INTO public.v2_activity_sources(id,activity_id,user_id,provider,source_kind,source_record_id,quality)
  VALUES('a6666666-6666-4666-8666-666666666666','a1111111-1111-4111-8111-111111111111',
   '22222222-2222-4222-8222-222222222222','manual','manual_record','cross-account','trusted');
  RAISE EXCEPTION 'FAIL: cross-owner source attached';
 EXCEPTION WHEN foreign_key_violation THEN NULL; END;
 IF pg_catalog.has_table_privilege('authenticated','public.v2_completed_activities','SELECT')
  OR pg_catalog.has_table_privilege('authenticated','public.v2_training_plans','INSERT')
  OR pg_catalog.has_function_privilege('anon','public.v2_training_day_read_candidate(uuid,date)','EXECUTE')
 THEN RAISE EXCEPTION 'FAIL: unapproved client access'; END IF;
 RAISE NOTICE 'PASS: two-owner canonical source dedupe, FK and default-deny';
END $constraints$;
-- This test exercises the EXACT narrowly granted candidate release permissions.
-- It does not add temporary test-only EXECUTE grants.
DO $read_acl$
BEGIN
 IF NOT pg_catalog.has_function_privilege('authenticated','public.v2_training_day_read_candidate(uuid,date)','EXECUTE')
 OR NOT pg_catalog.has_function_privilege('authenticated','public.v2_completed_activity_detail_candidate(uuid,uuid)','EXECUTE')
 OR pg_catalog.has_function_privilege('anon','public.v2_training_day_read_candidate(uuid,date)','EXECUTE')
 OR pg_catalog.has_function_privilege('anon','public.v2_completed_activity_detail_candidate(uuid,uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'FAIL: narrow owner-reader release ACL mismatch'; END IF;
END $read_acl$;
SET ROLE anon;
DO $anonymous$
BEGIN
 BEGIN
  PERFORM public.v2_training_day_read_candidate('11111111-1111-4111-8111-111111111111','2026-11-16');
  RAISE EXCEPTION 'FAIL: anonymous Training reader allowed';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate('11111111-1111-4111-8111-111111111111','a1111111-1111-4111-8111-111111111111');
  RAISE EXCEPTION 'FAIL: anonymous Activity reader allowed';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $anonymous$;
RESET ROLE;
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.sub','11111111-1111-4111-8111-111111111111',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id','10101010-1010-4010-8010-101010101010',false);
DO $owner_a$
DECLARE t jsonb; d jsonb;
BEGIN
 t:=public.v2_training_day_read_candidate('11111111-1111-4111-8111-111111111111','2026-11-16');
 IF pg_catalog.jsonb_array_length(t->'plannedWorkouts')<>1
  OR t#>>'{plannedWorkouts,0,sport}'<>'running'
  OR t->>'ownerId'<>'11111111-1111-4111-8111-111111111111'
 THEN RAISE EXCEPTION 'FAIL: Athlete A Training read %',t; END IF;
 t:=public.v2_training_day_read_candidate('11111111-1111-4111-8111-111111111111','2026-11-17');
 IF t#>>'{calendarDays,0,dayState}'<>'rest' OR pg_catalog.jsonb_array_length(t->'plannedWorkouts')<>0
 THEN RAISE EXCEPTION 'FAIL: Athlete A rest day %',t; END IF;
 d:=public.v2_completed_activity_detail_candidate('11111111-1111-4111-8111-111111111111','a1111111-1111-4111-8111-111111111111');
 IF d->>'sport'<>'running' OR d->>'ownerId'<>'11111111-1111-4111-8111-111111111111'
 THEN RAISE EXCEPTION 'FAIL: Athlete A Completed detail %',d; END IF;
 BEGIN
  PERFORM public.v2_training_day_read_candidate('22222222-2222-4222-8222-222222222222','2026-11-16');
  RAISE EXCEPTION 'FAIL: Athlete A impersonated B Training';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate('11111111-1111-4111-8111-111111111111','b2222222-2222-4222-8222-222222222222');
  RAISE EXCEPTION 'FAIL: Athlete A read B Completed detail';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS: Athlete A correct planned/rest/completed owner reads; B blocked';
END $owner_a$;
SELECT pg_catalog.set_config('request.jwt.claim.sub','22222222-2222-4222-8222-222222222222',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id','20202020-2020-4020-8020-202020202020',false);
DO $owner_b$
DECLARE t jsonb;d jsonb;
BEGIN
 t:=public.v2_training_day_read_candidate('22222222-2222-4222-8222-222222222222','2026-11-16');
 d:=public.v2_completed_activity_detail_candidate('22222222-2222-4222-8222-222222222222','b2222222-2222-4222-8222-222222222222');
 IF t#>>'{plannedWorkouts,0,sport}'<>'cycling' OR pg_catalog.jsonb_array_length(t->'plannedWorkouts')<>1
 OR d->>'sport'<>'cycling' THEN RAISE EXCEPTION 'FAIL: Athlete B owner reads'; END IF;
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate('22222222-2222-4222-8222-222222222222','a1111111-1111-4111-8111-111111111111');
  RAISE EXCEPTION 'FAIL: Athlete B read A Completed detail';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS: Athlete B reads own workout/actual; A blocked';
END $owner_b$;
RESET ROLE;
-- Explicit session expiry precedes deletion and must deny BOTH owner readers.
UPDATE auth.sessions SET not_after=pg_catalog.clock_timestamp()-interval '1 second'
 WHERE id='10101010-1010-4010-8010-101010101010';
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.sub','11111111-1111-4111-8111-111111111111',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id','10101010-1010-4010-8010-101010101010',false);
DO $expired$
BEGIN
 BEGIN
  PERFORM public.v2_training_day_read_candidate('11111111-1111-4111-8111-111111111111','2026-11-16');
  RAISE EXCEPTION 'FAIL: expired Training session allowed';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate('11111111-1111-4111-8111-111111111111','a1111111-1111-4111-8111-111111111111');
  RAISE EXCEPTION 'FAIL: expired Activity session allowed';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $expired$;
RESET ROLE;
DELETE FROM auth.sessions WHERE id='10101010-1010-4010-8010-101010101010';
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.sub','11111111-1111-4111-8111-111111111111',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id','10101010-1010-4010-8010-101010101010',false);
DO $revocation$
BEGIN
 BEGIN
  PERFORM public.v2_training_day_read_candidate('11111111-1111-4111-8111-111111111111','2026-11-16');
  RAISE EXCEPTION 'FAIL: revoked session read Training';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate('11111111-1111-4111-8111-111111111111','a1111111-1111-4111-8111-111111111111');
  RAISE EXCEPTION 'FAIL: revoked session read Completed Activity';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS: revoked session blocked both owner readers';
END $revocation$;
RESET ROLE;
ROLLBACK;
DO $cleanup$
BEGIN
 IF EXISTS(SELECT 1 FROM auth.users WHERE id IN (
  '11111111-1111-4111-8111-111111111111','22222222-2222-4222-8222-222222222222'))
 THEN RAISE EXCEPTION 'FAIL: acceptance fixture survived rollback'; END IF;
 IF NOT pg_catalog.has_function_privilege('authenticated','public.v2_training_day_read_candidate(uuid,date)','EXECUTE')
 OR NOT pg_catalog.has_function_privilege('authenticated','public.v2_completed_activity_detail_candidate(uuid,uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'FAIL: reviewed reader grants missing after fixture rollback'; END IF;
 RAISE NOTICE 'PASS ALL-222/243/246: populated two-account acceptance and rollback cleanup';
END $cleanup$;
