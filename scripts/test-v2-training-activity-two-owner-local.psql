\set ON_ERROR_STOP on
-- ALL-222/243/246/250: actual versioned-schema, populated two-owner acceptance.
-- Disposable local Supabase ONLY; transaction rolls back every fixture and
-- temporary reader GRANT. Do not run on a linked or hosted database.
