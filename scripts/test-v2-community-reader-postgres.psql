\set ON_ERROR_STOP on
\ir test-v2-community-writer-postgres.psql
\ir ../docs/architecture/sql/V2-COMMUNITY-RELATIONSHIP-READER-CANDIDATE.sql

DO $validate_reader$
DECLARE
  r jsonb;
BEGIN
  IF has_function_privilege('authenticated','public.v2_community_relationship_read(uuid)','EXECUTE')
     OR has_function_privilege('anon','public.v2_community_relationship_read(uuid)','EXECUTE') THEN
    RAISE EXCEPTION 'Unapproved Community reader exposed to API roles';
  END IF;
  r := public.v2_community_relationship_read('00000000-0000-0000-0000-000000000002');
  IF r->>'viewerId' <> '00000000-0000-0000-0000-000000000001'
     OR r->>'targetOwnerId' <> '00000000-0000-0000-0000-000000000002'
     OR r->>'version' <> '5'
     OR r->>'targetVisibility' <> 'private'
     OR r->>'relationship' <> 'not_following'
     OR r->>'viewerBlockedTarget' <> 'false'
     OR r->>'incomingRequestFromTarget' <> 'false'
     OR r ? 'displayName' OR r ? 'sharedArea' OR r ? 'posts' OR r ? 'events' THEN
    RAISE EXCEPTION 'Invalid current server evidence: %',r;
  END IF;
  BEGIN
    PERFORM public.v2_community_relationship_read('00000000-0000-0000-0000-000000000001');
    RAISE EXCEPTION 'Self target accepted';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
END
$validate_reader$;

INSERT INTO allin_private.v2_community_blocks(blocker_id,blocked_id)
VALUES('00000000-0000-0000-0000-000000000002',
       '00000000-0000-0000-0000-000000000001');

DO $blocked$
DECLARE r jsonb;
BEGIN
  r := public.v2_community_relationship_read('00000000-0000-0000-0000-000000000002');
  IF r->>'relationship' <> 'blocked_either_way'
     OR r->>'viewerBlockedTarget' <> 'false'
     OR r->>'targetVisibility' <> 'private'
     OR r->>'incomingRequestFromTarget' <> 'false' THEN
    RAISE EXCEPTION 'Reverse-block evidence leaked: %',r;
  END IF;
END
$blocked$;

DELETE FROM allin_private.v2_community_blocks
WHERE blocker_id='00000000-0000-0000-0000-000000000002'
  AND blocked_id='00000000-0000-0000-0000-000000000001';
UPDATE allin_private.v2_community_visibility SET profile_visibility='public'
WHERE user_id='00000000-0000-0000-0000-000000000002';

DO $public$
DECLARE r jsonb;
BEGIN
  r := public.v2_community_relationship_read('00000000-0000-0000-0000-000000000002');
  IF r->>'targetVisibility'<>'public' OR r->>'relationship'<>'not_following' THEN
    RAISE EXCEPTION 'Public visibility snapshot incorrect: %',r;
  END IF;
END
$public$;

SELECT set_config('request.jwt.claim.sub','',false);
DO $anonymous$
BEGIN
  BEGIN
    PERFORM public.v2_community_relationship_read('00000000-0000-0000-0000-000000000002');
    RAISE EXCEPTION 'Anonymous read accepted';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
END
$anonymous$;
\echo PASS: Community reader current identity, blocked sanitization, visibility and no API grant.
