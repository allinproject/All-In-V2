\set ON_ERROR_STOP on
-- ALL-243 isolated PG17 scalar evidence projection; no live schema mutation.
DO $roles$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN; END IF;
END $roles$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETED-IDENTITY-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SCALAR-METRICS-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SCALAR-READ-CANDIDATE.sql
DO $qa$
DECLARE
 a uuid:='11111111-1111-4111-8111-111111111111';
 b uuid:='22222222-2222-4222-8222-222222222222';
 ride uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 other uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 src_a uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 src_b uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 src_c uuid:='eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee';
 src_d uuid:='ffffffff-ffff-4fff-8fff-ffffffffffff';
 v jsonb;
BEGIN
 INSERT INTO auth.users VALUES(a),(b);
 INSERT INTO public.v2_completed_activities
 (id,user_id,sport,activity_kind,athlete_local_date,timezone,capture_kind,status)
 VALUES(ride,a,'cycling','workout','2026-11-11','America/Chicago','mixed_sources','needs_review'),
       (other,b,'cycling','workout','2026-11-11','America/Chicago','device_measured','needs_review');
 INSERT INTO public.v2_activity_sources
 (id,activity_id,user_id,provider,source_kind,source_record_id,quality,source_payload_hash)
 VALUES(src_a,ride,a,'supported_equipment','device_session','trainer-a','trusted',repeat('a',64)),
       (src_b,ride,a,'apple_watch','sensor_summary','watch-b','partial',repeat('b',64)),
       (src_c,ride,a,'import','sensor_summary','source-c','unverified',repeat('c',64));
 INSERT INTO public.v2_activity_metric_definitions
 (metric_code,definition_version,display_name,canonical_unit,value_kind,
  sport_scope,measurement_kinds,display_group,privacy_class,status)
 VALUES
 ('avg_power_w',1,'Average watts','W','numeric',ARRAY['cycling'],ARRAY['source_measured'],
   'power','private','published'),
 ('cadence_rpm',1,'Cadence','rpm','numeric',ARRAY['cycling'],ARRAY['source_measured'],
   'cadence','private','published'),
 ('hr_bpm',1,'Heart rate','bpm','numeric',ARRAY['cycling'],ARRAY['source_measured'],
   'heart_rate','sensitive','published');
 INSERT INTO public.v2_activity_metric_values
 (id,activity_id,user_id,source_id,metric_code,definition_version,
 value_numeric,measurement_kind,quality,source_payload_hash)
 VALUES
 ('00000000-0000-4000-8000-000000000001',ride,a,src_a,
  'avg_power_w',1,200,'source_measured','trusted',repeat('a',64)),
 ('00000000-0000-4000-8000-000000000002',ride,a,src_b,
  'avg_power_w',1,200,'source_measured','partial',repeat('b',64)),
 ('00000000-0000-4000-8000-000000000003',ride,a,src_a,
  'cadence_rpm',1,0,'source_measured','trusted',repeat('a',64)),
 ('00000000-0000-4000-8000-000000000004',ride,a,src_c,
  'hr_bpm',1,160,'source_measured','unverified',repeat('c',64));
 v:=allin_private.v2_activity_scalar_evidence_projection_candidate(a,ride);
 IF jsonb_array_length(v->'metrics')<>2
 OR jsonb_array_length(v->'unresolvedMetrics')<>1
 OR (v->'metrics'->0->>'metricCode')<>'avg_power_w'
 OR (v->'metrics'->0->>'quality')<>'partial'
 OR (v->'metrics'->0->>'sourceCount')<>'2'
 OR (v->'metrics'->1->>'valueNumeric')<>'0'
 OR (v->'unresolvedMetrics'->0->>'reason')<>'source_review_required'
 THEN RAISE EXCEPTION 'Agreed evidence and known-zero projection wrong: %',v; END IF;
 INSERT INTO public.v2_activity_sources
 (id,activity_id,user_id,provider,source_kind,source_record_id,quality,source_payload_hash)
 VALUES(src_d,ride,a,'import','workout_record','conflicting-d','trusted',repeat('d',64));
 INSERT INTO public.v2_activity_metric_values
 (id,activity_id,user_id,source_id,metric_code,definition_version,
 value_numeric,measurement_kind,quality,source_payload_hash)
 VALUES
 ('00000000-0000-4000-8000-000000000005',ride,a,src_d,
  'avg_power_w',1,250,'source_measured','trusted',repeat('d',64));
 v:=allin_private.v2_activity_scalar_evidence_projection_candidate(a,ride);
 IF jsonb_array_length(v->'metrics')<>1
 OR jsonb_array_length(v->'unresolvedMetrics')<>2
 OR (SELECT count(*) FROM jsonb_array_elements(v->'unresolvedMetrics') as x(item)
     WHERE item->>'metricCode'='avg_power_w'
       AND item->>'reason'='conflicting_sources')<>1
 THEN RAISE EXCEPTION 'Conflicting watts were displayed rather than quarantined: %',v; END IF;
 BEGIN
  PERFORM allin_private.v2_activity_scalar_evidence_projection_candidate(b,ride);
  RAISE EXCEPTION 'Cross-owner metric projection succeeded';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 v:=allin_private.v2_activity_scalar_evidence_projection_candidate(b,other);
 IF jsonb_array_length(v->'metrics')<>0 OR jsonb_array_length(v->'unresolvedMetrics')<>0
 THEN RAISE EXCEPTION 'Empty activity fabricated measurements'; END IF;
 IF has_function_privilege('authenticated',
 'allin_private.v2_activity_scalar_evidence_projection_candidate(uuid,uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'Untrusted client can read private scalar evidence'; END IF;
 RAISE NOTICE 'PASS ALL-243 scalar projection: source agreement, conflict exclusion, zero and owner privacy';
END $qa$;
