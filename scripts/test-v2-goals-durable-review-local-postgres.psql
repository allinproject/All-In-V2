\set ON_ERROR_STOP on
-- ALL-239 disposable local foundation: no hosted reads/writes or service grants.
BEGIN;
DO $review$
DECLARE
 a uuid:='11111111-1111-4111-8111-111111111111';
 b uuid:='22222222-2222-4222-8222-222222222222';
 sa uuid:='33333333-3333-4333-8333-333333333333';
 sb uuid:='44444444-4444-4444-8444-444444444444';
 ga uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 gb uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 ra uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 rb uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 aa uuid:='eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee';
 ab uuid:='ffffffff-ffff-4fff-8fff-ffffffffffff';
 review_a uuid:='55555555-5555-4555-8555-555555555555';
 review_b uuid:='66666666-6666-4666-8666-666666666666';
 fp text:=repeat('a',64);
 receipt jsonb;
BEGIN
 INSERT INTO auth.users(id) VALUES(a),(b);
 INSERT INTO auth.sessions(id,user_id) VALUES(sa,a),(sb,b);
 INSERT INTO public.v2_goals(id,user_id,goal_kind,title,status)
  VALUES(ga,a,'general_wellbeing','Improve consistency','active'),
        (gb,b,'endurance_distance','Train more','active');
 INSERT INTO public.v2_goal_revisions(id,goal_id,user_id,revision_number,status,source_kind)
  VALUES(ra,ga,a,1,'candidate','athlete_authored'),
        (rb,gb,b,1,'candidate','athlete_authored');
 INSERT INTO allin_private.v2_goal_approval_reviews(
   id,user_id,session_id,goal_id,goal_revision_id,action_id,
   expected_version,payload_sha256,athlete_confirmed,approved_at,expires_at
 ) VALUES(review_a,a,sa,ga,ra,aa,1,fp,true,now(),now()+interval '10 minutes'),
         (review_b,b,sb,gb,rb,ab,1,repeat('b',64),true,
          now()-interval '30 minutes',now()-interval '20 minutes');
 IF NOT (SELECT relrowsecurity FROM pg_catalog.pg_class
   WHERE oid='allin_private.v2_goal_approval_reviews'::regclass)
 THEN RAISE EXCEPTION 'Private review ledger is not RLS guarded'; END IF;
 BEGIN
  PERFORM allin_private.v2_goal_commit_reviewed_candidate(
    b,sa,ga,ra,aa,review_a,1,fp);
  RAISE EXCEPTION 'Foreign account used another owner review';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_goal_commit_reviewed_candidate(
    a,sa,ga,ra,aa,review_a,1,repeat('c',64));
  RAISE EXCEPTION 'Unreviewed fingerprint accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_goal_commit_reviewed_candidate(
    b,sb,gb,rb,ab,review_b,1,repeat('b',64));
  RAISE EXCEPTION 'Expired review approved a goal';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  UPDATE allin_private.v2_goal_approval_reviews
   SET payload_sha256=repeat('c',64) WHERE user_id=a AND id=review_a;
  RAISE EXCEPTION 'Reviewed digest was silently rewritten';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  DELETE FROM allin_private.v2_goal_approval_reviews
    WHERE user_id=a AND id=review_a;
  RAISE EXCEPTION 'Live review was deleted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 receipt:=allin_private.v2_goal_commit_reviewed_candidate(
   a,sa,ga,ra,aa,review_a,1,fp);
 IF receipt->>'version'<>'2' OR receipt->>'replayed'<>'false'
 THEN RAISE EXCEPTION 'First durable review commit failed: %',receipt; END IF;
 receipt:=allin_private.v2_goal_commit_reviewed_candidate(
   a,sa,ga,ra,aa,review_a,1,fp);
 IF receipt->>'version'<>'2' OR receipt->>'replayed'<>'true'
 THEN RAISE EXCEPTION 'Exact reviewed action did not replay: %',receipt; END IF;
 IF (SELECT count(*) FROM allin_private.v2_goal_acceptance_actions
   WHERE user_id=a AND session_id=sa AND goal_id=ga)<>1
   OR (SELECT count(*) FROM allin_private.v2_goal_approval_reviews
   WHERE id=review_a AND user_id=a AND completed_at IS NOT NULL)<>1
 THEN RAISE EXCEPTION 'Atomic review/acceptance receipts not consistent'; END IF;
 DELETE FROM auth.sessions WHERE id=sa;
 BEGIN
  PERFORM allin_private.v2_goal_commit_reviewed_candidate(
    a,sa,ga,ra,aa,review_a,1,fp);
  RAISE EXCEPTION 'Revoked session replayed durable review';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 IF (SELECT count(*) FROM allin_private.v2_goal_approval_reviews
   WHERE user_id=a AND id=review_a)<>1
 THEN RAISE EXCEPTION 'Session revocation lost Goal approval evidence'; END IF;
 DELETE FROM auth.users WHERE id=a;
 IF EXISTS(SELECT 1 FROM allin_private.v2_goal_approval_reviews WHERE user_id=a)
 THEN RAISE EXCEPTION 'Account deletion retained Goal approval evidence'; END IF;
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_goal_approval_reviews
   WHERE user_id=b AND id=review_b)
 THEN RAISE EXCEPTION 'Foreign Goal approval was deleted'; END IF;
 IF pg_catalog.to_regprocedure(
   'public.v2_goal_commit_reviewed_candidate(uuid,uuid,uuid,uuid,uuid,uuid,bigint,text)'
   ) IS NOT NULL
   OR pg_catalog.has_function_privilege('authenticated',
      'allin_private.v2_goal_commit_reviewed_candidate(uuid,uuid,uuid,uuid,uuid,uuid,bigint,text)',
      'EXECUTE')
   OR pg_catalog.has_function_privilege('service_role',
      'allin_private.v2_goal_commit_reviewed_candidate(uuid,uuid,uuid,uuid,uuid,uuid,bigint,text)',
      'EXECUTE')
 THEN RAISE EXCEPTION 'Unapproved reviewed Goal gateway accessible'; END IF;
 RAISE NOTICE 'PASS ALL-239 durable Goal review: exact session, consent, replay, expiry, owner isolation and cascade';
END $review$;
ROLLBACK;
