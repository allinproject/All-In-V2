-- Diagnostic only: do not bypass this export guard. Log qualified missing
-- table names so the canonical ALL-251 owner can add actual per-domain payloads.
DO $export_coverage$
DECLARE v_missing text;
BEGIN
 SELECT pg_catalog.string_agg(n.nspname||'.'||c.relname,', ' ORDER BY n.nspname,c.relname)
 INTO v_missing
 FROM pg_catalog.pg_class c
 JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
 JOIN pg_catalog.pg_attribute a ON a.attrelid=c.oid
   AND a.attname='user_id' AND a.attnum>0 AND NOT a.attisdropped
 WHERE n.nspname IN ('public','allin_private') AND c.relkind IN ('r','p')
   AND pg_catalog.strpos(
     pg_catalog.pg_get_functiondef('public.v2_export_my_account_snapshot(uuid)'::regprocedure),
     pg_catalog.quote_literal(c.relname)
   )=0;
 RAISE NOTICE 'Uncovered owner tables in canonical export (fail closed): %',
   coalesce(v_missing,'none');
END $export_coverage$;

SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub','61111111-6111-4111-8111-611111111111',true);
DO $coach_export$
DECLARE
 v_data jsonb;
 v_part jsonb;
BEGIN
 v_data := public.v2_export_my_account_snapshot('61111111-6111-4111-8111-611111111111');
 IF v_data->'goals'->'goals'->0->>'title' <> 'Owner A private goal'
    OR jsonb_array_length(v_data->'goals'->'revisions') <> 1
    OR jsonb_array_length(v_data->'goals'->'behavior_targets') <> 1
    OR jsonb_array_length(v_data->'goals'->'acceptance_actions') <> 1
    OR jsonb_array_length(v_data->'goals'->'approval_reviews') <> 1
    OR jsonb_array_length(v_data->'eventhub'->'group_memberships') <> 1
    OR jsonb_array_length(v_data->'eventhub'->'participations') <> 1
    OR jsonb_array_length(v_data->'eventhub'->'group_actions') <> 1
    OR v_data->'community'->'visibility'->>'profile_visibility' <> 'private'
    OR jsonb_array_length(v_data->'community'->'outgoing_follows')<>1
    OR jsonb_array_length(v_data->'community'->'incoming_follow_requests')<>0
    OR jsonb_array_length(v_data->'community'->'outgoing_blocks')<>1
    OR jsonb_array_length(v_data->'community'->'my_action_receipts')<>1
    OR v_data->'community'->>'complete_community_export'<>'false'
    OR v_data->'community'->>'incoming_blocks_disclosed'<>'false'
    OR v_data->'community' ? 'pair_revisions'
    OR v_data->'community' ? 'incoming_blocks'
    OR v_data::text LIKE '%Owner B private goal%'
    OR v_data::text LIKE '%Owner B private event note%'
    OR v_data::text LIKE '%Owner B cycling cadence%'
 THEN RAISE EXCEPTION 'Owner A cross-domain export missing records or leaked B'; END IF;
 v_part := v_data->'coach_conversation';
 IF v_part IS NULL OR v_part->>'schema_version' <> 'v2-coach-account-fragment-candidate-v2'
    OR jsonb_array_length(v_part->'threads')<>1
    OR jsonb_array_length(v_part->'messages')<>2
    OR v_part ? 'message_actions'
    OR v_part::text LIKE '%request_fingerprint%'
    OR v_part::text NOT LIKE '%Athlete A private question%'
    OR v_part::text NOT LIKE '%Athlete A private Coach answer%'
    OR v_part::text LIKE '%Athlete B private question%'
 THEN RAISE EXCEPTION 'Owner A Coach export incomplete or leaked owner B'; END IF;
 BEGIN
   PERFORM public.v2_export_my_account_snapshot('62222222-6222-4222-8222-622222222222');
   RAISE EXCEPTION 'Owner A exported B data';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END $coach_export$;
SELECT set_config('request.jwt.claim.sub','62222222-6222-4222-8222-622222222222',true);
DO $coach_export$
DECLARE v_part jsonb;
DECLARE v_data jsonb;
BEGIN
 v_data := public.v2_export_my_account_snapshot('62222222-6222-4222-8222-622222222222');
 v_part := v_data->'coach_conversation';
 IF v_data->'goals'->'goals'->0->>'title' <> 'Owner B private goal'
    OR jsonb_array_length(v_data->'goals'->'revisions') <> 1
    OR jsonb_array_length(v_data->'goals'->'behavior_targets') <> 1
    OR jsonb_array_length(v_data->'goals'->'acceptance_actions') <> 1
    OR jsonb_array_length(v_data->'goals'->'approval_reviews') <> 1
    OR jsonb_array_length(v_data->'eventhub'->'group_memberships') <> 1
    OR jsonb_array_length(v_data->'eventhub'->'participations') <> 1
    OR jsonb_array_length(v_data->'eventhub'->'group_actions') <> 1
    OR v_data->'community'->'visibility'->>'profile_visibility' <> 'public'
    OR jsonb_array_length(v_data->'community'->'outgoing_follows')<>1
    OR jsonb_array_length(v_data->'community'->'incoming_follow_requests')<>0
    OR jsonb_array_length(v_data->'community'->'outgoing_blocks')<>0
    OR jsonb_array_length(v_data->'community'->'my_action_receipts')<>1
    OR v_data->'community'->>'incoming_blocks_disclosed'<>'false'
    OR v_data->'community' ? 'pair_revisions'
    OR v_data->'community' ? 'incoming_blocks'
    OR v_data::text LIKE '%Owner A private goal%'
    OR v_data::text LIKE '%Owner A private event note%'
    OR v_data::text LIKE '%Owner A running cadence%'
 THEN RAISE EXCEPTION 'Owner B cross-domain export missing records or leaked A'; END IF;
 IF v_part IS NULL THEN RAISE EXCEPTION 'Owner B missing Coach export'; END IF;
 IF jsonb_array_length(v_part->'messages')<>2
    OR v_part ? 'message_actions'
    OR v_part::text LIKE '%request_fingerprint%'
    OR v_part::text NOT LIKE '%Athlete B private question%'
    OR v_part::text NOT LIKE '%Athlete B private Coach answer%'
    OR v_part::text LIKE '%Athlete A private question%'
 THEN RAISE EXCEPTION 'Owner B Coach export incomplete or leaked owner A'; END IF;
END $coach_export$;
RESET ROLE;

-- New directional tables without user_id must block the canonical
-- export until that relationship data receives an explicit privacy policy.
CREATE TABLE allin_private.v2_community_unreviewed_pair_probe (
 lower_user_id uuid, upper_user_id uuid
);
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub','61111111-6111-4111-8111-611111111111',true);
DO $directional_guard$
BEGIN
 BEGIN
  PERFORM public.v2_export_my_account_snapshot('61111111-6111-4111-8111-611111111111');
  RAISE EXCEPTION 'Unreviewed directional Community table bypassed export coverage';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END $directional_guard$;
RESET ROLE;
DROP TABLE allin_private.v2_community_unreviewed_pair_probe;

-- A large accumulated Coach history must NEVER be silently truncated by
-- the inline JSON snapshot. Keep the existing 5 MB fail-closed boundary until
-- the separately approved streaming, encrypted downloadable export is ready.
WITH request_ids AS (
  SELECT gen_random_uuid() AS request_id FROM generate_series(1,160)
)
INSERT INTO public.v2_coach_messages
 (id,user_id,thread_id,client_request_id,role,content)
SELECT gen_random_uuid(),'61111111-6111-4111-8111-611111111111'::uuid,
       'a1111111-6111-4111-8111-611111111111'::uuid,request_id,
       'user',repeat('U',12000)
FROM request_ids
UNION ALL
SELECT gen_random_uuid(),'61111111-6111-4111-8111-611111111111'::uuid,
       'a1111111-6111-4111-8111-611111111111'::uuid,request_id,
       'assistant',repeat('A',20000)
FROM request_ids;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub','61111111-6111-4111-8111-611111111111',true);
DO $large_export$
BEGIN
 BEGIN
  PERFORM public.v2_export_my_account_snapshot('61111111-6111-4111-8111-611111111111');
  RAISE EXCEPTION 'Oversized Coach export was incorrectly returned inline';
 EXCEPTION WHEN SQLSTATE '54000' THEN NULL;
 END;
 RAISE NOTICE 'PASS: large owner history must use a secure non-inline export';
END $large_export$;
RESET ROLE;
DELETE FROM public.v2_coach_messages
 WHERE user_id='61111111-6111-4111-8111-611111111111'
   AND content IN (repeat('U',12000),repeat('A',20000));

-- Owner A deletion must remove ALL Coach rows and leave B intact.
DELETE FROM auth.users WHERE id='61111111-6111-4111-8111-611111111111';
DO $coach_delete$
BEGIN
 IF EXISTS(SELECT 1 FROM public.v2_coach_threads WHERE user_id='61111111-6111-4111-8111-611111111111')
 OR EXISTS(SELECT 1 FROM public.v2_coach_messages WHERE user_id='61111111-6111-4111-8111-611111111111')
 OR EXISTS(SELECT 1 FROM allin_private.v2_coach_turn_claims WHERE user_id='61111111-6111-4111-8111-611111111111')
 OR NOT EXISTS(SELECT 1 FROM public.v2_coach_threads WHERE user_id='62222222-6222-4222-8222-622222222222')
 THEN RAISE EXCEPTION 'Coach deletion cascade failed or damaged other owner'; END IF;
 RAISE NOTICE 'PASS ALL-217/251: export includes only own Coach transcript; private claims cascade-delete';
END $coach_delete$;

DO $all_domains_delete$
DECLARE
  v_rel text;
  v_a_count bigint;
  v_b_count bigint;
BEGIN
  FOREACH v_rel IN ARRAY ARRAY[
    'public.v2_goals',
    'public.v2_goal_revisions',
    'public.v2_goal_revision_behavior_targets',
    'allin_private.v2_goal_acceptance_actions',
    'allin_private.v2_goal_approval_reviews',
    'public.v2_event_group_memberships',
    'public.v2_event_participations',
    'allin_private.v2_event_group_actions',
    'allin_private.v2_community_visibility'
  ] LOOP
    EXECUTE pg_catalog.format('SELECT count(*) FROM %I.%I WHERE user_id=$1',
      pg_catalog.split_part(v_rel,'.',1),pg_catalog.split_part(v_rel,'.',2))
      INTO v_a_count USING '61111111-6111-4111-8111-611111111111'::uuid;
    EXECUTE pg_catalog.format('SELECT count(*) FROM %I.%I WHERE user_id=$1',
      pg_catalog.split_part(v_rel,'.',1),pg_catalog.split_part(v_rel,'.',2))
      INTO v_b_count USING '62222222-6222-4222-8222-622222222222'::uuid;
    IF v_a_count<>0 OR v_b_count<>1 THEN
      RAISE EXCEPTION 'Deleted A or surviving B violated owner cascade in %: A=% B=%',
        v_rel,v_a_count,v_b_count;
    END IF;
  END LOOP;
  RAISE NOTICE 'PASS ALL-251: nine owner relations after deletion preserve only B records';
END $all_domains_delete$;
-- Directed relationships have NO user_id column. Existing owner-table
-- deletion probes cannot detect orphaned follows, blocks, pair CAS or receipts.
DO $community_delete$
BEGIN
 IF EXISTS(
   SELECT 1 FROM allin_private.v2_community_pair_revisions
   WHERE lower_user_id='61111111-6111-4111-8111-611111111111'
      OR upper_user_id='61111111-6111-4111-8111-611111111111')
 OR EXISTS(
   SELECT 1 FROM allin_private.v2_community_follows
   WHERE follower_id='61111111-6111-4111-8111-611111111111'
      OR followed_id='61111111-6111-4111-8111-611111111111')
 OR EXISTS(
   SELECT 1 FROM allin_private.v2_community_blocks
   WHERE blocker_id='61111111-6111-4111-8111-611111111111'
      OR blocked_id='61111111-6111-4111-8111-611111111111')
 OR EXISTS(
   SELECT 1 FROM allin_private.v2_community_action_receipts
   WHERE actor_id='61111111-6111-4111-8111-611111111111'
      OR target_id='61111111-6111-4111-8111-611111111111')
 OR NOT EXISTS(
   SELECT 1 FROM public.v2_profiles
   WHERE user_id='62222222-6222-4222-8222-622222222222')
 THEN RAISE EXCEPTION 'Community directional relation cascade or surviving profile invalid'; END IF;
 RAISE NOTICE 'PASS ALL-244/251: directional Community rows cascade without orphaning';
END $community_delete$;
ROLLBACK;
