\set ON_ERROR_STOP on
-- ALL-251 isolated PostgreSQL only. The Community owner export projection
-- is NOT registered or approved in the real inventory. This whole script
-- runs under one transaction and rolls every synthetic identity, source row,
-- test-only inventory override and permission change back.
BEGIN ISOLATION LEVEL REPEATABLE READ;
INSERT INTO auth.users(id) VALUES
 ('a5111111-1111-4111-8111-111111111111'),
 ('b5222222-2222-4222-8222-222222222222');
INSERT INTO auth.sessions(id,user_id) VALUES
 ('a5333333-3333-4333-8333-333333333333','a5111111-1111-4111-8111-111111111111'),
 ('b5444444-4444-4444-8444-444444444444','b5222222-2222-4222-8222-222222222222');
INSERT INTO public.v2_profiles(user_id) VALUES
 ('a5111111-1111-4111-8111-111111111111'),
 ('b5222222-2222-4222-8222-222222222222');
INSERT INTO allin_private.v2_account_export_requests_candidate
 (request_id,user_id,session_id,status,expires_at) VALUES
 ('a5555555-5555-4555-8555-555555555555','a5111111-1111-4111-8111-111111111111',
  'a5333333-3333-4333-8333-333333333333','approved',now()+interval '1 hour'),
 ('b5666666-6666-4666-8666-666666666666','b5222222-2222-4222-8222-222222222222',
  'b5444444-4444-4444-8444-444444444444','approved',now()+interval '1 hour');
-- Use actual approved source candidate DDL, not another post definition.
\ir V2-COMMUNITY-CANONICAL-POSTS-OWNER-CANDIDATE.sql
INSERT INTO allin_private.v2_community_posts
 (id,owner_id,kind,audience,title,body,source_id,published_at)
SELECT ('a5777777-7777-4777-8777-'||lpad(i::text,12,'0'))::uuid,
 'a5111111-1111-4111-8111-111111111111'::uuid,
 'update',CASE WHEN i%3=0 THEN 'private' WHEN i%3=1 THEN 'public' ELSE 'followers' END,
 'Owner A post '||i,'OWNER_A_ONLY_'||i,NULL,
 '2026-11-12 12:00:00+00'::timestamptz + i * interval '1 minute'
FROM generate_series(1,31) i;
INSERT INTO allin_private.v2_community_posts
 (id,owner_id,kind,audience,title,body,published_at)
VALUES
 ('b5888888-8888-4888-8888-888888888888',
  'b5222222-2222-4222-8222-222222222222',
  'update','private','Owner B private post','OWNER_B_SECRET','2026-11-12 12:00:00+00');

-- The REAL inventory must refuse the unreviewed post ledger, even though
-- the SQL projection exists. A positive test cannot bypass this gate.
SET LOCAL ROLE service_role;
DO $not_approved$
BEGIN
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   'a5111111-1111-4111-8111-111111111111',
   'a5333333-3333-4333-8333-333333333333',
   'a5555555-5555-4555-8555-555555555555',
   'community.my_posts',NULL,25);
  RAISE EXCEPTION 'Real unapproved Community export unexpectedly authorized';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END $not_approved$;
RESET ROLE;

-- TEST-ONLY inventory stand-in proves the actual page projection itself.
-- The live function still authorizes a valid owner/session/request using the
-- canonical server-side gate, but the only listed source is Community posts.
-- The outer ROLLBACK restores the ORIGINAL inventory function and grants.
CREATE OR REPLACE FUNCTION public.v2_account_export_inventory_review_candidate(
 p_owner uuid,p_session uuid,p_request uuid
) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=''
AS $test_only_inventory$
BEGIN
 PERFORM allin_private.v2_account_export_authorize_request_candidate(
  p_owner,p_session,p_request);
 IF pg_catalog.current_setting('transaction_isolation') <> 'repeatable read'
 THEN RAISE EXCEPTION 'Snapshot required' USING ERRCODE='42501'; END IF;
 RETURN pg_catalog.jsonb_build_object(
  'ownerId',p_owner,'requestId',p_request,'snapshotId',p_request,
  'collections',pg_catalog.jsonb_build_array('community.my_posts'),
  'complete',false);
END $test_only_inventory$;

SET LOCAL ROLE service_role;
DO $two_owner$
DECLARE
 owner_a uuid:='a5111111-1111-4111-8111-111111111111';
 owner_b uuid:='b5222222-2222-4222-8222-222222222222';
 session_a uuid:='a5333333-3333-4333-8333-333333333333';
 session_b uuid:='b5444444-4444-4444-8444-444444444444';
 request_a uuid:='a5555555-5555-4555-8555-555555555555';
 request_b uuid:='b5666666-6666-4666-8666-666666666666';
 first_page jsonb; second_page jsonb; b_page jsonb;
 combined jsonb; row jsonb;
BEGIN
 first_page:=public.v2_account_export_page_review_candidate(
  owner_a,session_a,request_a,'community.my_posts',NULL,25);
 second_page:=public.v2_account_export_page_review_candidate(
  owner_a,session_a,request_a,'community.my_posts',
  first_page->>'nextCursor',25);
 b_page:=public.v2_account_export_page_review_candidate(
  owner_b,session_b,request_b,'community.my_posts',NULL,25);
 IF pg_catalog.jsonb_array_length(first_page->'rows')<>25
  OR first_page->>'done'<>'false' OR first_page->>'nextCursor'<>'25'
  OR pg_catalog.jsonb_array_length(second_page->'rows')<>6
  OR second_page->>'done'<>'true' OR second_page->>'nextCursor' IS NOT NULL
  OR first_page->>'completeUserExport'<>'false'
  OR pg_catalog.jsonb_array_length(b_page->'rows')<>1
 THEN RAISE EXCEPTION 'Community owner pagination incomplete or falsely released'; END IF;
 combined:=(first_page->'rows')||(second_page->'rows');
 IF (SELECT count(*) FROM pg_catalog.jsonb_array_elements(combined))<>31
  OR (SELECT count(DISTINCT item->>'id')
      FROM pg_catalog.jsonb_array_elements(combined) AS item)<>31
 THEN RAISE EXCEPTION 'Community pagination duplicated or omitted owner posts'; END IF;
 FOR row IN SELECT item FROM pg_catalog.jsonb_array_elements(combined) AS item LOOP
  IF row->>'owner_id'<>owner_a::text
    OR row->>'body' NOT LIKE 'OWNER_A_ONLY_%'
    OR row->>'post_version'<>'1'
    OR row ? 'payload_sha256' OR row ? 'follower_id'
  THEN RAISE EXCEPTION 'Community export leaked foreign or internal content'; END IF;
 END LOOP;
 IF NOT EXISTS (SELECT 1 FROM pg_catalog.jsonb_array_elements(combined) AS item
   WHERE item->>'audience'='private')
  OR b_page::text NOT LIKE '%OWNER_B_SECRET%'
  OR combined::text LIKE '%OWNER_B_SECRET%'
 THEN RAISE EXCEPTION 'Owner-private post missing or other owner leaked'; END IF;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   owner_a,session_b,request_a,'community.my_posts',NULL,25);
  RAISE EXCEPTION 'Foreign Auth session accessed owner A posts';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   owner_b,session_a,request_b,'community.my_posts',NULL,25);
  RAISE EXCEPTION 'Foreign owner/session combination accessed owner B posts';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-251 two-owner gated Community post projection: 31 A over 2 pages, private body, B isolation, real Auth request gate, no completed export';
END $two_owner$;
RESET ROLE;
ROLLBACK;
