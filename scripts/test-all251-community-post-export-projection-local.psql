\set ON_ERROR_STOP on
-- ALL-251 isolated PostgreSQL only. The Community owner export projection
-- is NOT registered or approved in the real inventory. This whole script
-- runs under one transaction and rolls every synthetic identity, source row,
-- test-only inventory override and permission change back.
BEGIN ISOLATION LEVEL REPEATABLE READ;
INSERT INTO auth.users(id) VALUES
 ('a5111111-1111-4111-8111-111111111111'),
 ('b5222222-2222-4222-8222-222222222222');
INSERT INTO auth.sessions(id,user_id) VALUES
 ('a5333333-3333-4333-8333-333333333333','a5111111-1111-4111-8111-111111111111'),
 ('b5444444-4444-4444-8444-444444444444','b5222222-2222-4222-8222-222222222222');
-- The existing Auth bootstrap may create these profiles automatically.
-- Do not duplicate or replace newer canonical profile state.
INSERT INTO public.v2_profiles(user_id) VALUES
 ('a5111111-1111-4111-8111-111111111111'),
 ('b5222222-2222-4222-8222-222222222222')
ON CONFLICT DO NOTHING;
INSERT INTO allin_private.v2_account_export_requests_candidate
 (request_id,user_id,session_id,status,expires_at) VALUES
 ('a5555555-5555-4555-8555-555555555555','a5111111-1111-4111-8111-111111111111',
  'a5333333-3333-4333-8333-333333333333','approved',now()+interval '1 hour'),
 ('b5666666-6666-4666-8666-666666666666','b5222222-2222-4222-8222-222222222222',
  'b5444444-4444-4444-8444-444444444444','approved',now()+interval '1 hour');
-- Use actual approved source candidate DDL, not another post definition.
\ir V2-COMMUNITY-CANONICAL-POSTS-OWNER-CANDIDATE.sql
INSERT INTO allin_private.v2_community_posts
 (id,owner_id,kind,audience,title,body,source_id,published_at)
SELECT ('a5777777-7777-4777-8777-'||lpad(i::text,12,'0'))::uuid,
 'a5111111-1111-4111-8111-111111111111'::uuid,
 'update',CASE WHEN i%3=0 THEN 'private' WHEN i%3=1 THEN 'public' ELSE 'followers' END,
 'Owner A post '||i,'OWNER_A_ONLY_'||i,NULL,
 '2026-11-12 12:00:00+00'::timestamptz + i * interval '1 minute'
FROM generate_series(1,31) i;
INSERT INTO allin_private.v2_community_posts
 (id,owner_id,kind,audience,title,body,published_at)
VALUES
 ('b5888888-8888-4888-8888-888888888888',
  'b5222222-2222-4222-8222-222222222222',
  'update','private','Owner B private post','OWNER_B_SECRET','2026-11-12 12:00:00+00');

-- Two authors on one canonical post: owning the post must NOT give A
-- ownership of B's authored comment in the portable archive.
INSERT INTO allin_private.v2_community_comments
 (id,post_id,author_id,body) VALUES
 ('a5000000-0000-4000-8000-000000000001',
  'a5777777-7777-4777-8777-000000000001',
  'a5111111-1111-4111-8111-111111111111','OWNER_A_COMMENT');
INSERT INTO allin_private.v2_community_comments
 (id,post_id,author_id,parent_comment_id,body) VALUES
 ('b5000000-0000-4000-8000-000000000002',
  'a5777777-7777-4777-8777-000000000001',
  'b5222222-2222-4222-8222-222222222222',
  'a5000000-0000-4000-8000-000000000001','OWNER_B_COMMENT_SECRET'),
 ('a5000000-0000-4000-8000-000000000003',
  'a5777777-7777-4777-8777-000000000001',
  'a5111111-1111-4111-8111-111111111111',
  'b5000000-0000-4000-8000-000000000002','OWNER_A_REPLY');

-- The REAL inventory must refuse the unreviewed post ledger, even though
-- the SQL projection exists. A positive test cannot bypass this gate.
SET LOCAL ROLE service_role;
DO $not_approved$
BEGIN
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   'a5111111-1111-4111-8111-111111111111',
   'a5333333-3333-4333-8333-333333333333',
   'a5555555-5555-4555-8555-555555555555',
   'community.my_posts',NULL,25);
  RAISE EXCEPTION 'Real unapproved Community export unexpectedly authorized';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END $not_approved$;
RESET ROLE;

-- TEST-ONLY inventory stand-in proves the actual page projection itself.
-- The live function still authorizes a valid owner/session/request using the
-- canonical server-side gate, but the only listed source is Community posts.
-- The outer ROLLBACK restores the ORIGINAL inventory function and grants.
CREATE OR REPLACE FUNCTION public.v2_account_export_inventory_review_candidate(
 p_owner uuid,p_session uuid,p_request uuid
) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=''
AS $test_only_inventory$
BEGIN
 PERFORM allin_private.v2_account_export_authorize_request_candidate(
  p_owner,p_session,p_request);
 IF pg_catalog.current_setting('transaction_isolation') <> 'repeatable read'
 THEN RAISE EXCEPTION 'Snapshot required' USING ERRCODE='42501'; END IF;
 RETURN pg_catalog.jsonb_build_object(
  'ownerId',p_owner,'requestId',p_request,'snapshotId',p_request,
  'collections',pg_catalog.jsonb_build_array('community.my_posts','community.my_comments'),
  'complete',false);
END $test_only_inventory$;

SET LOCAL ROLE service_role;
DO $two_owner$
DECLARE
 owner_a uuid:='a5111111-1111-4111-8111-111111111111';
 owner_b uuid:='b5222222-2222-4222-8222-222222222222';
 session_a uuid:='a5333333-3333-4333-8333-333333333333';
 session_b uuid:='b5444444-4444-4444-8444-444444444444';
 request_a uuid:='a5555555-5555-4555-8555-555555555555';
 request_b uuid:='b5666666-6666-4666-8666-666666666666';
 first_page jsonb; second_page jsonb; b_page jsonb;
 combined jsonb; row jsonb;
BEGIN
 first_page:=public.v2_account_export_page_review_candidate(
  owner_a,session_a,request_a,'community.my_posts',NULL,25);
 second_page:=public.v2_account_export_page_review_candidate(
  owner_a,session_a,request_a,'community.my_posts',
  first_page->>'nextCursor',25);
 b_page:=public.v2_account_export_page_review_candidate(
  owner_b,session_b,request_b,'community.my_posts',NULL,25);
 IF pg_catalog.jsonb_array_length(first_page->'rows')<>25
  OR first_page->>'done'<>'false' OR first_page->>'nextCursor'<>'25'
  OR pg_catalog.jsonb_array_length(second_page->'rows')<>6
  OR second_page->>'done'<>'true' OR second_page->>'nextCursor' IS NOT NULL
  OR first_page->>'completeUserExport'<>'false'
  OR pg_catalog.jsonb_array_length(b_page->'rows')<>1
 THEN RAISE EXCEPTION 'Community owner pagination incomplete or falsely released'; END IF;
 combined:=(first_page->'rows')||(second_page->'rows');
 IF (SELECT count(*) FROM pg_catalog.jsonb_array_elements(combined))<>31
  OR (SELECT count(DISTINCT item->>'id')
      FROM pg_catalog.jsonb_array_elements(combined) AS item)<>31
 THEN RAISE EXCEPTION 'Community pagination duplicated or omitted owner posts'; END IF;
 FOR row IN SELECT item FROM pg_catalog.jsonb_array_elements(combined) AS item LOOP
  IF row->>'owner_id'<>owner_a::text
    OR row->>'body' NOT LIKE 'OWNER_A_ONLY_%'
    OR row->>'post_version'<>'1'
    OR row ? 'payload_sha256' OR row ? 'follower_id'
  THEN RAISE EXCEPTION 'Community export leaked foreign or internal content'; END IF;
 END LOOP;
 IF NOT EXISTS (SELECT 1 FROM pg_catalog.jsonb_array_elements(combined) AS item
   WHERE item->>'audience'='private')
  OR b_page::text NOT LIKE '%OWNER_B_SECRET%'
  OR combined::text LIKE '%OWNER_B_SECRET%'
 THEN RAISE EXCEPTION 'Owner-private post missing or other owner leaked'; END IF;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   owner_a,session_b,request_a,'community.my_posts',NULL,25);
  RAISE EXCEPTION 'Foreign Auth session accessed owner A posts';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   owner_b,session_a,request_b,'community.my_posts',NULL,25);
  RAISE EXCEPTION 'Foreign owner/session combination accessed owner B posts';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-251 two-owner gated Community post projection: 31 A over 2 pages, private body, B isolation, real Auth request gate, no completed export';
END $two_owner$;
RESET ROLE;
-- Test-only inventory exercises the REAL author-only comment projection.
-- This never registers comments in the canonical release registry.
SET LOCAL ROLE service_role;
DO $comment_export$
DECLARE
 a uuid:='a5111111-1111-4111-8111-111111111111';
 b uuid:='b5222222-2222-4222-8222-222222222222';
 sa uuid:='a5333333-3333-4333-8333-333333333333';
 sb uuid:='b5444444-4444-4444-8444-444444444444';
 ra uuid:='a5555555-5555-4555-8555-555555555555';
 rb uuid:='b5666666-6666-4666-8666-666666666666';
 pa jsonb;pb jsonb;
BEGIN
 pa:=public.v2_account_export_page_review_candidate(a,sa,ra,'community.my_comments',NULL,25);
 pb:=public.v2_account_export_page_review_candidate(b,sb,rb,'community.my_comments',NULL,25);
 IF pg_catalog.jsonb_array_length(pa->'rows')<>2
   OR pg_catalog.jsonb_array_length(pb->'rows')<>1
   OR pa::text LIKE '%OWNER_B_COMMENT_SECRET%'
   OR pa::text NOT LIKE '%OWNER_A_REPLY%'
   OR pb::text NOT LIKE '%OWNER_B_COMMENT_SECRET%'
   OR pb::text LIKE '%OWNER_A_COMMENT%'
   OR EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(pa->'rows') AS x(item)
     WHERE x.item->>'author_id'<>a::text
       OR x.item ? 'post_owner_id' OR x.item ? 'moderation_reason')
   OR pa->>'completeUserExport'<>'false'
 THEN RAISE EXCEPTION 'Comment author-only export disclosed another author or pretended completeness'; END IF;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(a,sb,ra,
    'community.my_comments',NULL,25);
  RAISE EXCEPTION 'Foreign session read authored comments';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-251 review-only Community comment author export: A 2, B 1, cross-owner denied';
END $comment_export$;
RESET ROLE;

-- Independently review indirect cascade reachability and unknown relationship
-- columns with the NON-DEPLOYED ALL-251 graph scanner. A real Community post
-- owner must be reached by Auth -> Profile -> Post without granting APIs.
\ir V2-ACCOUNT-DELETION-OWNER-GRAPH-PREFLIGHT-REVIEW.sql
CREATE TABLE allin_private.v2_all251_unreviewed_owner_probe (
 id uuid PRIMARY KEY,owner_id uuid NOT NULL
);
CREATE TABLE allin_private.v2_all251_unreviewed_pair_probe (
 id uuid PRIMARY KEY,
 follower_id uuid REFERENCES auth.users(id) ON DELETE CASCADE,
 lower_user_id uuid REFERENCES auth.users(id) ON DELETE CASCADE,
 upper_user_id uuid REFERENCES auth.users(id) ON DELETE CASCADE,
 target_id uuid REFERENCES auth.users(id) ON DELETE CASCADE
);
INSERT INTO storage.buckets(id,name,public)
 VALUES ('all251-disposable-unknown-media','all251-disposable-unknown-media',false);
DO $graph$
DECLARE probe_column text;
BEGIN
 IF EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE schema_name='allin_private' AND table_name='v2_community_posts'
     AND owner_column='owner_id')
 THEN RAISE EXCEPTION 'Known Profile-to-Community Auth cascade not recognized'; END IF;
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE table_name='v2_all251_unreviewed_owner_probe'
     AND owner_column='owner_id'
     AND reason='no_verified_auth_cascade_path')
 THEN RAISE EXCEPTION 'Unknown indirect-owner table was not flagged'; END IF;
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE table_name='v2_all251_unreviewed_pair_probe'
     AND owner_column='follower_id'
     AND reason='relationship_or_actor_retention_policy_required')
 THEN RAISE EXCEPTION 'Relationship retention was inferred solely from FK cascade'; END IF;
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE schema_name='storage' AND table_name='all251-disposable-unknown-media'
     AND reason='unreviewed_storage_bucket_cleanup')
 THEN RAISE EXCEPTION 'Unreviewed Storage bucket went undetected'; END IF;
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE table_name='v2_account_deletion_execution_audit'
     AND reason='audit_retention_policy_required')
 THEN RAISE EXCEPTION 'Persistent deletion audit retention requires explicit review'; END IF;
 FOR probe_column IN SELECT name FROM (VALUES
  ('follower_id'),('lower_user_id'),('upper_user_id'),('target_id')) AS t(name)
 LOOP
  IF NOT EXISTS (SELECT 1
    FROM allin_private.v2_deletion_owner_graph_gaps_review()
    WHERE table_name='v2_all251_unreviewed_pair_probe'
      AND owner_column=probe_column
      AND reason='relationship_or_actor_retention_policy_required')
  THEN RAISE EXCEPTION 'Unreviewed Community relationship % escaped preflight',probe_column;
  END IF;
 END LOOP;
 IF has_function_privilege('authenticated',
   'allin_private.v2_deletion_owner_graph_gaps_review()','EXECUTE')
   OR has_function_privilege('anon',
   'allin_private.v2_deletion_owner_graph_gaps_review()','EXECUTE')
 THEN RAISE EXCEPTION 'Reviewer graph scanner exposed to clients'; END IF;
 RAISE NOTICE 'PASS ALL-251 graph review: Community Auth chain proven, unknown owner and relationship policy gaps flagged, no client API';
END $graph$;
-- The synthetic bucket is removed by the transaction-wide ROLLBACK;
-- Storage forbids direct SQL deletion and its API is intentionally not used.
DROP TABLE allin_private.v2_all251_unreviewed_owner_probe;
DROP TABLE allin_private.v2_all251_unreviewed_pair_probe;

-- Separate synthetic C proves the real indirect chain
-- auth.users -> public.v2_profiles -> allin_private.v2_community_posts.
-- No worker is enabled; deletion is local and fully rolled back.
INSERT INTO auth.users(id) VALUES
 ('c7111111-1111-4111-8111-111111111111');
INSERT INTO public.v2_profiles(user_id) VALUES
 ('c7111111-1111-4111-8111-111111111111') ON CONFLICT DO NOTHING;
INSERT INTO allin_private.v2_community_posts
 (id,owner_id,kind,audience,title,body)
VALUES
 ('c7222222-2222-4222-8222-222222222222',
  'c7111111-1111-4111-8111-111111111111',
  'update','private','Synthetic C private post','SYNTHETIC_C_PRIVATE');
DO $before_delete$
BEGIN
 IF (SELECT count(*) FROM allin_private.v2_community_posts
     WHERE owner_id='c7111111-1111-4111-8111-111111111111')<>1
 OR NOT EXISTS(SELECT 1 FROM allin_private.v2_account_deletion_processor_config
     WHERE singleton=true AND execution_enabled=false)
 THEN RAISE EXCEPTION 'Community cascade fixture or worker-OFF gate invalid'; END IF;
END $before_delete$;
DELETE FROM auth.users WHERE id='c7111111-1111-4111-8111-111111111111';
DO $after_delete$
BEGIN
 IF EXISTS (SELECT 1 FROM auth.users
     WHERE id='c7111111-1111-4111-8111-111111111111')
 OR EXISTS (SELECT 1 FROM public.v2_profiles
     WHERE user_id='c7111111-1111-4111-8111-111111111111')
 OR EXISTS (SELECT 1 FROM allin_private.v2_community_posts
     WHERE owner_id='c7111111-1111-4111-8111-111111111111')
 OR (SELECT count(*) FROM allin_private.v2_community_posts
     WHERE owner_id='a5111111-1111-4111-8111-111111111111')<>31
 OR (SELECT count(*) FROM allin_private.v2_community_posts
     WHERE owner_id='b5222222-2222-4222-8222-222222222222')<>1
 OR NOT EXISTS (SELECT 1 FROM allin_private.v2_account_deletion_processor_config
     WHERE singleton=true AND execution_enabled=false)
 THEN RAISE EXCEPTION 'Community indirect Auth cascade or other-owner preservation failed'; END IF;
 RAISE NOTICE 'PASS ALL-251 Community indirect Auth/profile/post cascade: synthetic C removed, A/B retained, deletion worker OFF';
END $after_delete$;
ROLLBACK;
