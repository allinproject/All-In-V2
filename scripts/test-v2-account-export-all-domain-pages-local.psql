  '97777777-9777-4777-8777-977777777777'::uuid,'user',
  'Owner A Coach page '||lpad(i::text,3,'0'),gen_random_uuid()
 FROM generate_series(1,53) i;
INSERT INTO public.v2_coach_messages(user_id,thread_id,role,content,client_action_id)
