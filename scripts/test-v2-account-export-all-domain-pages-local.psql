  'running','manual_entry','2026-11-12','America/Chicago','manual_only','completed'),
 ('b9222222-9222-4222-8222-922222222222','92222222-9222-4222-8222-922222222222',
  'cycling','manual_entry','2026-11-12','America/Chicago','manual_only','completed');
-- A second high-cardinality domain must paginate under the SAME owner
-- snapshot; the 53 Coach messages alone are not sufficient export coverage.
INSERT INTO public.v2_completed_activities
 (id,user_id,sport,activity_kind,athlete_local_date,timezone,capture_kind,status)
SELECT pg_catalog.gen_random_uuid(),
 '91111111-9111-4111-8111-911111111111'::uuid,
 'running','manual_entry','2026-11-12','America/Chicago','manual_only','completed'
FROM pg_catalog.generate_series(1,31);

INSERT INTO public.v2_events(id,name,sport,event_kind)
 VALUES ('c9111111-9111-4111-8111-911111111111','Representative race','running','race');
INSERT INTO public.v2_event_participations
 (user_id,event_id,state,source_kind,source_note) VALUES
 ('91111111-9111-4111-8111-911111111111',
  'c9111111-9111-4111-8111-911111111111','interested','athlete_confirmed','A private race note'),
 ('92222222-9222-4222-8222-922222222222',
  'c9111111-9111-4111-8111-911111111111','interested','athlete_confirmed','B private race note');
INSERT INTO allin_private.v2_community_visibility(user_id,profile_visibility)
 VALUES ('91111111-9111-4111-8111-911111111111','private'),
 ('92222222-9222-4222-8222-922222222222','public');
INSERT INTO allin_private.v2_community_follows(follower_id,followed_id,state,approved_at)
 VALUES('91111111-9111-4111-8111-911111111111',
 '92222222-9222-4222-8222-922222222222','approved',now());
INSERT INTO allin_private.v2_community_blocks(blocker_id,blocked_id)
 VALUES ('91111111-9111-4111-8111-911111111111',
 '92222222-9222-4222-8222-922222222222');
SET LOCAL ROLE service_role;
DO $all_domain$
DECLARE
 v_owner uuid:='91111111-9111-4111-8111-911111111111';
 v_session uuid:='93333333-9333-4333-8333-933333333333';
 v_request uuid:='95555555-9555-4555-8555-955555555555';
 v jsonb;
 v_page jsonb;
 v_list jsonb;
 v_collection text;
 v_messages integer:=0;
 v_token text:=NULL;
 v_snap text:=NULL;
 v_count integer:=0;
BEGIN
 v:=public.v2_account_export_inventory_review_candidate(v_owner,v_session,v_request);
 v_list:=v->'collections';
 IF v->>'ownerTableCount'<>'42'
   OR pg_catalog.jsonb_array_length(v_list)<>47
   OR v->>'paginationReady'<>'true'
   OR v->>'complete'<>'false'
 THEN RAISE EXCEPTION 'Owner inventory contract incomplete or prematurely marked complete: %',v; END IF;
 v_snap:=v->>'snapshotId';
 FOR v_collection IN SELECT pg_catalog.jsonb_array_elements_text(v_list) LOOP
  v_page:=public.v2_account_export_page_review_candidate(
   v_owner,v_session,v_request,v_collection,NULL,25);
  IF v_page->>'ownerId'<>v_owner::text
    OR v_page->>'snapshotId'<>v_snap
    OR v_page->>'ownerVerified'<>'true'
    OR v_page->>'completeUserExport'<>'false'
    OR v_page->>'collection'<>v_collection
  THEN RAISE EXCEPTION 'Unverified page: %',v_collection; END IF;
  -- Check every emitted owner-table row, not just the top-level page
  -- ownerVerified flag. Missing user_id or a foreign row is a privacy breach.
  IF (v_collection LIKE 'public.%' OR v_collection LIKE 'allin_private.%')
      AND EXISTS(
        SELECT 1 FROM pg_catalog.jsonb_array_elements(v_page->'rows') AS x(item)
        WHERE x.item->>'user_id' IS DISTINCT FROM v_owner::text
      )
  THEN RAISE EXCEPTION 'Unscoped row in owner export source %',v_collection; END IF;
  IF v_collection='auth.users' AND EXISTS(
       SELECT 1 FROM pg_catalog.jsonb_array_elements(v_page->'rows') AS x(item)
       WHERE x.item->>'id' IS DISTINCT FROM v_owner::text
     )
  THEN RAISE EXCEPTION 'Foreign Auth identity was exported'; END IF;
  IF v_collection='community.outgoing_follows' AND EXISTS(
       SELECT 1 FROM pg_catalog.jsonb_array_elements(v_page->'rows') AS x(item)
       WHERE x.item->>'follower_id' IS DISTINCT FROM v_owner::text
     )
  THEN RAISE EXCEPTION 'Foreign outgoing follow row'; END IF;
  IF v_collection='community.outgoing_blocks' AND EXISTS(
       SELECT 1 FROM pg_catalog.jsonb_array_elements(v_page->'rows') AS x(item)
       WHERE x.item->>'blocker_id' IS DISTINCT FROM v_owner::text
     )
  THEN RAISE EXCEPTION 'Foreign outgoing block row'; END IF;
  IF v_collection='community.my_action_receipts' AND EXISTS(
       SELECT 1 FROM pg_catalog.jsonb_array_elements(v_page->'rows') AS x(item)
       WHERE x.item->>'actor_id' IS DISTINCT FROM v_owner::text
     )
  THEN RAISE EXCEPTION 'Foreign Community action row'; END IF;
  v_count:=v_count+1;
 END LOOP;
 IF v_count<>47 THEN RAISE EXCEPTION 'Not all 47 owner collections were probed'; END IF;
 LOOP
  v_page:=public.v2_account_export_page_review_candidate(
    v_owner,v_session,v_request,'public.v2_coach_messages',v_token,25);
  v_messages:=v_messages+pg_catalog.jsonb_array_length(v_page->'rows');
  IF v_page->>'done'='true' THEN EXIT; END IF;
  v_token:=v_page->>'nextCursor';
 END LOOP;
 IF v_messages<>53 THEN RAISE EXCEPTION 'Coach pagination lost or duplicated rows: %',v_messages; END IF;
 -- Completed Activity is independently paginated (32 A rows, 1 B row).
 -- Every page must carry the same pinned snapshot and owner proof.
 v_token:=NULL;
 v_count:=0;
 LOOP
  v_page:=public.v2_account_export_page_review_candidate(
    v_owner,v_session,v_request,'public.v2_completed_activities',v_token,25);
  IF v_page->>'snapshotId'<>v_snap OR v_page->>'ownerVerified'<>'true'
     OR EXISTS (
       SELECT 1 FROM pg_catalog.jsonb_array_elements(v_page->'rows') AS r(item)
       WHERE r.item->>'user_id'<>v_owner::text
     )
  THEN RAISE EXCEPTION 'Completed Activity page leaked another owner or changed snapshot'; END IF;
  v_count:=v_count+pg_catalog.jsonb_array_length(v_page->'rows');
  IF v_page->>'done'='true' THEN EXIT; END IF;
  v_token:=v_page->>'nextCursor';
 END LOOP;
 IF v_count<>32 THEN
  RAISE EXCEPTION 'Completed Activity pagination lost or duplicated owner records: %',v_count;
 END IF;
 -- Representative populated Training, Activity and EventHub pages belong to A.
 v_page:=public.v2_account_export_page_review_candidate(
  v_owner,v_session,v_request,'public.v2_training_plans',NULL,25);
 IF pg_catalog.jsonb_array_length(v_page->'rows')<>1 OR
   v_page#>>'{rows,0,plan_kind}'<>'general'
 THEN RAISE EXCEPTION 'Owner Training plan missing or foreign plan leaked'; END IF;
 v_page:=public.v2_account_export_page_review_candidate(
  v_owner,v_session,v_request,'public.v2_completed_activities',NULL,25);
 IF pg_catalog.jsonb_array_length(v_page->'rows')<>25 OR
   v_page#>>'{rows,0,sport}'<>'running'
 THEN RAISE EXCEPTION 'Owner completed Activity first page missing or foreign activity leaked'; END IF;
 v_page:=public.v2_account_export_page_review_candidate(
  v_owner,v_session,v_request,'public.v2_event_participations',NULL,25);
 IF pg_catalog.jsonb_array_length(v_page->'rows')<>1 OR
   v_page#>>'{rows,0,source_note}'<>'A private race note'
 THEN RAISE EXCEPTION 'EventHub owner export omitted private participation'; END IF;
 v_page:=public.v2_account_export_page_review_candidate(
  v_owner,v_session,v_request,'community.outgoing_blocks',NULL,25);
 IF pg_catalog.jsonb_array_length(v_page->'rows')<>1
 THEN RAISE EXCEPTION 'Owner block missing'; END IF;
 v_page:=public.v2_account_export_page_review_candidate(
  v_owner,v_session,v_request,'community.incoming_follow_requests',NULL,25);
 IF pg_catalog.jsonb_array_length(v_page->'rows')<>0
 THEN RAISE EXCEPTION 'Owner received another athlete follower data'; END IF;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   v_owner,'94444444-9444-4444-8444-944444444444',v_request,
   'public.v2_coach_messages',NULL,25);
  RAISE EXCEPTION 'Foreign session unexpectedly authorized export';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   '92222222-9222-4222-8222-922222222222'::uuid,v_session,v_request,
   'public.v2_coach_messages',NULL,25);
  RAISE EXCEPTION 'Foreign owner unexpectedly authorized export';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   v_owner,v_session,v_request,'allin_private.v2_community_pair_revisions',NULL,25);
  RAISE EXCEPTION 'Pair revision records unexpectedly exported';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   v_owner,v_session,v_request,'public.v2_coach_messages',NULL,100);
  RAISE EXCEPTION 'Unbounded page unexpectedly accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 RAISE NOTICE 'PASS ALL-251: 42 reviewed owner tables + 5 explicit sources, 53 Coach records over 3 owner pages, no complete claim, privacy and Auth rejection';
END $all_domain$;
RESET ROLE;
-- An authenticated mobile client must not be granted the service reader,
-- even if its JWT user ID and request are known.
SET LOCAL ROLE authenticated;
DO $api_gate$
BEGIN
 BEGIN
  PERFORM public.v2_account_export_inventory_review_candidate(
   '91111111-9111-4111-8111-911111111111',
   '93333333-9333-4333-8333-933333333333',
   '95555555-9555-4555-8555-955555555555');
  RAISE EXCEPTION 'Mobile role was granted private inventory reader';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $api_gate$;
RESET ROLE;

-- A source that was not explicitly reviewed must break the whole inventory.
-- It must not be silently excluded, even when it contains no rows.
CREATE TABLE allin_private.v2_future_sensitive_owner_data (
 user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE
);
SET LOCAL ROLE service_role;
DO $unknown_owner$
BEGIN
 BEGIN
  PERFORM public.v2_account_export_inventory_review_candidate(
   '91111111-9111-4111-8111-911111111111',
   '93333333-9333-4333-8333-933333333333',
   '95555555-9555-4555-8555-955555555555');
  RAISE EXCEPTION 'New owner table was silently omitted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $unknown_owner$;
RESET ROLE;
DROP TABLE allin_private.v2_future_sensitive_owner_data;

-- Future V2 domains often carry owner_id/athlete_id/actor_id instead of
-- user_id. The canonical inventory and inline snapshot must BOTH fail closed.
-- No permissions are granted or migrations published by this rollback test.
DO $new_domains$
DECLARE
 v_name text;
 v_column text;
BEGIN
 FOR v_name,v_column IN
  SELECT * FROM (VALUES
   ('v2_nutrition_future_food_log','owner_id'),
   ('v2_progress_future_milestones','athlete_id'),
   ('v2_gear_future_inventory','created_by_user_id'),
   ('v2_community_posts','owner_id')
  ) AS future(name,owner_column)
 LOOP
  EXECUTE pg_catalog.format('CREATE TABLE allin_private.%I (%I uuid)',v_name,v_column);
  EXECUTE 'SET LOCAL ROLE service_role';
  BEGIN
   PERFORM public.v2_account_export_inventory_review_candidate(
    '91111111-9111-4111-8111-911111111111',
    '93333333-9333-4333-8333-933333333333',
    '95555555-9555-4555-8555-955555555555');
   RAISE EXCEPTION 'Unreviewed alternate-key table % bypassed paginated inventory',v_name;
  EXCEPTION WHEN insufficient_privilege THEN NULL; END;
  EXECUTE 'RESET ROLE';
  EXECUTE pg_catalog.format('DROP TABLE allin_private.%I',v_name);
 END LOOP;
 RAISE NOTICE 'PASS ALL-251: Nutrition/Progress/gear/Community owner-key tables force export review';
END $new_domains$;

-- A directional relationship table without user_id is equally sensitive.
CREATE TABLE allin_private.v2_community_unreviewed_directional (
 actor_id uuid, target_id uuid
);
SET LOCAL ROLE service_role;
DO $unknown_relation$
BEGIN
 BEGIN
  PERFORM public.v2_account_export_inventory_review_candidate(
   '91111111-9111-4111-8111-911111111111',
   '93333333-9333-4333-8333-933333333333',
   '95555555-9555-4555-8555-955555555555');
  RAISE EXCEPTION 'New directional table was silently omitted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $unknown_relation$;
RESET ROLE;
DROP TABLE allin_private.v2_community_unreviewed_directional;

-- The blocked athlete must NEVER learn the other athlete blocked them.
SET LOCAL ROLE service_role;
DO $hidden_block$
DECLARE v_page jsonb;
BEGIN
 v_page:=public.v2_account_export_page_review_candidate(
   '92222222-9222-4222-8222-922222222222',
   '94444444-9444-4444-8444-944444444444',
   '96666666-9666-4666-8666-966666666666',
   'public.v2_event_participations',NULL,25);
 IF pg_catalog.jsonb_array_length(v_page->'rows')<>1 OR
   v_page#>>'{rows,0,source_note}'<>'B private race note'
 THEN RAISE EXCEPTION 'B EventHub record omitted or A private note leaked'; END IF;
 v_page:=public.v2_account_export_page_review_candidate(
   '92222222-9222-4222-8222-922222222222',
   '94444444-9444-4444-8444-944444444444',
   '96666666-9666-4666-8666-966666666666',
   'community.outgoing_blocks',NULL,25);
 IF pg_catalog.jsonb_array_length(v_page->'rows')<>0 THEN
   RAISE EXCEPTION 'Another athlete private block leaked in recipient export';
 END IF;
 RAISE NOTICE 'PASS ALL-251: unknown owner/directional tables block export and incoming blocks stay private';
END $hidden_block$;
RESET ROLE;
ROLLBACK;
