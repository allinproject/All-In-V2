\set ON_ERROR_STOP on
-- ALL-251 isolated ONLY. Actual ALL-247 candidate schema, real approved
-- request gate, synthetic A/B identities. Test-only inventory permission
-- override is always reverted by the transaction ROLLBACK.
BEGIN ISOLATION LEVEL REPEATABLE READ;
INSERT INTO auth.users(id) VALUES
 ('a6111111-1111-4111-8111-111111111111'),
 ('b6222222-2222-4222-8222-222222222222');
INSERT INTO auth.sessions(id,user_id) VALUES
 ('a6333333-3333-4333-8333-333333333333','a6111111-1111-4111-8111-111111111111'),
 ('b6444444-4444-4444-8444-444444444444','b6222222-2222-4222-8222-222222222222');
INSERT INTO allin_private.v2_account_export_requests_candidate
 (request_id,user_id,session_id,status,expires_at) VALUES
 ('a6555555-5555-4555-8555-555555555555','a6111111-1111-4111-8111-111111111111',
  'a6333333-3333-4333-8333-333333333333','approved',now()+interval '1 hour'),
 ('b6666666-6666-4666-8666-666666666666','b6222222-2222-4222-8222-222222222222',
  'b6444444-4444-4444-8444-444444444444','approved',now()+interval '1 hour');
\ir ALL-247-food-log-first-writer.review.sql
\ir ALL-247-food-log-lifecycle.review.sql
\ir ALL-247-hydration-manual-lifecycle.review.sql
INSERT INTO public.v2_food_log_entries
 (id,user_id,consumed_at,local_date,timezone_name,meal_slot,label,quantity,unit,kcal,nutrition_source,revision,deleted_at)
SELECT ('a6777777-7777-4777-8777-'||lpad(i::text,12,'0'))::uuid,
 'a6111111-1111-4111-8111-111111111111'::uuid,
 '2026-11-12 12:00:00+00'::timestamptz + i*interval '1 minute',
 '2026-11-12','America/Chicago','snack','Owner A food '||i,
 1,'each',CASE WHEN i=1 THEN NULL WHEN i=2 THEN 0 ELSE 120 END,
 CASE WHEN i=1 THEN 'unknown' ELSE 'user_entered' END,
 CASE WHEN i=4 THEN 2 ELSE 1 END,
 CASE WHEN i=4 THEN now() ELSE NULL END
FROM generate_series(1,27) i;
INSERT INTO public.v2_food_log_entries
 (id,user_id,consumed_at,local_date,timezone_name,meal_slot,label,quantity,unit,kcal,nutrition_source)
VALUES
 ('b6888888-8888-4888-8888-888888888888','b6222222-2222-4222-8222-222222222222',
  '2026-11-12 12:00:00+00','2026-11-12','America/Chicago',
  'snack','OWNER_B_FOOD_SECRET',1,'each',300,'user_entered');

-- Current inventory blocks the new ALL-247 owner table before release.
SET LOCAL ROLE service_role;
DO $unapproved$
BEGIN
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   'a6111111-1111-4111-8111-111111111111',
   'a6333333-3333-4333-8333-333333333333',
   'a6555555-5555-4555-8555-555555555555','public.v2_food_log_entries',NULL,25);
  RAISE EXCEPTION 'Unapproved food log exported by live canonical registry';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $unapproved$;
RESET ROLE;
-- This stub does NOT approve production; it exercises the post-gate exact
-- projection under the real Auth session/request authorizer, then ROLLBACK.
CREATE OR REPLACE FUNCTION public.v2_account_export_inventory_review_candidate(
 p_owner uuid,p_session uuid,p_request uuid
) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=''
AS $test_only_inventory$
BEGIN
 PERFORM allin_private.v2_account_export_authorize_request_candidate(
  p_owner,p_session,p_request);
 IF pg_catalog.current_setting('transaction_isolation') <> 'repeatable read'
 THEN RAISE EXCEPTION 'Snapshot required' USING ERRCODE='42501'; END IF;
 RETURN pg_catalog.jsonb_build_object(
  'ownerId',p_owner,'requestId',p_request,'snapshotId',p_request,
  'collections',pg_catalog.jsonb_build_array(
   'public.v2_food_log_entries',
   'allin_private.v2_food_log_write_actions',
   'public.v2_hydration_events',
   'allin_private.v2_hydration_actions'),
  'complete',false);
END $test_only_inventory$;

SET LOCAL ROLE service_role;
DO $food_two_owner$
DECLARE
 a uuid:='a6111111-1111-4111-8111-111111111111';
 b uuid:='b6222222-2222-4222-8222-222222222222';
 sa uuid:='a6333333-3333-4333-8333-333333333333';
 sb uuid:='b6444444-4444-4444-8444-444444444444';
 ra uuid:='a6555555-5555-4555-8555-555555555555';
 rb uuid:='b6666666-6666-4666-8666-666666666666';
 p1 jsonb;p2 jsonb;pb jsonb; all_rows jsonb; row jsonb;
BEGIN
 p1:=public.v2_account_export_page_review_candidate(a,sa,ra,'public.v2_food_log_entries',NULL,25);
 p2:=public.v2_account_export_page_review_candidate(a,sa,ra,'public.v2_food_log_entries',p1->>'nextCursor',25);
 pb:=public.v2_account_export_page_review_candidate(b,sb,rb,'public.v2_food_log_entries',NULL,25);
 -- Aggregate the two independently validated JSONB page arrays without
 -- relying on an overloaded concatenation expression in PL/pgSQL.
 SELECT COALESCE(pg_catalog.jsonb_agg(part.item ORDER BY part.page_number,part.ordinality),'[]'::jsonb)
 INTO all_rows
 FROM (
  SELECT 1 AS page_number, x.item, x.ordinality
  FROM pg_catalog.jsonb_array_elements(p1->'rows') WITH ORDINALITY AS x(item,ordinality)
  UNION ALL
  SELECT 2 AS page_number, x.item, x.ordinality
  FROM pg_catalog.jsonb_array_elements(p2->'rows') WITH ORDINALITY AS x(item,ordinality)
 ) AS part;
 RAISE NOTICE 'ALL-251 Food Log page diagnostics: p1_count=%, p2_count=%, p1_done=%, p1_cursor=%, p2_done=%, p2_cursor=%, b_count=%, combined_count=%',
  pg_catalog.jsonb_array_length(p1->'rows'),pg_catalog.jsonb_array_length(p2->'rows'),
  p1->>'done',p1->>'nextCursor',p2->>'done',p2->>'nextCursor',
  pg_catalog.jsonb_array_length(pb->'rows'),pg_catalog.jsonb_array_length(all_rows);
 IF pg_catalog.jsonb_array_length(p1->'rows')<>25
  OR pg_catalog.jsonb_array_length(p2->'rows')<>2
  OR p1->>'done'<>'false' OR p1->>'nextCursor'<>'25'
  OR p2->>'done'<>'true' OR p2->>'nextCursor' IS NOT NULL
  OR p1->>'completeUserExport'<>'false'
  OR pg_catalog.jsonb_array_length(pb->'rows')<>1
  OR pg_catalog.jsonb_array_length(all_rows)<>27
  OR (SELECT count(DISTINCT item->>'id')
      FROM pg_catalog.jsonb_array_elements(all_rows) AS item)<>27
 THEN RAISE EXCEPTION 'ALL-247 owner export incomplete: p1 count %, done %, cursor %, p2 count %, done %, cursor %, B count %, total %, distinct %, complete %',
  pg_catalog.jsonb_array_length(p1->'rows'),p1->>'done',p1->>'nextCursor',
  pg_catalog.jsonb_array_length(p2->'rows'),p2->>'done',p2->>'nextCursor',
  pg_catalog.jsonb_array_length(pb->'rows'),pg_catalog.jsonb_array_length(all_rows),
  (SELECT count(DISTINCT item->>'id') FROM pg_catalog.jsonb_array_elements(all_rows) AS item),
  p1->>'completeUserExport'; END IF;
 FOR row IN SELECT item FROM pg_catalog.jsonb_array_elements(all_rows) AS item LOOP
  IF row->>'user_id'<>a::text OR row ? 'request_fingerprint'
   OR row ? 'result_revision' OR row->>'label' LIKE '%OWNER_B%'
  THEN RAISE EXCEPTION 'Food export leaked foreign or private action data'; END IF;
 END LOOP;
 IF NOT EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(all_rows) AS item
   WHERE item->>'revision'='2' AND item->>'deleted_at' IS NOT NULL)
   OR NOT EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(all_rows) AS item
   WHERE item->>'nutrition_source'='unknown' AND item->>'kcal' IS NULL)
   OR NOT EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(all_rows) AS item
   WHERE item->>'nutrition_source'='user_entered'
     AND (item->>'kcal')::numeric=0)
   OR pb::text NOT LIKE '%OWNER_B_FOOD_SECRET%'
   OR all_rows::text LIKE '%OWNER_B_FOOD_SECRET%'
 THEN RAISE EXCEPTION 'Food history verification failed: tombstones %, unknown %, numeric-zero %, B owner content %, A leaked B %',
  (SELECT count(*) FROM pg_catalog.jsonb_array_elements(all_rows) AS item
    WHERE item->>'revision'='2' AND item->>'deleted_at' IS NOT NULL),
  (SELECT count(*) FROM pg_catalog.jsonb_array_elements(all_rows) AS item
    WHERE item->>'nutrition_source'='unknown' AND item->>'kcal' IS NULL),
  (SELECT count(*) FROM pg_catalog.jsonb_array_elements(all_rows) AS item
    WHERE item->>'nutrition_source'='user_entered' AND (item->>'kcal')::numeric=0),
  pb::text LIKE '%OWNER_B_FOOD_SECRET%',
  all_rows::text LIKE '%OWNER_B_FOOD_SECRET%'; END IF;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   a,sb,ra,'public.v2_food_log_entries',NULL,25);
  RAISE EXCEPTION 'Cross-session Food Log read was permitted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-251 Food Log two-owner export: 27 A over 2 pages, deleted history, zero vs unknown, B denied, real request gate, incomplete release';
END $food_two_owner$;
RESET ROLE;

-- All following rows use the actual ALL-247 owner candidate columns.
-- Synthetic test-only rows never survive ROLLBACK.
INSERT INTO public.v2_hydration_events
 (id,user_id,occurred_at,local_date,timezone_name,event_kind,
  original_volume,original_unit,volume_ml,revision,deleted_at)
SELECT ('a6999999-9999-4999-8999-'||lpad(i::text,12,'0'))::uuid,
 'a6111111-1111-4111-8111-111111111111'::uuid,
 '2026-11-12 12:00:00+00'::timestamptz + i*interval '1 minute',
 '2026-11-12','America/Chicago',
 CASE WHEN i%4=0 THEN 'refill' ELSE 'drink' END,
 250,'ml',250.000,
 CASE WHEN i=4 THEN 2 ELSE 1 END,
 CASE WHEN i=4 THEN now() ELSE NULL END
FROM generate_series(1,28) i;
