VALUES
 ('a6111111-1111-4111-8111-111111111111',
  'a611aaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
  'SECRET_FOOD_ACTION_FINGERPRINT_A',
  'a6777777-7777-4777-8777-000000000004',2),
 ('b6222222-2222-4222-8222-222222222222',
  'b622bbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',
  'SECRET_FOOD_ACTION_FINGERPRINT_B',
  'b6888888-8888-4888-8888-888888888888',1);
INSERT INTO allin_private.v2_hydration_actions
 (user_id,action_id,request_fingerprint,result_id,result_revision)
VALUES
 ('a6111111-1111-4111-8111-111111111111',
  'a611cccc-cccc-4ccc-8ccc-cccccccccccc',
  'SECRET_HYDRATION_ACTION_FINGERPRINT_A',
  'a6999999-9999-4999-8999-000000000004',2),
 ('b6222222-2222-4222-8222-222222222222',
  'b622dddd-dddd-4ddd-8ddd-dddddddddddd',
  'SECRET_HYDRATION_ACTION_FINGERPRINT_B',
  'b6999999-9999-4999-8999-999999999999',1);

SET LOCAL ROLE service_role;
DO $fuel_four$
DECLARE
 a uuid:='a6111111-1111-4111-8111-111111111111';
 b uuid:='b6222222-2222-4222-8222-222222222222';
 sa uuid:='a6333333-3333-4333-8333-333333333333';
 sb uuid:='b6444444-4444-4444-8444-444444444444';
 ra uuid:='a6555555-5555-4555-8555-555555555555';
 rb uuid:='b6666666-6666-4666-8666-666666666666';
 h1 jsonb;h2 jsonb;hb jsonb;hrows jsonb;
 fa jsonb;fb jsonb;ha jsonb;hb_actions jsonb;
BEGIN
 h1:=public.v2_account_export_page_review_candidate(
  a,sa,ra,'public.v2_hydration_events',NULL,25);
 h2:=public.v2_account_export_page_review_candidate(
  a,sa,ra,'public.v2_hydration_events',h1->>'nextCursor',25);
 hb:=public.v2_account_export_page_review_candidate(
  b,sb,rb,'public.v2_hydration_events',NULL,25);
 SELECT COALESCE(pg_catalog.jsonb_agg(parts.item ORDER BY parts.p,parts.ord),'[]'::jsonb)
 INTO hrows FROM (
  SELECT 1 AS p,x.item,x.ordinality AS ord FROM
   pg_catalog.jsonb_array_elements(h1->'rows') WITH ORDINALITY x(item,ordinality)
  UNION ALL
  SELECT 2 AS p,x.item,x.ordinality AS ord FROM
   pg_catalog.jsonb_array_elements(h2->'rows') WITH ORDINALITY x(item,ordinality)
 ) parts;
 IF pg_catalog.jsonb_array_length(h1->'rows')<>25
  OR pg_catalog.jsonb_array_length(h2->'rows')<>3
  OR pg_catalog.jsonb_array_length(hb->'rows')<>1
  OR h1->>'nextCursor'<>'25' OR h2->>'done'<>'true'
  OR (SELECT count(DISTINCT item->>'id')
      FROM pg_catalog.jsonb_array_elements(hrows) AS item)<>28
  OR (SELECT count(*) FROM pg_catalog.jsonb_array_elements(hrows) AS item
      WHERE item->>'event_kind'='refill')<>7
  OR NOT EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(hrows) AS item
      WHERE item->>'revision'='2' AND item->>'deleted_at' IS NOT NULL)
  OR EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(hrows) AS item
      WHERE item->>'user_id'<>a::text OR item->>'source_platform'<>'manual'
        OR item->>'confidence'<>'user_confirmed')
  OR hrows::text LIKE '%b6222222-2222-4222-8222-222222222222%'
  OR h1->>'completeUserExport'<>'false'
 THEN RAISE EXCEPTION 'Hydration pages omitted a private refill, tombstone, or owner source'; END IF;
 fa:=public.v2_account_export_page_review_candidate(
   a,sa,ra,'allin_private.v2_food_log_write_actions',NULL,25);
 fb:=public.v2_account_export_page_review_candidate(
   b,sb,rb,'allin_private.v2_food_log_write_actions',NULL,25);
 ha:=public.v2_account_export_page_review_candidate(
   a,sa,ra,'allin_private.v2_hydration_actions',NULL,25);
 hb_actions:=public.v2_account_export_page_review_candidate(
   b,sb,rb,'allin_private.v2_hydration_actions',NULL,25);
 IF pg_catalog.jsonb_array_length(fa->'rows')<>1
  OR pg_catalog.jsonb_array_length(fb->'rows')<>1
  OR pg_catalog.jsonb_array_length(ha->'rows')<>1
  OR pg_catalog.jsonb_array_length(hb_actions->'rows')<>1
  OR fa#>>'{rows,0,user_id}' IS DISTINCT FROM a::text
  OR ha#>>'{rows,0,user_id}' IS DISTINCT FROM a::text
  OR fa#>>'{rows,0,result_revision}'<>'2'
  OR ha#>>'{rows,0,result_revision}'<>'2'
  OR fa->'rows'->0 ? 'request_fingerprint'
  OR ha->'rows'->0 ? 'request_fingerprint'
  OR (fa::text||ha::text) LIKE '%SECRET_%'
  OR (fa::text||ha::text) LIKE '%b6222222-2222-4222-8222-222222222222%'
 THEN RAISE EXCEPTION 'Fuel action receipts leaked replay fingerprint or other owner'; END IF;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   a,sb,ra,'public.v2_hydration_events',NULL,25);
  RAISE EXCEPTION 'Foreign session read owner A hydration';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_account_export_page_review_candidate(
   b,sa,rb,'allin_private.v2_hydration_actions',NULL,25);
  RAISE EXCEPTION 'Foreign session read owner B actions';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-251 Fuel four projections: 28 A hydration entries/2 pages, refill and tombstone retained, A/B private action receipts redacted, cross-session denial, incomplete export';
END $fuel_four$;
RESET ROLE;
ROLLBACK;
