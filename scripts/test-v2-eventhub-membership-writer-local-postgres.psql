\set ON_ERROR_STOP on
-- ALL-244: local Supabase verified group + explicit athlete action, all ROLLBACK.
BEGIN;
DO $memberqa$
DECLARE
 a uuid:='11111111-1111-4111-8111-111111111111';
 b uuid:='22222222-2222-4222-8222-222222222222';
 sa uuid:='33333333-3333-4333-8333-333333333333';
 sb uuid:='44444444-4444-4444-8444-444444444444';
 e uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 g uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 alias_id uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 join_a uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 join_b uuid:='eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee';
 result jsonb;
BEGIN
 INSERT INTO auth.users(id) VALUES(a),(b);
 INSERT INTO auth.sessions(id,user_id) VALUES(sa,a),(sb,b);
 INSERT INTO public.v2_events(id,edition_id,name,sport,event_kind,
   start_local_date,event_timezone,source_verification)
 VALUES(e,'10000000-0000-4000-8000-000000000001','Spring Trail Race','running','ultra',DATE '2027-04-10',
   'America/Chicago','organizer_verified');
 INSERT INTO public.v2_event_groups(id,event_id,state) VALUES(g,e,'active');
 INSERT INTO public.v2_event_url_aliases(
   id,event_id,canonical_url,evidence_kind,source_checked_at)
 VALUES(alias_id,e,'https://example.org/spring','organizer_verified',now());
 BEGIN
  PERFORM allin_private.v2_event_group_action_candidate(
   a,sb,e,g,join_a,alias_id,'join',1);
  RAISE EXCEPTION 'Cross-user EventHub Auth session joined';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_event_group_action_candidate(
   a,sa,e,g,join_a,null,'join',1);
  RAISE EXCEPTION 'Unresolved URL joined a verified EventHub group';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_event_group_action_candidate(
   a,sa,e,g,join_a,alias_id,null,1);
  RAISE EXCEPTION 'NULL action kind changed private EventHub membership';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 result:=allin_private.v2_event_group_action_candidate(
  a,sa,e,g,join_a,alias_id,'join',1);
 IF result->>'version'<>'2' OR result->>'replayed'<>'false'
 THEN RAISE EXCEPTION 'First explicit EventHub group join failed: %',result; END IF;
 IF (SELECT participant_visible FROM public.v2_event_group_memberships
     WHERE user_id=a AND group_id=g)
 THEN RAISE EXCEPTION 'EventHub group join automatically published athlete'; END IF;
 IF EXISTS(SELECT 1 FROM public.v2_event_participations WHERE user_id=a)
 THEN RAISE EXCEPTION 'EventHub group join fabricated event registration'; END IF;
 result:=allin_private.v2_event_group_action_candidate(
  a,sa,e,g,join_a,alias_id,'join',1);
 IF result->>'replayed'<>'true' OR result->>'version'<>'2'
 THEN RAISE EXCEPTION 'Exact EventHub join replay duplicated state'; END IF;
 BEGIN
  PERFORM allin_private.v2_event_group_action_candidate(
   a,sa,e,g,join_a,alias_id,'leave',1);
  RAISE EXCEPTION 'EventHub action ID reused as leave';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_event_group_action_candidate(
   a,sa,e,g,'66666666-6666-4666-8666-666666666666',null,'leave',1);
  RAISE EXCEPTION 'Stale EventHub membership version accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 result:=allin_private.v2_event_group_action_candidate(
  a,sa,e,g,'77777777-7777-4777-8777-777777777777',null,
  'show_participation',2);
 IF result->>'version'<>'3' OR NOT (SELECT participant_visible
     FROM public.v2_event_group_memberships WHERE user_id=a AND group_id=g)
 THEN RAISE EXCEPTION 'Explicit visibility action failed'; END IF;
 result:=allin_private.v2_event_group_action_candidate(
  a,sa,e,g,'88888888-8888-4888-8888-888888888888',null,
  'hide_participation',3);
 IF result->>'version'<>'4' OR (SELECT participant_visible
     FROM public.v2_event_group_memberships WHERE user_id=a AND group_id=g)
 THEN RAISE EXCEPTION 'Explicit privacy hide failed'; END IF;
 result:=allin_private.v2_event_group_action_candidate(
  b,sb,e,g,join_b,alias_id,'join',1);
 IF result->>'version'<>'2'
 THEN RAISE EXCEPTION 'Other athlete could not independently join'; END IF;
 result:=allin_private.v2_event_group_action_candidate(
  a,sa,e,g,'99999999-9999-4999-8999-999999999999',null,'leave',4);
 IF result->>'version'<>'5'
   OR (SELECT state FROM public.v2_event_group_memberships
       WHERE user_id=a AND group_id=g)<>'left'
   OR (SELECT participant_visible FROM public.v2_event_group_memberships
       WHERE user_id=a AND group_id=g)
 THEN RAISE EXCEPTION 'Leaving group failed to remove visibility'; END IF;
 IF (SELECT state FROM public.v2_event_group_memberships
     WHERE user_id=b AND group_id=g)<>'joined'
 THEN RAISE EXCEPTION 'One athlete leaving changed another athlete membership'; END IF;
 IF pg_catalog.has_function_privilege('authenticated',
     'allin_private.v2_event_group_action_candidate(uuid,uuid,uuid,uuid,uuid,uuid,text,bigint)',
     'EXECUTE')
   OR pg_catalog.has_function_privilege('service_role',
     'allin_private.v2_event_group_action_candidate(uuid,uuid,uuid,uuid,uuid,uuid,text,bigint)',
     'EXECUTE')
 THEN RAISE EXCEPTION 'Unapproved group writer grant leaked'; END IF;
 DELETE FROM auth.users WHERE id=a;
 IF EXISTS(SELECT 1 FROM allin_private.v2_event_group_actions WHERE user_id=a)
   OR EXISTS(SELECT 1 FROM public.v2_event_group_memberships WHERE user_id=a)
 THEN RAISE EXCEPTION 'Deleted athlete retained membership or action receipts'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.v2_event_group_memberships WHERE user_id=b)
 THEN RAISE EXCEPTION 'Unaffected athlete group membership was removed'; END IF;
 RAISE NOTICE 'PASS ALL-244: verified URL, explicit join, source/registration separation, CAS, replay, privacy and Auth cascade';
END $memberqa$;
ROLLBACK;
