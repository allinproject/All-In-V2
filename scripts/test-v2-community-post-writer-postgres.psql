SELECT set_config('request.jwt.claim.session_id','83000000-0000-4000-8000-000000000003',false);
DO $second_report$
BEGIN
 PERFORM allin_private.v2_community_report_comment(
  '84000000-0000-4000-8000-000000000002',
  '82000000-0000-4000-8000-000000000005','spam','Separate reporter');
END $second_report$;
SELECT set_config('request.jwt.claim.session_id','83000000-0000-4000-8000-000000000003',false);
DO $initial_review$
DECLARE r jsonb;
BEGIN
 r:=allin_private.v2_community_decide_report(
  '84000000-0000-4000-8000-000000000001',1,'hide');
 IF r->>'version'<>'2' OR
  (SELECT moderation_state FROM allin_private.v2_community_comments
   WHERE id='82000000-0000-4000-8000-000000000005')<>'hidden'
 THEN RAISE EXCEPTION 'Trusted reviewer could not hide case'; END IF;
 BEGIN
  PERFORM allin_private.v2_community_decide_report(
   '84000000-0000-4000-8000-000000000001',1,'dismiss');
  RAISE EXCEPTION 'Stale reviewer decision overwritten';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
END $initial_review$;
-- A separate reviewer holds the second reported case, but may not
-- downgrade the already-hidden state from the first case.
SELECT set_config('request.jwt.claim.sub','00000000-0000-0000-0000-000000000004',false);
SELECT set_config('request.jwt.claim.session_id','83000000-0000-4000-8000-000000000004',false);
DO $second_decision$
BEGIN
 PERFORM allin_private.v2_community_decide_report(
  '84000000-0000-4000-8000-000000000002',1,'hold');
 IF (SELECT moderation_state FROM allin_private.v2_community_comments
  WHERE id='82000000-0000-4000-8000-000000000005')<>'hidden'
 THEN RAISE EXCEPTION 'Second hold incorrectly overrode first hide'; END IF;
END $second_decision$;
SELECT set_config('request.jwt.claim.sub','00000000-0000-0000-0000-000000000003',false);
SELECT set_config('request.jwt.claim.session_id','83000000-0000-4000-8000-000000000003',false);
-- Removing a trusted reviewer grant must take effect immediately, not
-- merely when the reviewer's JWT expires.
UPDATE allin_private.v2_community_moderator_grants SET enabled=false
WHERE reviewer_id='00000000-0000-0000-0000-000000000003'
 AND permission='initial_review';
