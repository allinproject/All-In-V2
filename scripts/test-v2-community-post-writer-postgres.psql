 (follower_id,followed_id,state,approved_at)
VALUES('00000000-0000-0000-0000-000000000003',
 '00000000-0000-0000-0000-000000000002','approved',now())
ON CONFLICT(follower_id,followed_id) DO UPDATE SET
 state='approved',approved_at=now();
