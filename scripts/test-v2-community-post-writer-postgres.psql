   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000004',
   '80000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000002',
   'Reply to moderated parent',true);
  RAISE EXCEPTION 'Moderation-held parent allowed a reply';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $held_parent_reply$;
DO $held_comment$
DECLARE r jsonb;
BEGIN
 r:=public.v2_community_comments_read(
  '80000000-0000-0000-0000-000000000001');
 IF r::text LIKE '%Author reply%' THEN
   RAISE EXCEPTION 'Moderation-held comment disclosed'; END IF;
 BEGIN
  PERFORM public.v2_community_edit_comment(
   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000002',1,'Bypass held');
  RAISE EXCEPTION 'Held comment edit accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
END $held_comment$;
