DO $moderation_acl$
DECLARE r record;
BEGIN
 FOR r IN SELECT c.oid,c.relrowsecurity FROM pg_class c
 JOIN pg_namespace n ON n.oid=c.relnamespace
 WHERE n.nspname='allin_private'
 AND c.relname IN ('v2_community_moderator_grants',
  'v2_community_moderation_reports','v2_community_moderation_appeals',
  'v2_community_moderation_events')
 LOOP
  IF NOT r.relrowsecurity OR
    has_table_privilege('authenticated',r.oid,'SELECT')
   OR has_table_privilege('authenticated',r.oid,'INSERT')
   OR has_table_privilege('service_role',r.oid,'UPDATE')
  THEN RAISE EXCEPTION 'Moderation privacy table grant/RLS violation'; END IF;
 END LOOP;
 IF has_function_privilege('authenticated',
   'allin_private.v2_community_decide_report(uuid,bigint,text)','EXECUTE')
 THEN RAISE EXCEPTION 'Exposed moderation decision'; END IF;
END $moderation_acl$;
