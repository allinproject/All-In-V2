DO $real_report$
DECLARE r jsonb;
BEGIN
 r:=allin_private.v2_community_report_comment(
   '84000000-0000-4000-8000-000000000001',
   '82000000-0000-4000-8000-000000000005','harassment','Reported');
 IF r->>'status'<>'reported' THEN RAISE EXCEPTION 'Report missing'; END IF;
 r:=allin_private.v2_community_report_comment(
   '84000000-0000-4000-8000-000000000001',
   '82000000-0000-4000-8000-000000000005','harassment','Reported');
 IF (SELECT count(*) FROM allin_private.v2_community_moderation_events
   WHERE report_id='84000000-0000-4000-8000-000000000001')<>1
 THEN RAISE EXCEPTION 'Report idempotency duplicated audit'; END IF;
 BEGIN
  PERFORM allin_private.v2_community_decide_report(
   '84000000-0000-4000-8000-000000000001',1,'hide');
  RAISE EXCEPTION 'Reporter moderated own case';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $real_report$;
-- A different authorized viewer independently reports the same comment.
-- The two cases must never overwrite one another's visibility decisions.
