\set ON_ERROR_STOP on
\ir test-v2-community-reader-postgres.psql
CREATE TABLE auth.sessions(id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE);
\ir ../docs/architecture/sql/V2-COMMUNITY-CANONICAL-POSTS-OWNER-CANDIDATE.sql
\ir ../docs/architecture/sql/V2-COMMUNITY-POST-UPDATE-WRITER-CANDIDATE.sql
\ir ../docs/architecture/sql/V2-COMMUNITY-MODERATION-WORKFLOW-REVIEW-CANDIDATE.sql

DO $private_acl$
BEGIN
 IF has_function_privilege('authenticated',
    'public.v2_community_create_update_post(uuid,uuid,text,text,text,boolean)',
    'EXECUTE')
 OR has_function_privilege('authenticated',
    'public.v2_community_edit_update_post(uuid,uuid,bigint,text,text,text)',
    'EXECUTE')
 OR has_function_privilege('anon',
    'public.v2_community_create_update_post(uuid,uuid,text,text,text,boolean)',
    'EXECUTE')
 THEN RAISE EXCEPTION 'Unapproved Community post writer API EXECUTE'; END IF;
END $private_acl$;


-- ALL-222 review gate: every candidate Community object is catalog-checked,
-- including future additions not listed in a hand-maintained function array.
-- These are unapproved owner candidates: no client role receives direct access.
DO $community_candidate_roles$
DECLARE
  tbl record;
  fn record;
  role_name text;
  privilege_name text;
  tables_seen integer:=0;
  functions_seen integer:=0;
BEGIN
  IF has_schema_privilege('anon','allin_private','USAGE')
     OR has_schema_privilege('authenticated','allin_private','USAGE') THEN
    RAISE EXCEPTION 'Community private schema exposed to a client role';
  END IF;
  FOR tbl IN
    SELECT c.oid,c.relname,c.relrowsecurity,n.nspname
    FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
    WHERE c.relkind IN ('r','p')
      AND n.nspname IN ('allin_private','public')
      AND c.relname LIKE 'v2_community_%'
  LOOP
    tables_seen:=tables_seen+1;
    IF tbl.nspname<>'allin_private' OR NOT tbl.relrowsecurity THEN
      RAISE EXCEPTION 'Unapproved Community table %.% exposed or RLS off',
        tbl.nspname,tbl.relname;
    END IF;
    FOREACH role_name IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
      FOREACH privilege_name IN ARRAY ARRAY[
        'SELECT','INSERT','UPDATE','DELETE','TRUNCATE','REFERENCES','TRIGGER'
      ] LOOP
        IF has_table_privilege(role_name,tbl.oid,privilege_name) THEN
          RAISE EXCEPTION 'Unapproved Community table %.% grants % to %',
            tbl.nspname,tbl.relname,privilege_name,role_name;
        END IF;
      END LOOP;
    END LOOP;
  END LOOP;
  IF tables_seen<6 THEN
    RAISE EXCEPTION 'Community candidate graph incomplete: only % tables',tables_seen;
  END IF;
  FOR fn IN
    SELECT p.oid,p.proname,n.nspname
    FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
    WHERE n.nspname IN ('public','allin_private')
      AND p.proname LIKE 'v2_community_%'
  LOOP
    functions_seen:=functions_seen+1;
    FOREACH role_name IN ARRAY ARRAY['anon','authenticated'] LOOP
      IF has_function_privilege(role_name,fn.oid,'EXECUTE') THEN
        RAISE EXCEPTION 'Unapproved Community function %.% callable by %',
          fn.nspname,fn.proname,role_name;
      END IF;
    END LOOP;
  END LOOP;
  IF functions_seen<3 THEN
    RAISE EXCEPTION 'Community writer/reader candidate functions missing';
  END IF;
  RAISE NOTICE 'ALL-222 Community catalog audited % tables, % functions',
    tables_seen,functions_seen;
END
$community_candidate_roles$;

SELECT set_config('request.jwt.claim.sub',
 '00000000-0000-0000-0000-000000000002',false);
DO $owner_post$
DECLARE r jsonb;
BEGIN
 BEGIN
  PERFORM public.v2_community_create_update_post(
   '00000000-0000-0000-0000-000000000002',
   '80000000-0000-0000-0000-000000000001','public','Testing',
   'No explicit approval',false);
  RAISE EXCEPTION 'Non-approved post was persisted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;

 r:=public.v2_community_create_update_post(
  '00000000-0000-0000-0000-000000000002',
  '80000000-0000-0000-0000-000000000001','public','Testing',
  'Explicit athlete update',true);
 IF r->>'created'<>'true' OR r->>'version'<>'1' THEN
  RAISE EXCEPTION 'Canonical explicit create failed: %',r;
 END IF;
 r:=public.v2_community_create_update_post(
  '00000000-0000-0000-0000-000000000002',
  '80000000-0000-0000-0000-000000000001','public','Testing',
  'Explicit athlete update',true);
 IF r->>'created'<>'false' OR r->>'version'<>'1' THEN
  RAISE EXCEPTION 'Exact canonical create retry was not idempotent: %',r;
 END IF;
 BEGIN
  PERFORM public.v2_community_create_update_post(
   '00000000-0000-0000-0000-000000000002',
   '80000000-0000-0000-0000-000000000001','public','Changed title',
   'Explicit athlete update',true);
  RAISE EXCEPTION 'Reused canonical post ID accepted changed payload';
 EXCEPTION WHEN unique_violation THEN NULL; END;

 r:=public.v2_community_edit_update_post(
  '00000000-0000-0000-0000-000000000002',
  '80000000-0000-0000-0000-000000000001',
  1,'followers','Edited title','Edited existing body');
 IF r->>'version'<>'2' OR r->>'edited'<>'true' THEN
  RAISE EXCEPTION 'Guarded edit did not advance source post version: %',r;
 END IF;

 BEGIN
  PERFORM public.v2_community_edit_update_post(
   '00000000-0000-0000-0000-000000000002',
   '80000000-0000-0000-0000-000000000001',
   1,'public','Stale overwrite','wrong');
  RAISE EXCEPTION 'Stale canonical post edit accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;

 IF (SELECT count(*) FROM allin_private.v2_community_posts
     WHERE owner_id='00000000-0000-0000-0000-000000000002')<>1 OR
   NOT EXISTS(SELECT 1 FROM allin_private.v2_community_posts
     WHERE id='80000000-0000-0000-0000-000000000001'
       AND post_version=2 AND title='Edited title' AND audience='followers')
 THEN RAISE EXCEPTION 'Edit reposted instead of changing canonical row'; END IF;
END $owner_post$;

SELECT set_config('request.jwt.claim.sub',
 '00000000-0000-0000-0000-000000000001',false);
DO $other$
BEGIN
 BEGIN
  PERFORM public.v2_community_edit_update_post(
   '00000000-0000-0000-0000-000000000001',
   '80000000-0000-0000-0000-000000000001',2,
   'public','Hijacked','No');
  RAISE EXCEPTION 'Cross-owner canonical update edit accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 BEGIN
  PERFORM public.v2_community_create_update_post(
   '00000000-0000-0000-0000-000000000002',
   '80000000-0000-0000-0000-000000000002',
   'public','Acting as owner','No',true);
  RAISE EXCEPTION 'Cross-owner create accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $other$;

-- Comments must use the parent post's CURRENT audience and block boundary.
-- User 1 is not a follower of user 2's followers-only post.
DO $comment_denied$
BEGIN
 BEGIN
  PERFORM public.v2_community_create_comment(
   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000001',
   '80000000-0000-0000-0000-000000000001',NULL,'Not a follower',true);
  RAISE EXCEPTION 'Unapproved follower commented';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $comment_denied$;
INSERT INTO allin_private.v2_community_follows
 (follower_id,followed_id,state,approved_at)
VALUES('00000000-0000-0000-0000-000000000001',
 '00000000-0000-0000-0000-000000000002','approved',now())
ON CONFLICT (follower_id,followed_id) DO UPDATE SET
 state='approved',approved_at=now();
DO $comment_approved$
DECLARE r jsonb;
BEGIN
 BEGIN
  PERFORM public.v2_community_create_comment(
   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000001',
   '80000000-0000-0000-0000-000000000001',NULL,'No consent',false);
  RAISE EXCEPTION 'Comment lacking explicit intent persisted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 r:=public.v2_community_create_comment(
   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000001',
   '80000000-0000-0000-0000-000000000001',NULL,'Approved comment',true);
 IF r->>'created'<>'true' THEN RAISE EXCEPTION 'Approved comment was not created'; END IF;
 r:=public.v2_community_create_comment(
   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000001',
   '80000000-0000-0000-0000-000000000001',NULL,'Approved comment',true);
 IF r->>'created'<>'false' THEN RAISE EXCEPTION 'Exact comment retry was not idempotent'; END IF;
 BEGIN
  PERFORM public.v2_community_create_comment(
   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000001',
   '80000000-0000-0000-0000-000000000001',NULL,'Changed comment',true);
  RAISE EXCEPTION 'Changed retry accepted existing comment id';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 r:=public.v2_community_create_comment(
   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000002',
   '80000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000001','Author reply',true);
 IF r->>'created'<>'true' THEN RAISE EXCEPTION 'Same-post reply was not created'; END IF;
END $comment_approved$;
-- Guarded owner revision editing and irreversible tombstone deletion.
DO $edit_comment$
DECLARE r jsonb;
BEGIN
 r:=public.v2_community_edit_comment(
  '00000000-0000-0000-0000-000000000001',
  '82000000-0000-4000-8000-000000000001',1,'Edited authored body');
 IF r->>'revision'<>'2' OR
  (SELECT body FROM allin_private.v2_community_comments
   WHERE id='82000000-0000-4000-8000-000000000001')<>'Edited authored body'
 THEN RAISE EXCEPTION 'Comment edit did not update same ID'; END IF;
 BEGIN
  PERFORM public.v2_community_edit_comment(
   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000001',1,'Stale edit');
  RAISE EXCEPTION 'Stale comment edit accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 r:=public.v2_community_delete_comment(
  '00000000-0000-0000-0000-000000000001',
  '82000000-0000-4000-8000-000000000001',2);
 IF r->>'revision'<>'3' OR r->>'deleted'<>'true'
 OR (SELECT body FROM allin_private.v2_community_comments
   WHERE id='82000000-0000-4000-8000-000000000001')<>'[deleted]'
 OR (SELECT deleted_at FROM allin_private.v2_community_comments
   WHERE id='82000000-0000-4000-8000-000000000001') IS NULL
 THEN RAISE EXCEPTION 'Comment deletion did not redact source body'; END IF;
 r:=public.v2_community_delete_comment(
  '00000000-0000-0000-0000-000000000001',
  '82000000-0000-4000-8000-000000000001',2);
 IF r->>'retry'<>'true' THEN RAISE EXCEPTION 'Exact comment delete retry denied'; END IF;
 BEGIN
  PERFORM public.v2_community_edit_comment(
   '00000000-0000-0000-0000-000000000001',
   '82000000-0000-4000-8000-000000000001',3,'Resurrected');
  RAISE EXCEPTION 'Deleted comment resurrected';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 IF (SELECT count(*) FROM allin_private.v2_community_comments
   WHERE post_id='80000000-0000-0000-0000-000000000001')<>2 THEN
   RAISE EXCEPTION 'Comment editing/deletion duplicated a post item'; END IF;
END $edit_comment$;
-- A different account cannot edit or delete authored records.
