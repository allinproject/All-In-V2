\set ON_ERROR_STOP on
\ir test-v2-community-reader-postgres.psql
\ir ../docs/architecture/sql/V2-COMMUNITY-CANONICAL-POSTS-OWNER-CANDIDATE.sql
\ir ../docs/architecture/sql/V2-COMMUNITY-POST-UPDATE-WRITER-CANDIDATE.sql

DO $private_acl$
BEGIN
 IF has_function_privilege('authenticated',
    'public.v2_community_create_update_post(uuid,uuid,text,text,text,boolean)',
    'EXECUTE')
 OR has_function_privilege('authenticated',
    'public.v2_community_edit_update_post(uuid,uuid,bigint,text,text,text)',
    'EXECUTE')
 OR has_function_privilege('anon',
    'public.v2_community_create_update_post(uuid,uuid,text,text,text,boolean)',
    'EXECUTE')
 THEN RAISE EXCEPTION 'Unapproved Community post writer API EXECUTE'; END IF;
END $private_acl$;

SELECT set_config('request.jwt.claim.sub',
 '00000000-0000-0000-0000-000000000002',false);
DO $owner_post$
DECLARE r jsonb;
BEGIN
 BEGIN
  PERFORM public.v2_community_create_update_post(
   '00000000-0000-0000-0000-000000000002',
   '80000000-0000-0000-0000-000000000001','public','Testing',
   'No explicit approval',false);
  RAISE EXCEPTION 'Non-approved post was persisted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;

 r:=public.v2_community_create_update_post(
  '00000000-0000-0000-0000-000000000002',
  '80000000-0000-0000-0000-000000000001','public','Testing',
  'Explicit athlete update',true);
 IF r->>'created'<>'true' OR r->>'version'<>'1' THEN
  RAISE EXCEPTION 'Canonical explicit create failed: %',r;
 END IF;
 r:=public.v2_community_create_update_post(
  '00000000-0000-0000-0000-000000000002',
  '80000000-0000-0000-0000-000000000001','public','Testing',
  'Explicit athlete update',true);
 IF r->>'created'<>'false' OR r->>'version'<>'1' THEN
  RAISE EXCEPTION 'Exact canonical create retry was not idempotent: %',r;
 END IF;
 BEGIN
  PERFORM public.v2_community_create_update_post(
   '00000000-0000-0000-0000-000000000002',
   '80000000-0000-0000-0000-000000000001','public','Changed title',
   'Explicit athlete update',true);
  RAISE EXCEPTION 'Reused canonical post ID accepted changed payload';
 EXCEPTION WHEN unique_violation THEN NULL; END;

 r:=public.v2_community_edit_update_post(
  '00000000-0000-0000-0000-000000000002',
  '80000000-0000-0000-0000-000000000001',
  1,'followers','Edited title','Edited existing body');
 IF r->>'version'<>'2' OR r->>'edited'<>'true' THEN
  RAISE EXCEPTION 'Guarded edit did not advance source post version: %',r;
 END IF;

 BEGIN
  PERFORM public.v2_community_edit_update_post(
   '00000000-0000-0000-0000-000000000002',
   '80000000-0000-0000-0000-000000000001',
   1,'public','Stale overwrite','wrong');
  RAISE EXCEPTION 'Stale canonical post edit accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;

 IF (SELECT count(*) FROM allin_private.v2_community_posts
     WHERE owner_id='00000000-0000-0000-0000-000000000002')<>1 OR
   NOT EXISTS(SELECT 1 FROM allin_private.v2_community_posts
     WHERE id='80000000-0000-0000-0000-000000000001'
       AND post_version=2 AND title='Edited title' AND audience='followers')
 THEN RAISE EXCEPTION 'Edit reposted instead of changing canonical row'; END IF;
END $owner_post$;

SELECT set_config('request.jwt.claim.sub',
 '00000000-0000-0000-0000-000000000001',false);
DO $other$
BEGIN
 BEGIN
  PERFORM public.v2_community_edit_update_post(
   '00000000-0000-0000-0000-000000000001',
   '80000000-0000-0000-0000-000000000001',2,
   'public','Hijacked','No');
  RAISE EXCEPTION 'Cross-owner canonical update edit accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 BEGIN
  PERFORM public.v2_community_create_update_post(
   '00000000-0000-0000-0000-000000000002',
   '80000000-0000-0000-0000-000000000002',
   'public','Acting as owner','No',true);
  RAISE EXCEPTION 'Cross-owner create accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $other$;

DELETE FROM auth.users WHERE id='00000000-0000-0000-0000-000000000002';
DO $deleted$
BEGIN
 IF EXISTS (SELECT 1 FROM allin_private.v2_community_posts
   WHERE id='80000000-0000-0000-0000-000000000001') THEN
  RAISE EXCEPTION 'Canonical update post survived owner deletion';
 END IF;
END $deleted$;

\echo PASS: canonical update post explicit create, exact retry, edited same ID, stale/cross-owner denial and deletion.
