-- Permanent deletes remain unreadable in server-side comment views.
DO $deleted_body_read$
DECLARE r jsonb;
BEGIN
 r:=public.v2_community_comments_read(
  '80000000-0000-0000-0000-000000000001');
 IF r::text LIKE '%Edited authored body%'
 OR r::text LIKE '%Approved comment%'
 OR r::text LIKE '%Author reply%'
 THEN RAISE EXCEPTION 'Deleted or held comment body leaked'; END IF;
END $deleted_body_read$;
DELETE FROM allin_private.v2_community_blocks
 WHERE blocker_id='00000000-0000-0000-0000-000000000002'
   AND blocked_id='00000000-0000-0000-0000-000000000001';

