SELECT set_config('request.jwt.claim.sub','00000000-0000-0000-0000-000000000004',false);
SELECT set_config('request.jwt.claim.session_id','83000000-0000-4000-8000-000000000004',false);
DO $independent_appeal$
DECLARE r jsonb;
BEGIN
 r:=allin_private.v2_community_resolve_appeal(
  '84000000-0000-4000-8000-000000000001',3,'overturn');
 IF r->>'version'<>'4' OR
  (SELECT moderation_state FROM allin_private.v2_community_comments
   WHERE id='82000000-0000-4000-8000-000000000005')<>'held'
 THEN RAISE EXCEPTION 'Overturn wrongly cleared second active hold'; END IF;
 IF (SELECT pg_catalog.string_agg(event_kind,',' ORDER BY version)
  FROM allin_private.v2_community_moderation_events
  WHERE report_id='84000000-0000-4000-8000-000000000001')
  <>'reported,initial_decision,appealed,appeal_decision'
 THEN RAISE EXCEPTION 'Complete moderation audit trail missing'; END IF;
 IF (SELECT count(*) FROM allin_private.v2_community_moderation_events
  WHERE report_id='84000000-0000-4000-8000-000000000001')<>4
 THEN RAISE EXCEPTION 'Unexpected audit event count'; END IF;
END $independent_appeal$;
SELECT set_config('request.jwt.claim.sub','00000000-0000-0000-0000-000000000001',false);
SELECT set_config('request.jwt.claim.session_id','83000000-0000-4000-8000-000000000001',false);
