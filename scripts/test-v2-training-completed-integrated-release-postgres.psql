\set ON_ERROR_STOP on
-- ALL-222 / ALL-243 / ALL-246 / ALL-253: one-schema release-candidate
-- compatibility replay. Disposable PG17 only; never run against V2 Supabase.
DO $roles$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN; END IF;
END $roles$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
CREATE TABLE auth.sessions(id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id));
CREATE TABLE public.v2_profiles(user_id uuid PRIMARY KEY REFERENCES auth.users(id));
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$
 SELECT nullif(pg_catalog.current_setting('request.jwt.claim.sub',true),'')::uuid
$$;
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETED-IDENTITY-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-PLAN-CALENDAR-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-IMMUTABLE-REVISION-GUARD-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-PLAN-ACCEPTANCE-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SESSION-LIFECYCLE-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-AUTH-OWNER-GATEWAY-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SOURCE-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SCALAR-METRICS-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-METRIC-DEFINITION-GUARD-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SEGMENTS-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-STRENGTH-SETS-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SCALAR-READ-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETION-ACK-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-ACTIVITY-OUTBOX-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-START-PLANNED-WORKOUT-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-INDOOR-WEEKLY-COMPETITION-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-INDOOR-WEEKLY-SCORE-V1-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-EVIDENCE-OBJECTS-CANDIDATE.sql
DO $integration$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 p uuid:='22222222-2222-4222-8222-222222222222';
 rev uuid:='33333333-3333-4333-8333-333333333333';
 slot uuid:='44444444-4444-4444-8444-444444444444';
 proposed uuid:='55555555-5555-4555-8555-555555555555';
 training uuid:='66666666-6666-4666-8666-666666666666';
 activity uuid:='77777777-7777-4777-8777-777777777777';
 source uuid:='88888888-8888-4888-8888-888888888888';
 challenge uuid:='99999999-9999-4999-8999-999999999999';
 v jsonb;
BEGIN
 INSERT INTO auth.users(id) VALUES(u);
 INSERT INTO public.v2_profiles(user_id) VALUES(u);
 INSERT INTO public.v2_training_plans(id,user_id,plan_kind) VALUES(p,u,'general');
 INSERT INTO public.v2_training_plan_revisions(id,plan_id,user_id,revision_number,status,source_kind)
 VALUES(rev,p,u,1,'candidate','coach_proposal');
 INSERT INTO public.v2_training_session_slots(id,plan_id,user_id,slot_key)
 VALUES(slot,p,u,'weekly-bike');
 INSERT INTO public.v2_training_revision_days(id,plan_revision_id,plan_id,user_id,athlete_local_date,
 timezone,day_state,sort_order) VALUES
 ('aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',rev,p,u,'2026-11-11','America/Chicago','planned',0);
 INSERT INTO public.v2_training_revision_sessions(id,plan_revision_id,session_slot_id,plan_id,
 user_id,athlete_local_date,timezone,sport,session_kind,purpose,priority,intensity,
 intent_schema_version,intent,sort_order) VALUES
 (proposed,rev,slot,p,u,'2026-11-11','America/Chicago','cycling','intervals',
 'Quality ride','key','hard','session-intent-v1','{}',0);
 v:=allin_private.v2_training_accept_plan_revision_candidate(
   u,p,rev,'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',1);
 IF v->>'version'<>'2' THEN RAISE EXCEPTION 'Revision acceptance failed'; END IF;
 v:=allin_private.v2_training_start_scheduled_candidate(
   u,training,proposed,'cccccccc-cccc-4ccc-8ccc-cccccccccccc',2,'2026-11-11 12:00+00');
 IF v->>'replayed'<>'false' THEN RAISE EXCEPTION 'Planned workout start failed'; END IF;
 PERFORM allin_private.v2_training_apply_session_candidate(
   u,training,'dddddddd-dddd-4ddd-8ddd-dddddddddddd','finish',1,
   repeat('a',64),NULL,NULL,'2026-11-11 13:00+00');
 v:=allin_private.v2_training_create_activity_from_outbox_candidate(
   u,training,activity,'cycling','workout','device_measured',source,
   'supported_equipment','device_session','bike-100','unverified',repeat('a',64));
 IF v->>'status'<>'needs_review' THEN RAISE EXCEPTION 'Unreviewed activity falsely completed'; END IF;
 INSERT INTO public.v2_activity_metric_definitions(
 metric_code,definition_version,display_name,canonical_unit,value_kind,sport_scope,
 measurement_kinds,display_group,privacy_class,status)
 VALUES('avg_power_w',1,'Average power','W','numeric',ARRAY['cycling'],
 ARRAY['source_measured'],'power','private','published');
 v:=allin_private.v2_activity_append_scalar_candidate(
   u,activity,source,'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee',
   'avg_power_w',1,'source_measured',210,NULL,NULL,repeat('a',64));
 IF v->>'replayed'<>'false' THEN RAISE EXCEPTION 'Scalar fact not attached'; END IF;
 v:=allin_private.v2_activity_scalar_evidence_projection_candidate(u,activity);
 IF jsonb_array_length(v->'metrics')<>0 OR jsonb_array_length(v->'unresolvedMetrics')<>1
 THEN RAISE EXCEPTION 'Unverified source leaked into readable metrics: %',v; END IF;
 INSERT INTO public.v2_indoor_weekly_challenges(id,week_start,rules_version,generator_version,
 scoring_version,prescription_version,common_structure_id,workout_definition,
 scored_effort_definition,opens_at,closes_at)
 VALUES(challenge,'2026-11-09','rules-v1','generator-v1','challenge-score-v1',
 'prescription-v1','indoor-ride','{}','{}','2026-11-09 09:00+00','2026-11-16 09:00+00');
 INSERT INTO public.v2_indoor_weekly_attempts(id,challenge_id,user_id,completed_activity_id,
 frozen_prescription_version,frozen_prescription,frozen_baseline)
 VALUES('ffffffff-ffff-4fff-8fff-ffffffffffff',challenge,u,activity,'v1','{}','{}');
 IF (SELECT verification_state FROM public.v2_indoor_weekly_attempts
    WHERE challenge_id=challenge)<>'pending'
 THEN RAISE EXCEPTION 'Unverified imported result was competition-ranked'; END IF;
 IF EXISTS(SELECT 1 FROM public.v2_indoor_weekly_leaderboard WHERE challenge_id=challenge)
 THEN RAISE EXCEPTION 'Unreviewed attempt produced leaderboard credit'; END IF;
 IF (SELECT publication_enabled FROM allin_private.v2_indoor_weekly_config)
 THEN RAISE EXCEPTION 'Competition enabled in release-candidate replay'; END IF;
 IF EXISTS(SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
  WHERE n.nspname='public' AND c.relkind IN ('r','p')
    AND (c.relname LIKE 'v2_training%' OR c.relname LIKE 'v2_completed%' OR c.relname LIKE 'v2_activity_%' OR c.relname LIKE 'v2_indoor_weekly%') AND
    (NOT c.relrowsecurity OR has_table_privilege('authenticated',c.oid,'INSERT')))
 THEN RAISE EXCEPTION 'Integrated schema exposed unreviewed client writes'; END IF;
 RAISE NOTICE 'PASS ALL-222/243/246/253: plan -> accepted session -> completion -> source -> metrics -> unverified challenge';
END $integration$;
