\set ON_ERROR_STOP on
-- ALL-246 isolated PostgreSQL 17 writer replay. No hosted database.
CREATE ROLE anon NOLOGIN;
CREATE ROLE authenticated NOLOGIN;
CREATE ROLE service_role NOLOGIN;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETED-IDENTITY-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SESSION-LIFECYCLE-WRITER-CANDIDATE.sql
DO $qa$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 other uuid:='22222222-2222-4222-8222-222222222222';
 sess uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 second uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 action_start uuid:='00000000-0000-4000-8000-000000000001';
 action_pause uuid:='00000000-0000-4000-8000-000000000002';
 action_resume uuid:='00000000-0000-4000-8000-000000000003';
 action_finish uuid:='00000000-0000-4000-8000-000000000004';
 action_retry uuid:='00000000-0000-4000-8000-000000000005';
 fp text:=repeat('a',64);
 result jsonb;
BEGIN
 INSERT INTO auth.users(id) VALUES (u),(other);
 result:=allin_private.v2_training_apply_session_candidate(
   u,sess,action_start,'start',0,fp,'2026-11-11','America/Chicago','2026-11-11 10:00+00');
 IF result->>'status'<>'active' OR result->>'version'<>'1'
   OR result->>'replayed'<>'false' THEN RAISE EXCEPTION 'start failed'; END IF;
 result:=allin_private.v2_training_apply_session_candidate(
   u,sess,action_start,'start',0,fp,'2026-11-11','America/Chicago','2026-11-11 10:00+00');
 IF result->>'replayed'<>'true' THEN RAISE EXCEPTION 'exact replay missing'; END IF;
 BEGIN
  PERFORM allin_private.v2_training_apply_session_candidate(
    u,sess,action_start,'cancel',1,fp,NULL,NULL,'2026-11-11 10:01+00');
  RAISE EXCEPTION 'same action ID accepted for different command';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_training_apply_session_candidate(
    u,second,action_retry,'start',0,fp,'2026-11-11','America/Chicago','2026-11-11 10:02+00');
  RAISE EXCEPTION 'parallel active session permitted';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_training_apply_session_candidate(
    other,sess,action_retry,'pause',1,fp,NULL,NULL,'2026-11-11 10:03+00');
  RAISE EXCEPTION 'foreign-owner action permitted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 result:=allin_private.v2_training_apply_session_candidate(
   u,sess,action_pause,'pause',1,fp,NULL,NULL,'2026-11-11 10:05+00');
 IF result->>'status'<>'paused' OR result->>'version'<>'2'
   THEN RAISE EXCEPTION 'pause failed'; END IF;
 BEGIN
  PERFORM allin_private.v2_training_apply_session_candidate(
    u,sess,action_retry,'resume',1,fp,NULL,NULL,'2026-11-11 10:06+00');
  RAISE EXCEPTION 'stale version permitted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 result:=allin_private.v2_training_apply_session_candidate(
   u,sess,action_resume,'resume',2,fp,NULL,NULL,'2026-11-11 10:10+00');
 IF result->>'status'<>'active' OR result->>'version'<>'3'
   THEN RAISE EXCEPTION 'resume failed'; END IF;
 result:=allin_private.v2_training_apply_session_candidate(
   u,sess,action_finish,'finish',3,fp,NULL,NULL,'2026-11-11 10:20+00');
 IF result->>'status'<>'completed' OR result->>'version'<>'4'
    THEN RAISE EXCEPTION 'finish failed'; END IF;
 result:=allin_private.v2_training_apply_session_candidate(
   u,sess,action_finish,'finish',3,fp,NULL,NULL,'2026-11-11 10:20+00');
 IF result->>'replayed'<>'true' THEN RAISE EXCEPTION 'finish replay failed'; END IF;
 IF (SELECT count(*) FROM allin_private.v2_training_completion_outbox
        WHERE session_instance_id=sess)<>1
 OR (SELECT count(*) FROM public.v2_training_execution_events
        WHERE session_instance_id=sess)<>4
 OR (SELECT max(sequence_number) FROM public.v2_training_execution_events
        WHERE session_instance_id=sess)<>4
 OR (SELECT count(*) FROM allin_private.v2_training_action_receipts
        WHERE session_id=sess)<>4
 THEN RAISE EXCEPTION 'duplicate/lost outbox, event, or action receipt'; END IF;
 BEGIN
  PERFORM allin_private.v2_training_apply_session_candidate(
    u,sess,action_retry,'finish',4,fp,NULL,NULL,'2026-11-11 10:21+00');
  RAISE EXCEPTION 'double finish accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 IF has_function_privilege('authenticated',
   'allin_private.v2_training_apply_session_candidate(uuid,uuid,uuid,text,bigint,text,date,text,timestamptz)',
   'EXECUTE')
 OR has_function_privilege('anon',
   'allin_private.v2_training_apply_session_candidate(uuid,uuid,uuid,text,bigint,text,date,text,timestamptz)',
   'EXECUTE')
 THEN RAISE EXCEPTION 'client can call private writer'; END IF;
 RAISE NOTICE 'PASS ALL-246 writer: start/pause/resume/finish, exact replay, stale owner/version, one outbox and private-only';
END $qa$;
