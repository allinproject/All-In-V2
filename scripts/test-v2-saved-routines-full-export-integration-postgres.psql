\set ON_ERROR_STOP on
-- ALL-246/251 disposable full-graph integration regression only.
-- Run in clone of passing training_export_bridge; NEVER on hosted Supabase.
-- Requires original ALL-251 export RPC, Coaching/Billing/Training/Activity
-- source schemas, and two synthetic auth.users (A/B).
CREATE TABLE IF NOT EXISTS auth.sessions (
 id uuid PRIMARY KEY,
 user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE
);
INSERT INTO auth.sessions(id,user_id) VALUES
 ('aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','11111111-1111-4111-8111-111111111111'),
 ('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','22222222-2222-4222-8222-222222222222')
 ON CONFLICT(id) DO NOTHING;
INSERT INTO public.v2_profiles(user_id)
 SELECT u.id FROM auth.users u
 WHERE u.id IN ('11111111-1111-4111-8111-111111111111',
   '22222222-2222-4222-8222-222222222222')
   AND NOT EXISTS(SELECT 1 FROM public.v2_profiles p WHERE p.user_id=u.id);

\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SAVED-ROUTINES-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SAVED-ROUTINES-READ-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SAVED-ROUTINES-ARCHIVE-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SAVED-ROUTINES-EXPORT-FRAGMENT-CANDIDATE.sql

-- Seed user A with an archived immutable version, and B with a different
-- routine, to prove canonical owner export coverage + strict isolation.
BEGIN;
INSERT INTO public.v2_training_routines(id,user_id,current_version,archived_at)
 VALUES
 ('aaa00000-0000-4000-8000-000000000001','11111111-1111-4111-8111-111111111111',1,now()),
 ('bbb00000-0000-4000-8000-000000000001','22222222-2222-4222-8222-222222222222',1,NULL);
INSERT INTO public.v2_training_routine_versions(
 routine_id,user_id,version,name,sport,notes,blocks
) VALUES
 ('aaa00000-0000-4000-8000-000000000001','11111111-1111-4111-8111-111111111111',
  1,'Retained archived Routine','strength','',
  '[{"kind":"strength","id":"source-a","exercise":"Squat","equipment":null,"notes":"","sets":3,"reps":"5","weight":null,"restSeconds":90,"setType":"working","groupId":null}]'::jsonb),
 ('bbb00000-0000-4000-8000-000000000001','22222222-2222-4222-8222-222222222222',
  1,'Different owner Routine','strength','',
  '[{"kind":"strength","id":"source-b","exercise":"Pullup","equipment":null,"notes":"","sets":2,"reps":"6","weight":null,"restSeconds":60,"setType":"working","groupId":null}]'::jsonb);
INSERT INTO allin_private.v2_training_routine_owner_epochs(user_id,epoch)
 VALUES ('11111111-1111-4111-8111-111111111111',1),
 ('22222222-2222-4222-8222-222222222222',1);
INSERT INTO allin_private.v2_training_routine_actions(
 user_id,action_id,payload_digest,routine_id,result_version
) VALUES ('11111111-1111-4111-8111-111111111111',
 'a0000000-0000-4000-8000-000000000001','0123456789abcdef0123456789abcdef',
 'aaa00000-0000-4000-8000-000000000001',1);
COMMIT;

SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '11111111-1111-4111-8111-111111111111',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',false);
-- Existing fail-closed ALL-251 registry MUST reject newly added personal
-- Routine tables until BOTH canonical export overlays are installed.
DO $before$
BEGIN
 BEGIN
  PERFORM public.v2_export_my_account_snapshot(
    '11111111-1111-4111-8111-111111111111');
  RAISE EXCEPTION 'FAIL: original export silently omitted new Routine tables';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END $before$;

\i /tmp/allin/docs/architecture/sql/V2-TRAINING-ROUTINES-ACCOUNT-EXPORT-INTEGRATED-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-ACCOUNT-EXPORT-TRAINING-ROUTINES-INTEGRATED-CANDIDATE.sql

DO $grants$
BEGIN
 IF NOT pg_catalog.has_function_privilege('authenticated',
   'public.v2_export_my_account_snapshot(uuid)','EXECUTE') OR
 pg_catalog.has_function_privilege('anon',
   'public.v2_export_my_account_snapshot(uuid)','EXECUTE') OR
 pg_catalog.has_function_privilege('authenticated',
   'allin_private.v2_training_routine_export_fragment_candidate(uuid)','EXECUTE') OR
 pg_catalog.has_function_privilege('service_role',
   'allin_private.v2_training_routine_export_fragment_candidate(uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'FAIL: canonical export permissions changed'; END IF;
END $grants$;
SET ROLE authenticated;
DO $qa$
DECLARE v jsonb;
BEGIN
 v:=public.v2_export_my_account_snapshot(
  '11111111-1111-4111-8111-111111111111');
 IF v->>'schema_version'<>'v2-account-export-snapshot-v2' OR
    v#>>'{training_activity,ownerId}'<>'11111111-1111-4111-8111-111111111111' OR
    v#>>'{saved_routines,ownerId}'<>'11111111-1111-4111-8111-111111111111' OR
    v#>>'{saved_routines,completeAccountExport}'<>'false' OR
    pg_catalog.jsonb_array_length(v#>'{saved_routines,records,public.v2_training_routines}')<>1 OR
    pg_catalog.jsonb_array_length(v#>'{saved_routines,records,public.v2_training_routine_versions}')<>1 OR
    pg_catalog.jsonb_array_length(v#>'{saved_routines,records,allin_private.v2_training_routine_owner_epochs}')<>1 OR
    pg_catalog.jsonb_array_length(v#>'{saved_routines,records,allin_private.v2_training_routine_actions}')<>1 OR
    v#>>'{saved_routines,records,public.v2_training_routine_versions,0,name}'<>
      'Retained archived Routine' OR
    NOT(v ? 'coach_conversation') OR NOT(v ? 'billing') THEN
   RAISE EXCEPTION 'FAIL: canonical ALL-251 export did not include complete Routine fragment';
 END IF;
 BEGIN
  PERFORM public.v2_export_my_account_snapshot(
   '22222222-2222-4222-8222-222222222222');
  RAISE EXCEPTION 'FAIL: owner A accessed user B account export';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
END $qa$;
RESET ROLE;
-- B sees only B; archived A is not leaked. All data remains disposable.
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '22222222-2222-4222-8222-222222222222',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',false);
SET ROLE authenticated;
DO $b$
DECLARE v jsonb;
BEGIN
 v:=public.v2_export_my_account_snapshot(
  '22222222-2222-4222-8222-222222222222');
 IF v#>>'{saved_routines,records,public.v2_training_routines,0,id}'<>
    'bbb00000-0000-4000-8000-000000000001' OR
    pg_catalog.jsonb_array_length(v#>'{saved_routines,records,public.v2_training_routine_actions}')<>0 THEN
  RAISE EXCEPTION 'FAIL: B saw A routine or A action receipts';
 END IF;
END $b$;
RESET ROLE;
\echo 'PASS ALL-246/251 isolated canonical account export + Routine owner coverage'
