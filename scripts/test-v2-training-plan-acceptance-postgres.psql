\set ON_ERROR_STOP on
-- ALL-246 isolated plan acceptance tests: never production data.
DO $roles$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN; END IF;
END $roles$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETED-IDENTITY-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-PLAN-CALENDAR-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-PLAN-ACCEPTANCE-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-IMMUTABLE-REVISION-GUARD-CANDIDATE.sql
DO $qa$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 outsider uuid:='22222222-2222-4222-8222-222222222222';
 p uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 r1 uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 r2 uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 act uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 res jsonb;
BEGIN
 INSERT INTO auth.users VALUES(u),(outsider);
 INSERT INTO public.v2_training_plans(id,user_id,plan_kind,status)
 VALUES(p,u,'race','draft');
 INSERT INTO public.v2_training_plan_revisions
 (id,plan_id,user_id,revision_number,source_kind,status)
 VALUES(r1,p,u,1,'coach_proposal','candidate'),
       (r2,p,u,2,'athlete_authored','candidate');
 -- These athlete-approved bounds are independent of the submitted day rows.
 UPDATE public.v2_training_plan_revisions
 SET calendar_start_date='2026-11-16', calendar_end_date='2026-11-16',
     calendar_timezone='America/Chicago'
 WHERE id IN (r1,r2);
 INSERT INTO public.v2_training_revision_days
 (id,plan_revision_id,plan_id,user_id,athlete_local_date,timezone,day_state,sort_order)
 VALUES('12121212-1212-4212-8212-121212121212',r1,p,u,'2026-11-16','America/Chicago','planned',0),
       ('13131313-1313-4313-8313-131313131313',r2,p,u,'2026-11-16','America/Chicago','recovery',0);
 BEGIN
   PERFORM allin_private.v2_training_accept_plan_revision_candidate(
      outsider,p,r1,act,1);
   RAISE EXCEPTION 'Cross-owner candidate accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 -- A candidate draft can still be edited before athlete acceptance.
 UPDATE public.v2_training_revision_days SET day_state='recovery'
  WHERE plan_revision_id=r1;
 UPDATE public.v2_training_revision_days SET day_state='planned'
  WHERE plan_revision_id=r1;
 -- A complete day row is NOT an approved calendar window by itself.
 UPDATE public.v2_training_plan_revisions
 SET calendar_start_date=NULL,calendar_end_date=NULL,calendar_timezone=NULL
 WHERE id=r1;
 BEGIN
   PERFORM allin_private.v2_training_accept_plan_revision_candidate(
      u,p,r1,'32323232-3232-4232-8232-323232323232',1);
   RAISE EXCEPTION 'Accepted calendar silently inferred its coverage window';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 UPDATE public.v2_training_plan_revisions
 SET calendar_start_date='2026-11-16',calendar_end_date='2026-11-16',
     calendar_timezone='America/Chicago'
 WHERE id=r1;
 res:=allin_private.v2_training_accept_plan_revision_candidate(u,p,r1,act,1);
 IF res->>'version'<>'2' OR res->>'replayed'<>'false' THEN
   RAISE EXCEPTION 'First acceptance failed'; END IF;
 IF (SELECT active_revision_id FROM public.v2_training_plans WHERE id=p)<>r1
 OR (SELECT status FROM public.v2_training_plan_revisions WHERE id=r1)<>'accepted'
 THEN RAISE EXCEPTION 'Accepted revision not current'; END IF;
 -- Accepted window dates are immutable, not only workout rows.
 BEGIN
   UPDATE public.v2_training_plan_revisions
   SET calendar_end_date='2026-11-17' WHERE id=r1;
   RAISE EXCEPTION 'Accepted calendar window was mutable';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  UPDATE public.v2_training_revision_days SET day_state='rest'
   WHERE plan_revision_id=r1;
  RAISE EXCEPTION 'Accepted day content was mutable';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  INSERT INTO public.v2_training_revision_days
    (id,plan_revision_id,plan_id,user_id,athlete_local_date,timezone,day_state,sort_order)
  VALUES('14141414-1414-4414-8414-141414141414',
    r1,p,u,'2026-11-17','America/Chicago','planned',1);
  RAISE EXCEPTION 'Accepted revision accepted new date';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 res:=allin_private.v2_training_accept_plan_revision_candidate(u,p,r1,act,1);
 IF res->>'replayed'<>'true' THEN RAISE EXCEPTION 'Exact acceptance retry duplicated'; END IF;
 BEGIN
   PERFORM allin_private.v2_training_accept_plan_revision_candidate(u,p,r2,act,1);
   RAISE EXCEPTION 'Same action used for different revision';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
   PERFORM allin_private.v2_training_accept_plan_revision_candidate(
    u,p,r2,'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee',1);
   RAISE EXCEPTION 'Stale plan version was accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 res:=allin_private.v2_training_accept_plan_revision_candidate(
  u,p,r2,'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee',2);
 IF res->>'version'<>'3' THEN RAISE EXCEPTION 'Second accepted revision failed'; END IF;
 IF (SELECT status FROM public.v2_training_plan_revisions WHERE id=r1)<>'superseded'
   OR (SELECT status FROM public.v2_training_plan_revisions WHERE id=r2)<>'accepted'
   OR (SELECT count(*) FROM public.v2_training_plan_revisions
      WHERE plan_id=p AND status='accepted')<>1
 THEN RAISE EXCEPTION 'Old historical revision not preserved'; END IF;
 BEGIN
  UPDATE public.v2_training_revision_days SET day_state='unavailable'
    WHERE plan_revision_id=r1;
  RAISE EXCEPTION 'Superseded revision day was mutable';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  UPDATE public.v2_training_plan_revisions SET source_kind='controlled_system'
    WHERE id=r2;
  RAISE EXCEPTION 'Accepted revision metadata was mutable';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_training_accept_plan_revision_candidate(
   u,p,r1,'ffffffff-ffff-4fff-8fff-ffffffffffff',3);
  RAISE EXCEPTION 'Superseded revision resurrected';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 IF has_function_privilege('authenticated',
 'allin_private.v2_training_accept_plan_revision_candidate(uuid,uuid,uuid,uuid,bigint)','EXECUTE')
 THEN RAISE EXCEPTION 'Untrusted client can accept a plan directly'; END IF;
 RAISE NOTICE 'PASS ALL-246 plan acceptance: owner, revision/version CAS, replay and historical preservation';
END $qa$;

-- An athlete must not be offered a contradictory accepted training calendar.
-- These are candidate edits before acceptance, never historical rewrites.
DO $calendar$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 p uuid:='20202020-2020-4020-8020-202020202020';
 rev uuid:='21212121-2121-4121-8121-212121212121';
 slot uuid:='22222222-aaaa-4222-8222-222222222222';
 sid uuid:='23232323-2323-4323-8323-232323232323';
 day_id uuid:='24242424-2424-4424-8424-242424242424';
 result jsonb;
BEGIN
 INSERT INTO public.v2_training_plans(id,user_id,plan_kind) VALUES(p,u,'general');
 INSERT INTO public.v2_training_plan_revisions(id,plan_id,user_id,revision_number,status,source_kind)
 VALUES(rev,p,u,1,'candidate','coach_proposal');
 UPDATE public.v2_training_plan_revisions
 SET calendar_start_date='2026-11-17',calendar_end_date='2026-11-17',
     calendar_timezone='America/Chicago'
 WHERE id=rev;
 INSERT INTO public.v2_training_session_slots(id,plan_id,user_id,slot_key)
 VALUES(slot,p,u,'bike-interv');
 INSERT INTO public.v2_training_revision_days
 (id,plan_revision_id,plan_id,user_id,athlete_local_date,timezone,day_state,sort_order)
 VALUES(day_id,rev,p,u,'2026-11-17','America/Chicago','rest',0);
 INSERT INTO public.v2_training_revision_sessions
 (id,plan_revision_id,session_slot_id,plan_id,user_id,athlete_local_date,
  timezone,sport,session_kind,purpose,priority,intensity,intent_schema_version,intent,sort_order)
 VALUES(sid,rev,slot,p,u,'2026-11-17','America/Chicago',
 'cycling','interval','Trainer ride','key','hard','session-intent-v1','{}',0);
 BEGIN
  PERFORM allin_private.v2_training_accept_plan_revision_candidate(
   u,p,rev,'25252525-2525-4525-8525-252525252525',1);
  RAISE EXCEPTION 'Workout accepted on designated rest day';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 IF (SELECT version FROM public.v2_training_plans WHERE id=p)<>1
 OR (SELECT status FROM public.v2_training_plan_revisions WHERE id=rev)<>'candidate'
 THEN RAISE EXCEPTION 'Invalid plan acceptance caused partial write'; END IF;
 UPDATE public.v2_training_revision_days SET day_state='planned' WHERE id=day_id;
 UPDATE public.v2_training_revision_sessions SET timezone='America/New_York' WHERE id=sid;
 BEGIN
  PERFORM allin_private.v2_training_accept_plan_revision_candidate(
   u,p,rev,'26262626-2626-4626-8626-262626262626',1);
  RAISE EXCEPTION 'Timezone-inconsistent workout calendar accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 UPDATE public.v2_training_revision_sessions SET timezone='America/Chicago' WHERE id=sid;
 -- Reject a missing FIRST day even if all submitted days are contiguous.
 UPDATE public.v2_training_plan_revisions
 SET calendar_start_date='2026-11-16' WHERE id=rev;
 BEGIN
  PERFORM allin_private.v2_training_accept_plan_revision_candidate(
   u,p,rev,'28282828-2828-4828-8828-282828282828',1);
  RAISE EXCEPTION 'Approved start boundary omitted but accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 UPDATE public.v2_training_plan_revisions
 SET calendar_start_date='2026-11-17', calendar_end_date='2026-11-19'
 WHERE id=rev;
 -- Even with a valid session/day pair, an accepted revision must not
 -- silently skip dates inside its submitted calendar window.
 INSERT INTO public.v2_training_revision_days
 (id,plan_revision_id,plan_id,user_id,athlete_local_date,timezone,day_state,sort_order)
 VALUES('29292929-2929-4929-8929-292929292929',
        rev,p,u,'2026-11-19','America/Chicago','recovery',2);
 BEGIN
  PERFORM allin_private.v2_training_accept_plan_revision_candidate(
   u,p,rev,'30303030-3030-4030-8030-303030303030',1);
  RAISE EXCEPTION 'Calendar with missing interior day accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 IF (SELECT version FROM public.v2_training_plans WHERE id=p)<>1
 OR (SELECT status FROM public.v2_training_plan_revisions WHERE id=rev)<>'candidate'
 THEN RAISE EXCEPTION 'Gapped plan acceptance caused partial write'; END IF;
 INSERT INTO public.v2_training_revision_days
 (id,plan_revision_id,plan_id,user_id,athlete_local_date,timezone,day_state,sort_order)
 VALUES('31313131-3131-4131-8131-313131313131',
        rev,p,u,'2026-11-18','America/Chicago','rest',1);
 -- Matching but nonexistent timezone strings must NOT become accepted
 -- simply because revision, day and scheduled session agree with each other.
 UPDATE public.v2_training_plan_revisions SET calendar_timezone='Mars/Phobos'
 WHERE id=rev;
 UPDATE public.v2_training_revision_days SET timezone='Mars/Phobos'
 WHERE plan_revision_id=rev;
 UPDATE public.v2_training_revision_sessions SET timezone='Mars/Phobos'
 WHERE plan_revision_id=rev;
 BEGIN
  PERFORM allin_private.v2_training_accept_plan_revision_candidate(
   u,p,rev,'34343434-3434-4434-8434-343434343434',1);
  RAISE EXCEPTION 'Accepted nonexistent timezone as canonical local calendar';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 IF (SELECT version FROM public.v2_training_plans WHERE id=p)<>1
 OR (SELECT status FROM public.v2_training_plan_revisions WHERE id=rev)<>'candidate'
 THEN RAISE EXCEPTION 'Invalid timezone acceptance partially mutated plan'; END IF;
 UPDATE public.v2_training_plan_revisions SET calendar_timezone='America/Chicago'
 WHERE id=rev;
 UPDATE public.v2_training_revision_days SET timezone='America/Chicago'
 WHERE plan_revision_id=rev;
 UPDATE public.v2_training_revision_sessions SET timezone='America/Chicago'
 WHERE plan_revision_id=rev;
 result:=allin_private.v2_training_accept_plan_revision_candidate(
  u,p,rev,'27272727-2727-4727-8727-272727272727',1);
 IF result->>'version'<>'2' OR
  (SELECT status FROM public.v2_training_plan_revisions WHERE id=rev)<>'accepted'
 THEN RAISE EXCEPTION 'Corrected candidate schedule was not accepted'; END IF;
 RAISE NOTICE 'PASS ALL-246 candidate calendar-day consistency and timezone integrity';
END $calendar$;
