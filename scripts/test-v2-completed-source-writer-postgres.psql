\set ON_ERROR_STOP on
-- ALL-243 source writer: disposable Postgres 17, no real provider or athlete data.
DO $roles$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN; END IF;
END $roles$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETED-IDENTITY-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SOURCE-WRITER-CANDIDATE.sql
DO $qa$
DECLARE
 a uuid:='11111111-1111-4111-8111-111111111111';
 b uuid:='22222222-2222-4222-8222-222222222222';
 act uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 other_act uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 src uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 res jsonb;
BEGIN
 INSERT INTO auth.users VALUES(a),(b);
 INSERT INTO public.v2_completed_activities
   (id,user_id,sport,activity_kind,athlete_local_date,timezone,capture_kind,status)
 VALUES (act,a,'cycling','workout','2026-11-11','America/Chicago','device_measured','needs_review'),
        (other_act,b,'running','free_activity','2026-11-11','America/Chicago','provider_import','needs_review');
 res:=allin_private.v2_activity_attach_source_candidate(a,act,src,'apple_watch',
   'workout_record','record-1','trusted',repeat('a',64),'2026-11-11 12:00+00');
 IF res->>'replayed'<>'false' THEN RAISE EXCEPTION 'first source did not attach'; END IF;
 res:=allin_private.v2_activity_attach_source_candidate(a,act,src,'apple_watch',
   'workout_record','record-1','trusted',repeat('a',64),'2026-11-11 12:00+00');
 IF res->>'replayed'<>'true' THEN RAISE EXCEPTION 'same source retry not idempotent'; END IF;
 BEGIN
   PERFORM allin_private.v2_activity_attach_source_candidate(a,act,src,'apple_watch',
    'workout_record','record-1','trusted',repeat('b',64),'2026-11-11 12:00+00');
   RAISE EXCEPTION 'same source ID accepted changed hash';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 -- Same external source/revision with different captured event time is
 -- NOT an exact replay, even if the payload fingerprint was reused.
 BEGIN
   PERFORM allin_private.v2_activity_attach_source_candidate(a,act,src,'apple_watch',
    'workout_record','record-1','trusted',repeat('a',64),'2026-11-11 12:01+00');
   RAISE EXCEPTION 'Source replay accepted a changed capture timestamp';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
   PERFORM allin_private.v2_activity_attach_source_candidate(a,act,
    'dddddddd-dddd-4ddd-8ddd-dddddddddddd','apple_watch','workout_record',
    'record-1','trusted',repeat('a',64),'2026-11-11 12:00+00');
   RAISE EXCEPTION 'provider retry generated second source ID';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
   PERFORM allin_private.v2_activity_attach_source_candidate(b,act,
    'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee','apple_watch','workout_record',
    'foreign','trusted',repeat('a',64),'2026-11-11 12:00+00');
   RAISE EXCEPTION 'foreign owner source accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
   PERFORM allin_private.v2_activity_attach_source_candidate(a,other_act,
    'ffffffff-ffff-4fff-8fff-ffffffffffff','apple_watch','workout_record',
    'foreign','trusted',repeat('a',64),'2026-11-11 12:00+00');
   RAISE EXCEPTION 'foreign completed activity accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 -- Provider-local identifiers can repeat for different athletes.
 -- The composite uniqueness boundary must include the verified owner.
 res:=allin_private.v2_activity_attach_source_candidate(b,other_act,
   '31313131-3131-4131-8131-313131313131','apple_watch',
   'workout_record','record-1','trusted',repeat('a',64),'2026-11-11 12:00+00');
 IF res->>'replayed'<>'false'
 OR (SELECT count(*) FROM public.v2_activity_sources
     WHERE user_id=b AND activity_id=other_act
       AND source_record_id='record-1')<>1
 THEN RAISE EXCEPTION 'Second athlete could not own independent provider source'; END IF;
 res:=allin_private.v2_activity_attach_source_candidate(a,act,
   '12121212-1212-4212-8212-121212121212','supported_equipment',
   'device_session','trainer-1','trusted',repeat('c',64),'2026-11-11 12:00+00');
 IF (SELECT count(*) FROM public.v2_activity_sources WHERE activity_id=act)<>2
   OR (SELECT count(*) FROM public.v2_completed_activities WHERE id=act)<>1
 THEN RAISE EXCEPTION 'provider sources created duplicate canonical workout'; END IF;
 IF has_function_privilege('authenticated',
  'allin_private.v2_activity_attach_source_candidate(uuid,uuid,uuid,text,text,text,text,text,timestamptz)','EXECUTE')
 THEN RAISE EXCEPTION 'untrusted client has direct source writer'; END IF;
 RAISE NOTICE 'PASS ALL-243: owner-bound source attach, exact retries and no duplicate activity';
END $qa$;
