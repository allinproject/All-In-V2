\set ON_ERROR_STOP on
-- ALL-243 service handoff disposable PostgreSQL 17 only.
DO $roles$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN; END IF;
END $roles$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETED-IDENTITY-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SESSION-LIFECYCLE-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SOURCE-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETION-ACK-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-ACTIVITY-OUTBOX-WRITER-CANDIDATE.sql
DO $qa$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 foreign_u uuid:='22222222-2222-4222-8222-222222222222';
 sid uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 aid uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 src uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 fp text:=repeat('a',64);
 v jsonb;
BEGIN
 INSERT INTO auth.users VALUES(u),(foreign_u);
 PERFORM allin_private.v2_training_apply_session_candidate(u,sid,
   '00000000-0000-4000-8000-000000000001','start',0,fp,
   '2026-11-11','America/Chicago','2026-11-11 12:00+00');
 -- No canonical activity for unfinished workouts.
 BEGIN
  PERFORM allin_private.v2_training_create_activity_from_outbox_candidate(
    u,sid,aid,'cycling','workout','device_measured',src,
    'supported_equipment','device_session','trainer-1','unverified',fp);
  RAISE EXCEPTION 'Unfinished session spawned a Completed Activity';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 PERFORM allin_private.v2_training_apply_session_candidate(u,sid,
   '00000000-0000-4000-8000-000000000002','finish',1,fp,
   NULL,NULL,'2026-11-11 12:30+00');
 BEGIN
  PERFORM allin_private.v2_training_create_activity_from_outbox_candidate(
    foreign_u,sid,aid,'cycling','workout','device_measured',src,
    'supported_equipment','device_session','trainer-1','unverified',fp);
  RAISE EXCEPTION 'Foreign owner spawned Completed Activity';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 v:=allin_private.v2_training_create_activity_from_outbox_candidate(
    u,sid,aid,'cycling','workout','device_measured',src,
    'supported_equipment','device_session','trainer-1','unverified',fp);
 IF v->>'status'<>'needs_review' OR
   (SELECT status FROM public.v2_completed_activities WHERE id=aid)<>'needs_review'
 THEN RAISE EXCEPTION 'Source was falsely verified'; END IF;
 -- A review-pending activity MUST NOT be acknowledged as delivered.
 BEGIN
   PERFORM allin_private.v2_training_acknowledge_completion_candidate(u,sid,aid);
   RAISE EXCEPTION 'Unverified activity marked delivered';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 v:=allin_private.v2_training_create_activity_from_outbox_candidate(
    u,sid,aid,'cycling','workout','device_measured',src,
    'supported_equipment','device_session','trainer-1','unverified',fp);
 IF v->>'sourceReplay'<>'true' OR
   (SELECT count(*) FROM public.v2_completed_activities
    WHERE training_session_instance_id=sid)<>1 OR
   (SELECT count(*) FROM public.v2_activity_sources
    WHERE activity_id=aid)<>1
 THEN RAISE EXCEPTION 'Retry duplicated activity/source'; END IF;
 BEGIN
  PERFORM allin_private.v2_training_create_activity_from_outbox_candidate(
    u,sid,'dddddddd-dddd-4ddd-8ddd-dddddddddddd','cycling','workout',
    'device_measured',src,'supported_equipment','device_session','trainer-1',
    'unverified',fp);
  RAISE EXCEPTION 'Conflicting completion ID accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 -- Reviewed status is a separate explicitly authorized evidence operation;
 -- the candidate writer itself NEVER promotes it to completed.
 UPDATE public.v2_completed_activities SET status='completed' WHERE id=aid;
 v:=allin_private.v2_training_acknowledge_completion_candidate(u,sid,aid);
 IF v->>'status'<>'delivered' THEN RAISE EXCEPTION 'Review-completed activity not acknowledged'; END IF;
 IF has_function_privilege('authenticated',
  'allin_private.v2_training_create_activity_from_outbox_candidate(uuid,uuid,uuid,text,text,text,uuid,text,text,text,text,text)',
  'EXECUTE') THEN RAISE EXCEPTION 'Client could create unverified completed history'; END IF;
 RAISE NOTICE 'PASS ALL-243 outbox worker: one owner activity, pending review, no premature delivery, idempotency';
END $qa$;
