\set ON_ERROR_STOP on
-- ALL-251 canonical owner state/cancel isolated replay. This SQL restores
-- all test-only GRANTs and rows by transaction rollback.
BEGIN;
GRANT EXECUTE ON FUNCTION public.v2_my_account_deletion_request(uuid) TO authenticated;
GRANT EXECUTE ON FUNCTION public.v2_request_account_deletion(uuid,text) TO authenticated;
GRANT EXECUTE ON FUNCTION public.v2_cancel_account_deletion_request(uuid,uuid) TO authenticated;
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '22222222-2222-4222-8222-222222222222',false);
DO $owner$
DECLARE u uuid:='22222222-2222-4222-8222-222222222222';
 v jsonb;req uuid;
BEGIN
 v:=public.v2_my_account_deletion_request(u);
 IF v->>'status'<>'none' THEN RAISE EXCEPTION 'Unexpected deletion status'; END IF;
 BEGIN
  PERFORM public.v2_request_account_deletion(
    '11111111-1111-4111-8111-111111111111','DELETE MY ACCOUNT');
  RAISE EXCEPTION 'Foreign owner deletion accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_request_account_deletion(u,'DELETE');
  RAISE EXCEPTION 'Deletion missing exact confirmation';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 v:=public.v2_request_account_deletion(u,'DELETE MY ACCOUNT');
 IF v->>'status'<>'requested' THEN RAISE EXCEPTION 'No pending owner request'; END IF;
 req:=(v->>'request_id')::uuid;
 v:=public.v2_request_account_deletion(u,'DELETE MY ACCOUNT');
 IF (v->>'request_id')::uuid IS DISTINCT FROM req
 THEN RAISE EXCEPTION 'Repeated request not idempotent'; END IF;
 BEGIN
  PERFORM public.v2_cancel_account_deletion_request(
   u,'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa');
  RAISE EXCEPTION 'Wrong cancellation request ID accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 v:=public.v2_cancel_account_deletion_request(u,req);
 IF v->>'status'<>'cancelled' THEN RAISE EXCEPTION 'Cancellation failed'; END IF;
 v:=public.v2_cancel_account_deletion_request(u,req);
 IF v->>'status'<>'cancelled' THEN RAISE EXCEPTION 'Repeat cancellation not idempotent'; END IF;
 v:=public.v2_request_account_deletion(u,'DELETE MY ACCOUNT');
 IF v->>'status'<>'requested' OR (v->>'request_id')::uuid=req
 THEN RAISE EXCEPTION 'Reopened deletion request did not rotate identity'; END IF;
 RAISE NOTICE 'PASS ALL-251: authenticated expected owner, confirmation, idempotent request/cancel, unique request rotation';
END $owner$;
RESET ROLE;
ROLLBACK;
DO $closed$
BEGIN
 IF EXISTS(SELECT 1 FROM allin_private.v2_account_deletion_requests
 WHERE user_id='22222222-2222-4222-8222-222222222222') THEN
 RAISE EXCEPTION 'Temporary deletion record survived rollback'; END IF;
 IF pg_catalog.has_function_privilege('anon',
 'public.v2_request_account_deletion(uuid,text)','EXECUTE')
 OR pg_catalog.has_function_privilege('authenticated',
 'public.v2_request_account_deletion(uuid,text)','EXECUTE')
 OR pg_catalog.has_function_privilege('authenticated',
 'public.v2_cancel_account_deletion_request(uuid,uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'Review-only deletion APIs exposed to clients'; END IF;
 RAISE NOTICE 'PASS ALL-251: test role grants and data rollback, client API stays closed';
END $closed$;
