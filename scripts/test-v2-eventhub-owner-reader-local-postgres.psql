\set ON_ERROR_STOP on
-- ALL-244 canonical Event owner-scoped, real Auth session, no public grants.
BEGIN;
DO $events$
DECLARE
 a uuid:='11111111-1111-4111-8111-111111111111';
 b uuid:='22222222-2222-4222-8222-222222222222';
 sa uuid:='33333333-3333-4333-8333-333333333333';
 s2 uuid:='44444444-4444-4444-8444-444444444444';
 e1 uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 e2 uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 e3 uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 g2 uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 result jsonb;
BEGIN
 INSERT INTO auth.users(id) VALUES(a),(b);
 INSERT INTO auth.sessions(id,user_id) VALUES(sa,a),(s2,b);
 IF NOT EXISTS(SELECT 1 FROM public.v2_profiles WHERE user_id=a)
 THEN RAISE EXCEPTION 'Auth trigger failed to create owner profile'; END IF;
 INSERT INTO public.v2_events(id,edition_id,name,sport,event_kind,
   source_verification,start_local_date,event_timezone)
 VALUES(e1,'10000000-0000-4000-8000-000000000001','Trail 50','running','ultra','organizer_verified',
       DATE '2027-04-10','America/Chicago'),
       (e2,'10000000-0000-4000-8000-000000000002','Cycling Classic','cycling','road','organizer_verified',
       DATE '2027-05-21','America/Chicago'),
       (e3,'10000000-0000-4000-8000-000000000003','Other Athlete Race','running','race','organizer_verified',
       DATE '2027-06-01','America/Chicago');
 INSERT INTO public.v2_event_groups(id,event_id,state)
 VALUES(g2,e2,'active');
 INSERT INTO public.v2_event_group_memberships(
   user_id,event_id,group_id,state,joined_at,participant_visible)
 VALUES(a,e2,g2,'joined',now(),false);
 INSERT INTO public.v2_event_participations(
   user_id,event_id,state,source_kind)
 VALUES(a,e1,'interested','athlete_confirmed'),
       (b,e3,'registered','athlete_confirmed');
 PERFORM pg_catalog.set_config('request.jwt.claim.sub',a::text,true);
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id',sa::text,true);
 result:=allin_private.v2_event_plan_owner_evidence_candidate(a);
 IF result->>'ownerId'<>a::text
   OR result->>'complete'<>'true'
   OR pg_catalog.jsonb_array_length(result->'events')<>1
 THEN RAISE EXCEPTION 'Event owner read returned partial or foreign events: %',result; END IF;
 IF NOT EXISTS(
  SELECT 1 FROM pg_catalog.jsonb_array_elements(result->'events') AS row(value)
  WHERE row.value->>'eventId'=e1::text
    AND row.value->>'participation'='interested'
    AND row.value->>'participationSource'='athlete_confirmed'
    AND row.value->>'verification'='organizer_verified'
 ) THEN RAISE EXCEPTION 'Canonical athlete interested Event missing from owner evidence'; END IF;
 IF EXISTS(
  SELECT 1 FROM pg_catalog.jsonb_array_elements(result->'events') AS row(value)
  WHERE row.value->>'eventId'=e2::text
    OR row.value->>'eventId'=e3::text
 ) THEN RAISE EXCEPTION 'EventHub group membership or foreign race leaked into plan'; END IF;
 BEGIN
  PERFORM allin_private.v2_event_plan_owner_evidence_candidate(b);
  RAISE EXCEPTION 'Foreign EventHub owner read succeeded';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM allin_private.v2_event_plan_owner_evidence_candidate(a,0);
  RAISE EXCEPTION 'Unbounded/zero EventHub owner read permitted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id',s2::text,true);
 BEGIN
  PERFORM allin_private.v2_event_plan_owner_evidence_candidate(a);
  RAISE EXCEPTION 'Foreign signed-in session used';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id',sa::text,true);
 DELETE FROM auth.sessions WHERE id=sa;
 BEGIN
  PERFORM allin_private.v2_event_plan_owner_evidence_candidate(a);
  RAISE EXCEPTION 'Revoked session used for EventHub reader';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 IF pg_catalog.to_regprocedure(
   'public.v2_event_plan_owner_evidence_candidate(uuid,integer)') IS NOT NULL
   OR has_function_privilege('authenticated',
    'allin_private.v2_event_plan_owner_evidence_candidate(uuid,integer)','EXECUTE')
   OR has_function_privilege('service_role',
    'allin_private.v2_event_plan_owner_evidence_candidate(uuid,integer)','EXECUTE')
 THEN RAISE EXCEPTION 'Unapproved EventHub owner reader permission leaked'; END IF;
 RAISE NOTICE 'PASS ALL-244: private event-plan owner read excludes mere group join and foreign accounts';
END $events$;
ROLLBACK;
