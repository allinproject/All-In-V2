\set ON_ERROR_STOP on
-- ALL-251 guarded upgrade acceptance on disposable Postgres 17.
-- No publicly executable export; preserve session identity and deletion state.
DO $qa$
DECLARE v jsonb; a uuid:='11111111-1111-4111-8111-111111111111';
 sa uuid:='10101010-1010-4010-8010-101010101010';
 b uuid:='22222222-2222-4222-8222-222222222222';
 sb uuid:='20202020-2020-4020-8020-202020202020';
BEGIN
 v:=allin_private.v2_account_export_authorize_session_candidate(a,sa);
 IF v->>'ownerId'<>a::text OR v->>'activeSession'<>'true'
  OR v->>'completeUserExport'<>'false'
 THEN RAISE EXCEPTION 'Valid private export session contract changed'; END IF;
 BEGIN
  PERFORM allin_private.v2_account_export_authorize_session_candidate(a,sb);
  RAISE EXCEPTION 'Foreign session accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE auth.sessions SET not_after=clock_timestamp()-interval '1 minute' WHERE id=sa;
 BEGIN
  PERFORM allin_private.v2_account_export_authorize_session_candidate(a,sa);
  RAISE EXCEPTION 'Expired auth session accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE auth.sessions SET not_after=clock_timestamp()+interval '1 hour' WHERE id=sa;
 INSERT INTO allin_private.v2_account_deletion_requests(user_id,status)
 VALUES(a,'requested');
 BEGIN
  PERFORM allin_private.v2_account_export_authorize_session_candidate(a,sa);
  RAISE EXCEPTION 'Pending deletion permitted export';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE allin_private.v2_account_deletion_requests SET status='cancelled' WHERE user_id=a;
 v:=allin_private.v2_account_export_authorize_session_candidate(a,sa);
 IF v->>'completeUserExport'<>'false' THEN
  RAISE EXCEPTION 'Incomplete account export incorrectly promoted'; END IF;
 INSERT INTO allin_private.v2_privileged_storage_write_leases_review(lease_id,owner_id)
 VALUES('33333333-3333-4333-8333-333333333333',a);
 BEGIN
  UPDATE allin_private.v2_account_deletion_requests SET status='processing'
  WHERE user_id=a;
  RAISE EXCEPTION 'Open privileged Storage lease did not fence deletion';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 IF (SELECT status FROM allin_private.v2_account_deletion_requests WHERE user_id=a)
  <>'cancelled' THEN RAISE EXCEPTION 'Deletion state changed despite open lease'; END IF;
 IF pg_catalog.has_function_privilege('authenticated',
   'allin_private.v2_account_export_authorize_session_candidate(uuid,uuid)','EXECUTE')
 OR pg_catalog.has_function_privilege('anon',
   'allin_private.v2_account_export_authorize_session_candidate(uuid,uuid)','EXECUTE')
 OR pg_catalog.has_function_privilege('service_role',
   'allin_private.v2_account_export_authorize_session_candidate(uuid,uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'Private export gate accidentally exposed'; END IF;
 DELETE FROM auth.sessions WHERE id=sa;
 BEGIN
  PERFORM allin_private.v2_account_export_authorize_session_candidate(a,sa);
  RAISE EXCEPTION 'Revoked Auth session accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-251: real prior-function guard upgraded without broad grants; valid/foreign/expired/revoked sessions; deletion and Storage lease denial';
END $qa$;
