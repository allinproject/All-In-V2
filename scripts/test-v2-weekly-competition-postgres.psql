\set ON_ERROR_STOP on
-- ALL-253: disposable PostgreSQL 17 replay only, NEVER pointed at Supabase.
CREATE ROLE anon NOLOGIN;
CREATE ROLE authenticated NOLOGIN;
CREATE ROLE service_role NOLOGIN;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
CREATE TABLE public.v2_completed_activities(
 id uuid PRIMARY KEY,
 user_id uuid NOT NULL REFERENCES auth.users(id),
 UNIQUE (id,user_id)
);
\i /tmp/allin/docs/architecture/sql/V2-INDOOR-WEEKLY-COMPETITION-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-INDOOR-WEEKLY-SCORE-V1-CANDIDATE.sql

DO $qa$
DECLARE
 rider_a uuid:='11111111-1111-4111-8111-111111111111';
 rider_b uuid:='22222222-2222-4222-8222-222222222222';
 activity_a uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 challenge_id uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 attempt_id uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 failure_state text;
BEGIN
 INSERT INTO auth.users(id) VALUES(rider_a),(rider_b);
 INSERT INTO public.v2_completed_activities(id,user_id) VALUES(activity_a,rider_a);
 INSERT INTO public.v2_indoor_weekly_challenges(
  id,week_start,state,rules_version,generator_version,
  scoring_version,prescription_version,common_structure_id,
  workout_definition,scored_effort_definition,opens_at,closes_at
 ) VALUES (
  challenge_id,'2026-11-09','draft','rules-v1','generator-v1',
  'challenge-score-v1','prescription-v1','shared-template',
  '{"segments":[]}'::jsonb,'{"kind":"scored_effort"}'::jsonb,
  '2026-11-09 09:00:00+00','2026-11-16 09:00:00+00'
 );
 -- Private SQL scoring exactly preserves V1 components and caps.
 IF allin_private.v2_indoor_weekly_score_breakdown_v1(1,1,1)->>'score' <> '75.000'
   THEN RAISE EXCEPTION 'V1 scoring 75 point fixture mismatch'; END IF;
 IF allin_private.v2_indoor_weekly_score_breakdown_v1(1,1,2.5)->>'score' <> '100.000'
   THEN RAISE EXCEPTION 'V1 scored effort cap mismatch'; END IF;
 IF allin_private.v2_indoor_weekly_score_breakdown_v1(NULL,NULL,NULL)->>'score' <> '0.000'
   THEN RAISE EXCEPTION 'V1 missing evidence parity mismatch'; END IF;
 IF has_function_privilege('anon','allin_private.v2_indoor_weekly_score_breakdown_v1(numeric,numeric,numeric)','EXECUTE')
    OR has_function_privilege('authenticated','allin_private.v2_indoor_weekly_score_breakdown_v1(numeric,numeric,numeric)','EXECUTE')
   THEN RAISE EXCEPTION 'Untrusted client can execute private scoring'; END IF;
 -- No second challenge for the same week.
 BEGIN
  INSERT INTO public.v2_indoor_weekly_challenges(
   id,week_start,rules_version,generator_version,scoring_version,
   prescription_version,common_structure_id,workout_definition,
   scored_effort_definition,opens_at,closes_at
  ) VALUES (
   'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee','2026-11-09',
   'r','g','challenge-score-v1','p','s','{}','{}',
   '2026-11-09 09:00:00+00','2026-11-16 09:00:00+00'
  );
  RAISE EXCEPTION 'Duplicate Monday week was accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 -- Cannot create a challenge for non-Monday.
 BEGIN
  UPDATE public.v2_indoor_weekly_challenges SET week_start='2026-11-10' WHERE id=challenge_id;
  RAISE EXCEPTION 'Tuesday week start was accepted';
 EXCEPTION WHEN check_violation THEN NULL; END;
 -- Same-owner completed record must be present, irrespective of copied UUID.
 BEGIN
  INSERT INTO public.v2_indoor_weekly_attempts(
   id,challenge_id,user_id,completed_activity_id,
   frozen_prescription_version,frozen_prescription,frozen_baseline
  ) VALUES (
   'ffffffff-ffff-4fff-8fff-ffffffffffff',challenge_id,rider_b,
   activity_a,'v1','{}','{}'
  );
  RAISE EXCEPTION 'Cross-owner activity claim accepted';
 EXCEPTION WHEN foreign_key_violation THEN NULL; END;
 INSERT INTO public.v2_indoor_weekly_attempts(
  id,challenge_id,user_id,completed_activity_id,
  frozen_prescription_version,frozen_prescription,frozen_baseline
 ) VALUES (
  attempt_id,challenge_id,rider_a,activity_a,'v1','{}','{}'
 );
 -- Retry with same canonical activity must not make a second attempt.
 BEGIN
  INSERT INTO public.v2_indoor_weekly_attempts(
   id,challenge_id,user_id,completed_activity_id,
   frozen_prescription_version,frozen_prescription,frozen_baseline
  ) VALUES (
   'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',
   challenge_id,rider_a,activity_a,'v1','{}','{}'
  );
  RAISE EXCEPTION 'Duplicate activity attempt accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 -- Cannot mark pending power as verified without trusted score and timestamps.
 BEGIN
  UPDATE public.v2_indoor_weekly_attempts SET verification_state='verified' WHERE id=attempt_id;
  RAISE EXCEPTION 'Verified attempt without scored evidence accepted';
 EXCEPTION WHEN check_violation THEN NULL; END;
 -- Ranking rows cannot link another athlete's attempt.
 BEGIN
  INSERT INTO public.v2_indoor_weekly_leaderboard(
   challenge_id,user_id,best_attempt_id,best_score
  ) VALUES (challenge_id,rider_b,attempt_id,60);
  RAISE EXCEPTION 'Cross-owner leaderboard attempt accepted';
 EXCEPTION WHEN foreign_key_violation THEN NULL; END;
 -- These flags are intentionally impossible to enable without an approved migration.
 BEGIN
  UPDATE allin_private.v2_indoor_weekly_config SET publication_enabled=true;
  RAISE EXCEPTION 'Competition publication was activated';
 EXCEPTION WHEN check_violation THEN NULL; END;
 IF EXISTS (
  SELECT 1 FROM pg_tables
  WHERE schemaname='public'
    AND tablename IN ('v2_indoor_weekly_challenges',
     'v2_indoor_weekly_attempts','v2_indoor_weekly_leaderboard',
     'v2_indoor_weekly_achievements') AND rowsecurity IS NOT TRUE
 ) THEN RAISE EXCEPTION 'Competition RLS missing'; END IF;
 IF EXISTS (
  SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
  WHERE n.nspname='public' AND c.relname LIKE 'v2_indoor_weekly_%'
  AND (has_table_privilege('anon',c.oid,'SELECT')
    OR has_table_privilege('authenticated',c.oid,'INSERT')
    OR has_table_privilege('authenticated',c.oid,'UPDATE'))
 ) THEN RAISE EXCEPTION 'Client privileges leaked'; END IF;
 RAISE NOTICE 'PASS ALL-253 isolated SQL: one week, same-owner activity, dedup, score gate, privacy, activation disabled';
END
$qa$;
