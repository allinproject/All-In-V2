\set ON_ERROR_STOP on
-- ALL-251: real canonical inventory + paginated Food/Hydration on populated
-- representative disposable V2 owner graph. NO mock inventory; rollback only.
BEGIN ISOLATION LEVEL REPEATABLE READ;
\ir ALL-247-food-log-first-writer.review.sql
\ir ALL-247-food-log-lifecycle.review.sql
\ir ALL-247-hydration-manual-lifecycle.review.sql
INSERT INTO auth.users(id) VALUES
 ('f1111111-1111-4111-8111-111111111111'),
 ('f2222222-2222-4222-8222-222222222222');
INSERT INTO auth.sessions(id,user_id) VALUES
 ('f3333333-3333-4333-8333-333333333333','f1111111-1111-4111-8111-111111111111'),
 ('f4444444-4444-4444-8444-444444444444','f2222222-2222-4222-8222-222222222222');
INSERT INTO allin_private.v2_account_export_requests_candidate
 (request_id,user_id,session_id,status,expires_at) VALUES
 ('f5555555-5555-4555-8555-555555555555','f1111111-1111-4111-8111-111111111111',
  'f3333333-3333-4333-8333-333333333333','approved',now()+interval '1 hour'),
 ('f6666666-6666-4666-8666-666666666666','f2222222-2222-4222-8222-222222222222',
  'f4444444-4444-4444-8444-444444444444','approved',now()+interval '1 hour');
INSERT INTO public.v2_food_log_entries
 (id,user_id,consumed_at,local_date,timezone_name,meal_slot,label,
  quantity,unit,kcal,nutrition_source,revision,deleted_at)
SELECT ('f7777777-7777-4777-8777-'||lpad(i::text,12,'0'))::uuid,
 'f1111111-1111-4111-8111-111111111111'::uuid,
 '2026-11-12 12:00:00+00'::timestamptz + i*interval '1 minute',
 '2026-11-12','America/Chicago','snack','Owner A snack '||i,
 1,'each',CASE WHEN i=1 THEN NULL WHEN i=2 THEN 0 ELSE 120 END,
 CASE WHEN i=1 THEN 'unknown' ELSE 'user_entered' END,
 CASE WHEN i=4 THEN 2 ELSE 1 END,
 CASE WHEN i=4 THEN now() ELSE NULL END
FROM generate_series(1,27) i;
INSERT INTO public.v2_food_log_entries
 (id,user_id,consumed_at,local_date,timezone_name,meal_slot,label,
  quantity,unit,kcal,nutrition_source)
VALUES ('f8888888-8888-4888-8888-888888888888',
 'f2222222-2222-4222-8222-222222222222',
 '2026-11-12 16:00+00','2026-11-12','America/Chicago',
 'snack','OWNER_B_PRIVATE_FOOD',1,'each',300,'user_entered');
INSERT INTO public.v2_hydration_events
 (id,user_id,occurred_at,local_date,timezone_name,event_kind,original_volume,
  original_unit,volume_ml,revision,deleted_at)
VALUES
 ('f9999999-9999-4999-8999-999999999999','f1111111-1111-4111-8111-111111111111',
  '2026-11-12 17:00+00','2026-11-12','America/Chicago','refill',500,'ml',500,1,NULL),
 ('faaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','f1111111-1111-4111-8111-111111111111',
  '2026-11-12 18:00+00','2026-11-12','America/Chicago','drink',250,'ml',250,2,now()),
 ('fbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','f2222222-2222-4222-8222-222222222222',
  '2026-11-12 19:00+00','2026-11-12','America/Chicago','drink',450,'ml',450,1,NULL);
INSERT INTO allin_private.v2_food_log_write_actions
 (user_id,action_id,request_fingerprint,result_id,result_revision)
VALUES('f1111111-1111-4111-8111-111111111111',
 'fccccccc-cccc-4ccc-8ccc-cccccccccccc','PRIVATE_REPLAY_FINGERPRINT',
 'f7777777-7777-4777-8777-000000000004',2);
INSERT INTO allin_private.v2_hydration_actions
 (user_id,action_id,request_fingerprint,result_id,result_revision)
VALUES('f1111111-1111-4111-8111-111111111111',
 'fddddddd-dddd-4ddd-8ddd-dddddddddddd','PRIVATE_HYDRATION_FINGERPRINT',
 'faaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',2);

SET LOCAL ROLE service_role;
DO $accept$
DECLARE
 a uuid:='f1111111-1111-4111-8111-111111111111';
 b uuid:='f2222222-2222-4222-8222-222222222222';
 sa uuid:='f3333333-3333-4333-8333-333333333333';
 sb uuid:='f4444444-4444-4444-8444-444444444444';
 ra uuid:='f5555555-5555-4555-8555-555555555555';
 rb uuid:='f6666666-6666-4666-8666-666666666666';
 inventory jsonb; page1 jsonb; page2 jsonb; water jsonb; food_actions jsonb;
 hydration_actions jsonb; all_food jsonb;
BEGIN
 inventory:=public.v2_account_export_inventory_review_candidate(a,sa,ra);
 IF inventory->>'complete'<>'false'
    OR (inventory->>'ownerTableCount')::integer<>47
    OR NOT (inventory->'collections' ?& ARRAY[
      'public.v2_food_log_entries','public.v2_hydration_events',
      'allin_private.v2_food_log_write_actions','allin_private.v2_hydration_actions'])
 THEN RAISE EXCEPTION 'Canonical 43+4 Fuel inventory not connected: %',inventory; END IF;
 page1:=public.v2_account_export_page_review_candidate(a,sa,ra,
    'public.v2_food_log_entries',NULL,25);
 page2:=public.v2_account_export_page_review_candidate(a,sa,ra,
    'public.v2_food_log_entries',page1->>'nextCursor',25);
 IF pg_catalog.jsonb_array_length(page1->'rows')<>25
    OR pg_catalog.jsonb_array_length(page2->'rows')<>2
    OR page1->>'done'<>'false' OR page2->>'done'<>'true'
    OR page1->>'completeUserExport'<>'false'
 THEN RAISE EXCEPTION 'Canonical Food pagination not complete'; END IF;
 all_food:=(page1->'rows')||(page2->'rows');
 IF (SELECT count(*) FROM pg_catalog.jsonb_array_elements(all_food) x
        WHERE x->>'user_id'=a::text)<>27
    OR all_food::text LIKE '%OWNER_B_PRIVATE_FOOD%'
    OR NOT EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(all_food) x
        WHERE x->>'deleted_at' IS NOT NULL AND x->>'revision'='2')
    OR NOT EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(all_food) x
        WHERE x->>'nutrition_source'='unknown' AND x->>'kcal' IS NULL)
    OR NOT EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(all_food) x
        WHERE x->>'nutrition_source'='user_entered' AND (x->>'kcal')::numeric=0)
 THEN RAISE EXCEPTION 'Canonical Food ownership/tombstones/unknown-zero failed'; END IF;
 water:=public.v2_account_export_page_review_candidate(a,sa,ra,
    'public.v2_hydration_events',NULL,25);
 IF pg_catalog.jsonb_array_length(water->'rows')<>2
    OR NOT EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(water->'rows') x
       WHERE x->>'event_kind'='refill')
    OR NOT EXISTS(SELECT 1 FROM pg_catalog.jsonb_array_elements(water->'rows') x
       WHERE x->>'event_kind'='drink' AND x->>'deleted_at' IS NOT NULL)
 THEN RAISE EXCEPTION 'Hydration refill/drink/tombstone lost'; END IF;
 food_actions:=public.v2_account_export_page_review_candidate(a,sa,ra,
    'allin_private.v2_food_log_write_actions',NULL,25);
 hydration_actions:=public.v2_account_export_page_review_candidate(a,sa,ra,
    'allin_private.v2_hydration_actions',NULL,25);
 IF pg_catalog.jsonb_array_length(food_actions->'rows')<>1
    OR pg_catalog.jsonb_array_length(hydration_actions->'rows')<>1
    OR (food_actions::text||hydration_actions::text) LIKE '%FINGERPRINT%'
    OR (food_actions::text||hydration_actions::text) LIKE '%request_fingerprint%'
 THEN RAISE EXCEPTION 'Private Fuel replay details leaked into export'; END IF;
 BEGIN
   PERFORM public.v2_account_export_page_review_candidate(b,sb,rb,
     'public.v2_food_log_entries',NULL,25);
 EXCEPTION WHEN OTHERS THEN RAISE; END;
 BEGIN
   PERFORM public.v2_account_export_page_review_candidate(a,sb,rb,
     'public.v2_food_log_entries',NULL,25);
   RAISE EXCEPTION 'Foreign session authorized A data';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-251 populated canonical 47-owner-table graph: Food 27 + Hydration 2 + redacted owner actions, A/B isolation, complete=false';
END $accept$;
RESET ROLE;
-- Invalid RLS must revoke the entire Fuels graph, even if owner rows exist.
ALTER TABLE public.v2_hydration_events DISABLE ROW LEVEL SECURITY;
SET LOCAL ROLE service_role;
DO $rls$
BEGIN
 BEGIN
  PERFORM public.v2_account_export_inventory_review_candidate(
    'f1111111-1111-4111-8111-111111111111',
    'f3333333-3333-4333-8333-333333333333',
    'f5555555-5555-4555-8555-555555555555');
  RAISE EXCEPTION 'Missing Fuel RLS incorrectly accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-251 Fuel inventory refuses disabled owner RLS';
END $rls$;
RESET ROLE;
ROLLBACK;
