\set ON_ERROR_STOP on
-- Execute after real owner/source/Auth fixtures and operator candidate.
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-DEVICE-PAIRING-WRITER-CANDIDATE.sql
DO $permissions$
BEGIN
 IF has_table_privilege('authenticated','allin_private.v2_device_registrations_candidate','INSERT')
 OR has_table_privilege('authenticated','allin_private.v2_device_pairing_challenges_candidate','INSERT')
 OR has_function_privilege('authenticated',
 'allin_private.v2_device_pair_verified_candidate(uuid,uuid,uuid,uuid,text,text,text,text,uuid)','EXECUTE')
 OR has_function_privilege('allin_v2_ingest_operator',
 'allin_private.v2_device_pair_verified_candidate(uuid,uuid,uuid,uuid,text,text,text,text,uuid)','EXECUTE')
 OR has_table_privilege('allin_v2_ingest_operator',
 'allin_private.v2_device_registrations_candidate','UPDATE') THEN
  RAISE EXCEPTION 'Client or ingest operator could certify device';
 END IF;
 IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='allin_v2_device_registrar'
   AND (rolsuper OR rolbypassrls OR rolinherit)) THEN
  RAISE EXCEPTION 'Registrar is privileged';
 END IF;
END $permissions$;
-- Server-issued challenge (fixture simulates prior Auth verification).
SET ROLE allin_v2_device_registrar;
SET request.jwt.claim.sub='11111111-1111-4111-8111-111111111111';
INSERT INTO allin_private.v2_device_pairing_challenges_candidate
(id,owner_id,session_id,device_ref,provider,expires_at)
VALUES('aaaaaaaa-1111-4111-8111-111111111111',
'11111111-1111-4111-8111-111111111111',
'11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
'new-watch-001','apple_watch',now()+interval '5 minutes');
DO $pair$
DECLARE answer text;
BEGIN
 -- A foreign owner cannot hijack a challenge.
 BEGIN
  PERFORM allin_private.v2_device_pair_verified_candidate(
   'aaaaaaaa-1111-4111-8111-111111111111',
   'aaaaaaaa-2222-4222-8222-222222222222',
   '22222222-2222-4222-8222-222222222222',
   '11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
   'new-watch-001','apple_watch','native_owner_verified',repeat('a',64),
   'aaaaaaaa-3333-4333-8333-333333333333');
  RAISE EXCEPTION 'Foreign owner paired device';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 -- Incorrect device identity is denied and does not consume challenge.
 BEGIN
  PERFORM allin_private.v2_device_pair_verified_candidate(
   'aaaaaaaa-1111-4111-8111-111111111111',
   'aaaaaaaa-2222-4222-8222-222222222222',
   '11111111-1111-4111-8111-111111111111',
   '11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
   'forged-watch','apple_watch','native_owner_verified',repeat('a',64),
   'aaaaaaaa-3333-4333-8333-333333333333');
  RAISE EXCEPTION 'Forged device passed challenge';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 answer:=allin_private.v2_device_pair_verified_candidate(
  'aaaaaaaa-1111-4111-8111-111111111111',
  'aaaaaaaa-2222-4222-8222-222222222222',
  '11111111-1111-4111-8111-111111111111',
  '11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
  'new-watch-001','apple_watch','native_owner_verified',repeat('a',64),
  'aaaaaaaa-3333-4333-8333-333333333333');
 IF answer<>'paired' THEN RAISE EXCEPTION 'Pair failed'; END IF;
 BEGIN
  PERFORM allin_private.v2_device_pair_verified_candidate(
   'aaaaaaaa-1111-4111-8111-111111111111',
   'aaaaaaaa-4444-4444-8444-444444444444',
   '11111111-1111-4111-8111-111111111111',
   '11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
   'new-watch-001','apple_watch','native_owner_verified',repeat('a',64),
   'aaaaaaaa-5555-4555-8555-555555555555');
  RAISE EXCEPTION 'Replay accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 IF (SELECT count(*) FROM allin_private.v2_device_registrations_candidate
  WHERE device_ref='new-watch-001' AND revoked_at IS NULL)<>1 THEN
  RAISE EXCEPTION 'Paired registration missing'; END IF;
 RAISE NOTICE 'PASS ALL-243 server-only pairing and challenge one-time-use';
END $pair$;
DO $revoke$
DECLARE answer text;
BEGIN
 -- Another athlete role cannot revoke the current owner's watch.
 BEGIN
  PERFORM allin_private.v2_device_revoke_candidate(
   'aaaaaaaa-2222-4222-8222-222222222222',
   '22222222-2222-4222-8222-222222222222',
   '11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
   'aaaaaaaa-6666-4666-8666-666666666666');
  RAISE EXCEPTION 'Cross-owner revocation succeeded';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 answer:=allin_private.v2_device_revoke_candidate(
  'aaaaaaaa-2222-4222-8222-222222222222',
  '11111111-1111-4111-8111-111111111111',
  '11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
  'aaaaaaaa-7777-4777-8777-777777777777');
 IF answer<>'revoked' THEN RAISE EXCEPTION 'Revocation failed'; END IF;
 answer:=allin_private.v2_device_revoke_candidate(
  'aaaaaaaa-2222-4222-8222-222222222222',
  '11111111-1111-4111-8111-111111111111',
  '11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
  'aaaaaaaa-8888-4888-8888-888888888888');
 IF answer<>'already_revoked' THEN RAISE EXCEPTION 'Revocation replay mismatch'; END IF;
 IF EXISTS(SELECT 1 FROM allin_private.v2_device_registrations_candidate
  WHERE device_ref='new-watch-001' AND revoked_at IS NULL) THEN
  RAISE EXCEPTION 'Revocation mismatch'; END IF;
 RAISE NOTICE 'PASS ALL-243 revoke, audit, idempotence and cross-owner denial';
END $revoke$;
-- Even the restricted registrar cannot rewrite a consumed challenge or
-- make a revoked device active again; neither has a client-accessible path.
DO $immutability$
BEGIN
 BEGIN
  UPDATE allin_private.v2_device_pairing_challenges_candidate
   SET consumed_at=NULL WHERE id='aaaaaaaa-1111-4111-8111-111111111111';
  RAISE EXCEPTION 'Consumed challenge could be reopened';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  UPDATE allin_private.v2_device_registrations_candidate SET revoked_at=NULL
   WHERE id='aaaaaaaa-2222-4222-8222-222222222222';
  RAISE EXCEPTION 'Certified device could be un-revoked';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-243 immutable consumed challenge and device revocation';
END $immutability$;
RESET ROLE;
DO $privileged_audit$
BEGIN
 IF (SELECT count(*) FROM allin_private.v2_device_pairing_audit_candidate
  WHERE event_type='paired')<>1 OR
 (SELECT count(*) FROM allin_private.v2_device_pairing_audit_candidate
  WHERE event_type='revoked')<>1 THEN
  RAISE EXCEPTION 'Trusted pairing audit is incomplete';
 END IF;
 RAISE NOTICE 'PASS ALL-243 append-only server pairing audit';
END $privileged_audit$;
\echo 'PASS ALL-243 device pairing, revocation, client denial and audit'
