\set ON_ERROR_STOP on
-- Synthetic existing ALL-251 staging owner, no hosted user data.
CREATE ROLE anon NOLOGIN;
CREATE ROLE authenticated NOLOGIN;
CREATE ROLE service_role NOLOGIN;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
CREATE TABLE auth.sessions(id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id),not_after timestamptz);
CREATE TABLE allin_private.v2_account_deletion_requests(
 user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
 status text NOT NULL CHECK(status IN ('requested','processing','completed','rejected','cancelled')));
CREATE TABLE allin_private.v2_account_export_requests_candidate(
 request_id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id),
 session_id uuid NOT NULL REFERENCES auth.sessions(id),
 status text NOT NULL,expires_at timestamptz NOT NULL);
CREATE TABLE allin_private.v2_privileged_storage_write_leases_review(
 lease_id uuid PRIMARY KEY,owner_id uuid NOT NULL REFERENCES auth.users(id),
 settled_at timestamptz);
CREATE FUNCTION allin_private.v2_deny_deletion_with_open_storage_leases_review()
 RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=''
 AS $body$
 BEGIN
  IF NEW.status IN ('requested','processing') AND EXISTS(
   SELECT 1 FROM allin_private.v2_privileged_storage_write_leases_review
   WHERE owner_id=NEW.user_id AND settled_at IS NULL
  ) THEN RAISE EXCEPTION 'Open Storage lease forbids deletion' USING ERRCODE='42501'; END IF;
  RETURN NEW;
 END $body$;
CREATE TRIGGER v2_privileged_storage_write_fence_review
 BEFORE INSERT OR UPDATE ON allin_private.v2_account_deletion_requests
 FOR EACH ROW EXECUTE FUNCTION allin_private.v2_deny_deletion_with_open_storage_leases_review();

CREATE OR REPLACE FUNCTION allin_private.v2_account_export_authorize_session_candidate(p_user_id uuid, p_session_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  v_deletion text;
BEGIN
 IF p_user_id IS NULL OR p_session_id IS NULL THEN
   RAISE EXCEPTION 'Export requires exact account and session' USING ERRCODE='22023';
 END IF;
 IF NOT EXISTS(
   SELECT 1 FROM auth.users u WHERE u.id=p_user_id
 ) THEN
   RAISE EXCEPTION 'Export account no longer exists' USING ERRCODE='42501';
 END IF;
 IF NOT EXISTS(
   SELECT 1 FROM auth.sessions s
   WHERE s.id=p_session_id AND s.user_id=p_user_id
 ) THEN
   RAISE EXCEPTION 'Export session missing or revoked' USING ERRCODE='42501';
 END IF;
 IF pg_catalog.to_regclass('allin_private.v2_account_deletion_requests') IS NULL THEN
  RAISE EXCEPTION 'Owning deletion-state gate not installed' USING ERRCODE='42501';
 END IF;
 SELECT status INTO v_deletion
 FROM allin_private.v2_account_deletion_requests
 WHERE user_id=p_user_id;
 -- A pending deletion request should not permit a new private archive until
 -- explicitly cancelled. The export and deletion features must reconcile
 -- their legal requirements in ALL-251 before enabling this gate.
 IF v_deletion IS NOT NULL AND v_deletion<>'cancelled' THEN
   RAISE EXCEPTION 'Deletion state blocks private export' USING ERRCODE='42501';
 END IF;
 RETURN pg_catalog.jsonb_build_object(
   'ownerId',p_user_id,'sessionId',p_session_id,
   'activeSession',true,'exportPermitted',true,
   'completeUserExport',false
 );
END;
$function$;


REVOKE ALL ON FUNCTION allin_private.v2_account_export_authorize_session_candidate(uuid,uuid)
 FROM PUBLIC,anon,authenticated,service_role;
INSERT INTO auth.users VALUES
 ('11111111-1111-4111-8111-111111111111'),
 ('22222222-2222-4222-8222-222222222222');
INSERT INTO auth.sessions VALUES
 ('10101010-1010-4010-8010-101010101010',
  '11111111-1111-4111-8111-111111111111',now()+interval '1 hour'),
 ('20202020-2020-4020-8020-202020202020',
  '22222222-2222-4222-8222-222222222222',now()+interval '1 hour');

-- Other owner domains already installed in shared staging.
CREATE TABLE public.v2_coach_threads(
 id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE);
CREATE TABLE public.v2_ingredients(id uuid PRIMARY KEY);
ALTER TABLE public.v2_coach_threads ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.v2_ingredients ENABLE ROW LEVEL SECURITY;
-- Concurrent newer ALL-251 Auth-user deletion fence, preserve unchanged.
CREATE FUNCTION allin_private.v2_deny_auth_delete_with_open_storage_leases_review()
 RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=''
 AS $body$
 BEGIN
  IF EXISTS(SELECT 1 FROM allin_private.v2_privileged_storage_write_leases_review
   WHERE owner_id=OLD.id AND settled_at IS NULL)
  THEN RAISE EXCEPTION 'Open Storage lease forbids Auth deletion'
   USING ERRCODE='42501'; END IF;
  RETURN OLD;
 END $body$;
CREATE TRIGGER v2_privileged_storage_auth_delete_fence_review
 BEFORE DELETE ON auth.users FOR EACH ROW
 EXECUTE FUNCTION allin_private.v2_deny_auth_delete_with_open_storage_leases_review();
