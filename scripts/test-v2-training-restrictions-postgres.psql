\set ON_ERROR_STOP on
DO $guard$ BEGIN
 IF current_database()<>'allin_coach_restrictions_test' THEN
  RAISE EXCEPTION 'Refusing restriction test outside disposable database'; END IF;
END $guard$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
DO $roles$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN BYPASSRLS; END IF;
END $roles$;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
CREATE TABLE auth.sessions(id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,not_after timestamptz);
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE SQL STABLE AS $uid$
 SELECT nullif(pg_catalog.current_setting('request.jwt.claim.sub',true),'')::uuid
$uid$;
CREATE TABLE public.v2_profiles(user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE);
\ir ../docs/architecture/sql/V2-TRAINING-ATHLETE-RESTRICTIONS-OWNER-REVIEW-CANDIDATE.sql
\ir ../docs/architecture/sql/V2-TRAINING-RESTRICTION-WRITER-REVIEW-CANDIDATE.sql
INSERT INTO auth.users(id) VALUES
 ('aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'),
 ('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb');
INSERT INTO auth.sessions(id,user_id) VALUES
 ('cccccccc-cccc-4ccc-8ccc-cccccccccccc','aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'),
 ('dddddddd-dddd-4ddd-8ddd-dddddddddddd','bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb');
INSERT INTO public.v2_profiles(user_id)
 SELECT id FROM auth.users;
DO $acl$ BEGIN
 IF has_function_privilege('authenticated',
  'public.v2_training_restriction_write_candidate(uuid,uuid,text,uuid,text,text,bigint)','EXECUTE')
 OR has_function_privilege('anon',
  'public.v2_training_restriction_write_candidate(uuid,uuid,text,uuid,text,text,bigint)','EXECUTE') THEN
  RAISE EXCEPTION 'Unreviewed restriction writer is exposed to clients'; END IF;
 IF NOT (SELECT bool_and(relrowsecurity) FROM pg_class WHERE oid IN (
 'public.v2_training_athlete_restrictions'::regclass,
 'allin_private.v2_training_restriction_certifications'::regclass,
 'allin_private.v2_training_restriction_action_receipts'::regclass)) THEN
  RAISE EXCEPTION 'Restriction owner lacks RLS'; END IF;
END $acl$;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 'cccccccc-cccc-4ccc-8ccc-cccccccccccc',false);
DO $test$
DECLARE
 a uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 b uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 rule uuid:='eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee';
 act0 uuid:='11111111-1111-4111-8111-111111111111';
 act1 uuid:='22222222-2222-4222-8222-222222222222';
 act2 uuid:='33333333-3333-4333-8333-333333333333';
 j jsonb;
BEGIN
 -- Empty list is not trusted until explicitly certified.
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Empty uncertified rules were trusted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 -- Account absence of rules cannot establish inventory reconciliation.
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,act0,
   'certify_empty',null,null,null,0);
  RAISE EXCEPTION 'Athlete self-certified absent restrictions';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Uncertified inventory trusted after denied request';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 -- A user can still register a real restriction as the first reviewed action.
 j:=public.v2_training_restriction_write_candidate(a,act1,
  'activate',rule,'exercise','lying leg curl',0);
 IF (j->>'certifiedRevision')::integer<>1 THEN RAISE EXCEPTION 'Initial restriction activation failed'; END IF;
 j:=public.v2_training_restriction_write_candidate(a,act1,
  'activate',rule,'exercise','lying leg curl',0);
 IF j->>'replayed'<>'true' THEN RAISE EXCEPTION 'Exact retry failed'; END IF;
 j:=public.v2_training_active_restrictions_read_candidate(a);
 IF pg_catalog.jsonb_array_length(j->'restrictions')<>1 OR
  j->'restrictions'->0->>'subject'<>'lying leg curl' THEN
  RAISE EXCEPTION 'Saved restriction missing from fresh read'; END IF;
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,act1,
   'activate',rule,'exercise','wrong rule',0);
  RAISE EXCEPTION 'Changed action ID reused';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(b,act2,
   'retire',rule,null,null,1);
  RAISE EXCEPTION 'Owner spoofing accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,act2,
   'retire',rule,null,null,0);
  RAISE EXCEPTION 'Stale revision accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 j:=public.v2_training_restriction_write_candidate(a,act2,
  'retire',rule,null,null,1);
 IF (j->>'certifiedRevision')::integer<>2 THEN RAISE EXCEPTION 'Retirement failed'; END IF;
 j:=public.v2_training_active_restrictions_read_candidate(a);
 IF pg_catalog.jsonb_array_length(j->'restrictions')<>0 THEN
  RAISE EXCEPTION 'Retired restriction remains active'; END IF;
 -- A revoked/expired authenticated session cannot read or mutate rules.
 UPDATE auth.sessions SET not_after=now()-interval '1 second'
  WHERE id='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,
   '77777777-7777-4777-8777-777777777777','activate',
   '88888888-8888-4888-8888-888888888888','exercise','unsafe movement',2);
  RAISE EXCEPTION 'Expired restriction session wrote';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE auth.sessions SET not_after=NULL
  WHERE id='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 -- An entirely different authenticated owner has no access to A's rules.
 PERFORM pg_catalog.set_config('request.jwt.claim.sub',b::text,true);
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id',
  'dddddddd-dddd-4ddd-8ddd-dddddddddddd',true);
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Cross-owner restriction disclosure';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $test$;
DELETE FROM auth.users WHERE id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
DO $cascade$ BEGIN
 IF EXISTS(SELECT 1 FROM public.v2_training_athlete_restrictions
  WHERE user_id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa') OR
  EXISTS(SELECT 1 FROM allin_private.v2_training_restriction_certifications
  WHERE user_id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa') OR
  EXISTS(SELECT 1 FROM allin_private.v2_training_restriction_action_receipts
  WHERE user_id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa') THEN
   RAISE EXCEPTION 'Training restriction owner deletion did not cascade'; END IF;
END $cascade$;
SELECT 'PASS ALL-230 TRAINING RESTRICTION AUTH/REVISION/CASCADE' AS result;
