\set ON_ERROR_STOP on
DO $guard$ BEGIN
 IF current_database()<>'allin_coach_restrictions_test' THEN
  RAISE EXCEPTION 'Refusing restriction test outside disposable database'; END IF;
END $guard$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
DO $roles$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN BYPASSRLS; END IF;
END $roles$;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
CREATE TABLE auth.sessions(id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,not_after timestamptz);
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE SQL STABLE AS $uid$
 SELECT nullif(pg_catalog.current_setting('request.jwt.claim.sub',true),'')::uuid
$uid$;
CREATE TABLE public.v2_profiles(user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE);
\ir ../docs/architecture/sql/V2-TRAINING-ATHLETE-RESTRICTIONS-OWNER-REVIEW-CANDIDATE.sql
\ir ../docs/architecture/sql/V2-TRAINING-RESTRICTION-WRITER-REVIEW-CANDIDATE.sql
INSERT INTO auth.users(id) VALUES
 ('aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'),
 ('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb');
INSERT INTO auth.sessions(id,user_id) VALUES
 ('cccccccc-cccc-4ccc-8ccc-cccccccccccc','aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'),
 ('dddddddd-dddd-4ddd-8ddd-dddddddddddd','bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb');
INSERT INTO public.v2_profiles(user_id)
 SELECT id FROM auth.users;
DO $acl$ BEGIN
 IF has_function_privilege('authenticated',
  'public.v2_training_restriction_write_candidate(uuid,uuid,text,uuid,text,text,bigint)','EXECUTE')
 OR has_function_privilege('anon',
  'public.v2_training_restriction_write_candidate(uuid,uuid,text,uuid,text,text,bigint)','EXECUTE') THEN
  RAISE EXCEPTION 'Unreviewed restriction writer is exposed to clients'; END IF;
 IF NOT (SELECT bool_and(relrowsecurity) FROM pg_class WHERE oid IN (
 'public.v2_training_athlete_restrictions'::regclass,
 'allin_private.v2_training_restriction_certifications'::regclass,
 'allin_private.v2_training_restriction_action_receipts'::regclass)) THEN
  RAISE EXCEPTION 'Restriction owner lacks RLS'; END IF;
END $acl$;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 'cccccccc-cccc-4ccc-8ccc-cccccccccccc',false);
-- Simulate a recovered/source-authoritative restriction for owner B before
-- trusted inventory reconciliation; the row's existence must not give B
-- self-certification authority or let Coach read an uncertified partial set.
INSERT INTO public.v2_training_athlete_restrictions
 (id,user_id,category,subject,source,status,source_ref,revision)
VALUES(
 '99999999-9999-4999-8999-999999999999',
 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',
 'exercise','lying leg curl','approved_plan','active','synthetic_restored_plan',1
);
DO $unreconciled_restore$
DECLARE b uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
BEGIN
 PERFORM pg_catalog.set_config('request.jwt.claim.sub',b::text,true);
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id',
  'dddddddd-dddd-4ddd-8ddd-dddddddddddd',true);
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(b);
  RAISE EXCEPTION 'Restored partial inventory was treated as certified';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(b,
   '99999999-1111-4111-8111-999999999999','certify_empty',NULL,NULL,NULL,0);
  RAISE EXCEPTION 'Owner falsely cleared restored banned movement';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(b,
   '99999999-2222-4222-8222-999999999999','activate',
   '99999999-3333-4333-8333-999999999999','exercise','another unsafe exercise',0);
  RAISE EXCEPTION 'First-time mutation falsely certified restored inventory';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 IF EXISTS(SELECT 1 FROM allin_private.v2_training_restriction_certifications
  WHERE user_id=b) OR
  (SELECT count(*) FROM public.v2_training_athlete_restrictions WHERE user_id=b)<>1
 THEN RAISE EXCEPTION 'Denied certification changed restored source state'; END IF;
 -- A partial restore can retain the prior idempotency receipt but lose
 -- certification. The exact replay must still fail, not report success.
 INSERT INTO allin_private.v2_training_restriction_action_receipts
  (user_id,action_id,request_hash,result_revision)
 VALUES(b,'99999999-2222-4222-8222-999999999999',
  pg_catalog.md5(pg_catalog.jsonb_build_array(
   b,'activate','99999999-3333-4333-8333-999999999999'::uuid,
   'exercise','another unsafe exercise',0::bigint)::text),1);
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(b,
   '99999999-2222-4222-8222-999999999999','activate',
   '99999999-3333-4333-8333-999999999999','exercise','another unsafe exercise',0);
  RAISE EXCEPTION 'Orphaned restored action receipt falsely verified';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $unreconciled_restore$;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 'cccccccc-cccc-4ccc-8ccc-cccccccccccc',false);
DO $test$
DECLARE
 a uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 b uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 rule uuid:='eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee';
 act0 uuid:='11111111-1111-4111-8111-111111111111';
 act1 uuid:='22222222-2222-4222-8222-222222222222';
 act2 uuid:='33333333-3333-4333-8333-333333333333';
 j jsonb;
BEGIN
 -- Empty list is not trusted until explicitly certified.
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Empty uncertified rules were trusted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 -- Account absence of rules cannot establish inventory reconciliation.
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,act0,
   'certify_empty',null,null,null,0);
  RAISE EXCEPTION 'Athlete self-certified absent restrictions';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Uncertified inventory trusted after denied request';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 -- Even adding one real restriction cannot certify the entire inventory.
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,act1,
   'activate',rule,'exercise','lying leg curl',0);
  RAISE EXCEPTION 'Unreconciled first-time activation self-certified owner';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 IF EXISTS(SELECT 1 FROM allin_private.v2_training_restriction_certifications
  WHERE user_id=a) OR EXISTS(SELECT 1 FROM public.v2_training_athlete_restrictions
  WHERE user_id=a) THEN
  RAISE EXCEPTION 'Denied first-time activation persisted a false certification'; END IF;
 -- Synthetic test setup represents an OUT-OF-BAND trusted Training owner
 -- reconciliation, NOT a public RPC or user-callable production shortcut.
 INSERT INTO allin_private.v2_training_restriction_certifications
  (user_id,certified_revision,inventory_digest)
 VALUES(a,1,
  allin_private.v2_training_restriction_inventory_digest_candidate(a));
 j:=public.v2_training_active_restrictions_read_candidate(a);
 IF j->>'verified'<>'true' OR pg_catalog.jsonb_array_length(j->'restrictions')<>0 THEN
  RAISE EXCEPTION 'Trusted fixture baseline is not certified'; END IF;
 j:=public.v2_training_restriction_write_candidate(a,act1,
  'activate',rule,'exercise','lying leg curl',1);
 IF (j->>'certifiedRevision')::integer<>2 THEN RAISE EXCEPTION 'Restriction activation failed'; END IF;
 j:=public.v2_training_restriction_write_candidate(a,act1,
  'activate',rule,'exercise','lying leg curl',1);
 IF j->>'replayed'<>'true' THEN RAISE EXCEPTION 'Exact retry failed'; END IF;
 j:=public.v2_training_active_restrictions_read_candidate(a);
 IF pg_catalog.jsonb_array_length(j->'restrictions')<>1 OR
  j->'restrictions'->0->>'subject'<>'lying leg curl' THEN
  RAISE EXCEPTION 'Saved restriction missing from fresh read'; END IF;
 -- An unreviewed privileged row mutation must not masquerade as part of
 -- the certified snapshot even when it illegally keeps the old revision.
 UPDATE public.v2_training_athlete_restrictions
  SET subject='unreviewed changed movement',
      updated_at=pg_catalog.clock_timestamp()+interval '1 second'
  WHERE id=rule AND user_id=a;
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Changed rule passed old certification without revision';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 -- Even if a corrupted row backdates its timestamp and retains the same
 -- revision, the owner inventory checksum must reject the changed movement.
 UPDATE public.v2_training_athlete_restrictions
  SET updated_at=(SELECT certified_at
    FROM allin_private.v2_training_restriction_certifications WHERE user_id=a)
  WHERE id=rule AND user_id=a;
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Backdated changed exercise bypassed certified owner digest';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,act1,
   'activate',rule,'exercise','lying leg curl',1);
  RAISE EXCEPTION 'Old action receipt replayed over changed rule inventory';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 -- A NEW legitimate owner action must also fail. Otherwise the writer would
 -- advance certification and launder the tampered movement into trusted data.
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,
   '77777777-7777-4777-8777-777777777771',
   'retire',rule,null,null,2);
  RAISE EXCEPTION 'New owner action recertified a tampered inventory';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 IF EXISTS(SELECT 1 FROM allin_private.v2_training_restriction_action_receipts
   WHERE user_id=a AND action_id='77777777-7777-4777-8777-777777777771')
 OR (SELECT status FROM public.v2_training_athlete_restrictions WHERE id=rule)<>'active'
 OR (SELECT certified_revision
     FROM allin_private.v2_training_restriction_certifications WHERE user_id=a)<>2
 THEN RAISE EXCEPTION 'Rejected mutation persisted despite stale inventory'; END IF;
 -- Restore the synthetic canonical row to its exact certified version.
 UPDATE public.v2_training_athlete_restrictions
  SET subject='lying leg curl',
      updated_at=(SELECT certified_at
       FROM allin_private.v2_training_restriction_certifications WHERE user_id=a)
  WHERE id=rule AND user_id=a;
 j:=public.v2_training_active_restrictions_read_candidate(a);
 IF j->'restrictions'->0->>'subject'<>'lying leg curl' THEN
  RAISE EXCEPTION 'Restored certified record unreadable'; END IF;
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,act1,
   'activate',rule,'exercise','wrong rule',1);
  RAISE EXCEPTION 'Changed action ID reused';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(b,act2,
   'retire',rule,null,null,1);
  RAISE EXCEPTION 'Owner spoofing accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,act2,
   'retire',rule,null,null,1);
  RAISE EXCEPTION 'Stale revision accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 j:=public.v2_training_restriction_write_candidate(a,act2,
  'retire',rule,null,null,2);
 IF (j->>'certifiedRevision')::integer<>3 THEN RAISE EXCEPTION 'Retirement failed'; END IF;
 j:=public.v2_training_active_restrictions_read_candidate(a);
 IF pg_catalog.jsonb_array_length(j->'restrictions')<>0 THEN
  RAISE EXCEPTION 'Retired restriction remains active'; END IF;
 -- An inactive restriction is still owner history: a partial restore that
 -- drops it must invalidate the exact certified inventory, not look empty.
 DELETE FROM public.v2_training_athlete_restrictions
  WHERE id=rule AND user_id=a AND status='retired';
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Missing retired history passed old certification digest';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 -- A new, correctly authenticated owner write also cannot launder missing
 -- retired history back into a newly trusted inventory.
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,
   '77777777-7777-4777-8777-777777777772','activate',
   '88888888-8888-4888-8888-888888888882',
   'exercise','unrelated movement',3);
  RAISE EXCEPTION 'Partial restore recertified through a new owner action';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 IF EXISTS(SELECT 1 FROM allin_private.v2_training_restriction_action_receipts
   WHERE user_id=a AND action_id='77777777-7777-4777-8777-777777777772')
 OR EXISTS(SELECT 1 FROM public.v2_training_athlete_restrictions
   WHERE user_id=a AND id='88888888-8888-4888-8888-888888888882') OR
 (SELECT certified_revision
  FROM allin_private.v2_training_restriction_certifications WHERE user_id=a)<>3
 THEN RAISE EXCEPTION 'Rejected partial-restore action changed owner state'; END IF;
 -- Restore synthetic historical row to the certified state and verify.
 INSERT INTO public.v2_training_athlete_restrictions
  (id,user_id,category,subject,source,status,revision,created_at,updated_at)
 SELECT rule,a,'exercise','lying leg curl','explicit_user','retired',3,
  pg_catalog.now()-interval '1 minute',c.certified_at
 FROM allin_private.v2_training_restriction_certifications c WHERE c.user_id=a;
 -- The original record's created_at is part of the fingerprint; a reinsert
 -- cannot reproduce it, so this synthetic restore must remain blocked.
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Reconstructed retired history was falsely trusted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 -- A revoked/expired authenticated session cannot read or mutate rules.
 UPDATE auth.sessions SET not_after=now()-interval '1 second'
  WHERE id='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 BEGIN
  PERFORM public.v2_training_restriction_write_candidate(a,
   '77777777-7777-4777-8777-777777777777','activate',
   '88888888-8888-4888-8888-888888888888','exercise','unsafe movement',2);
  RAISE EXCEPTION 'Expired restriction session wrote';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Expired restriction session read certified rules';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE auth.sessions SET not_after=NULL
  WHERE id='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 -- An entirely different authenticated owner has no access to A's rules.
 PERFORM pg_catalog.set_config('request.jwt.claim.sub',b::text,true);
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id',
  'dddddddd-dddd-4ddd-8ddd-dddddddddddd',true);
 BEGIN
  PERFORM public.v2_training_active_restrictions_read_candidate(a);
  RAISE EXCEPTION 'Cross-owner restriction disclosure';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $test$;
DELETE FROM auth.users WHERE id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
DO $cascade$ BEGIN
 IF EXISTS(SELECT 1 FROM public.v2_training_athlete_restrictions
  WHERE user_id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa') OR
  EXISTS(SELECT 1 FROM allin_private.v2_training_restriction_certifications
  WHERE user_id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa') OR
  EXISTS(SELECT 1 FROM allin_private.v2_training_restriction_action_receipts
  WHERE user_id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa') THEN
   RAISE EXCEPTION 'Training restriction owner deletion did not cascade'; END IF;
END $cascade$;
SELECT 'PASS ALL-230 TRAINING RESTRICTION AUTH/REVISION/CASCADE' AS result;
