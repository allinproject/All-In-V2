\set ON_ERROR_STOP on
-- ALL-246 isolated Postgres17 owner-only canonical Today/Training day reader.
DO $roles$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN; END IF;
END $roles$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
CREATE TABLE auth.sessions(id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id));
CREATE TABLE public.v2_profiles(user_id uuid PRIMARY KEY REFERENCES auth.users(id));
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$
 SELECT nullif(pg_catalog.current_setting('request.jwt.claim.sub',true),'')::uuid
$$;
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETED-IDENTITY-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-PLAN-CALENDAR-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SESSION-LIFECYCLE-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-PLAN-ACCEPTANCE-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-IMMUTABLE-REVISION-GUARD-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-DAY-OWNER-READER-CANDIDATE.sql
DO $fixture$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 foreign_u uuid:='22222222-2222-4222-8222-222222222222';
 p1 uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 p2 uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 r1 uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 r2 uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 s1 uuid:='eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee';
 s2 uuid:='ffffffff-ffff-4fff-8fff-ffffffffffff';
BEGIN
 INSERT INTO auth.users VALUES(u),(foreign_u);
 INSERT INTO public.v2_profiles VALUES(u),(foreign_u);
 INSERT INTO auth.sessions VALUES
 ('10101010-1010-4010-8010-101010101010',u),
 ('20202020-2020-4020-8020-202020202020',foreign_u);
 INSERT INTO public.v2_training_plans(id,user_id,plan_kind) VALUES
 (p1,u,'race'),(p2,u,'race');
 INSERT INTO public.v2_training_plan_revisions
 (id,plan_id,user_id,revision_number,status,source_kind) VALUES
 (r1,p1,u,1,'candidate','athlete_authored'),
 (r2,p2,u,1,'candidate','athlete_authored');
 UPDATE public.v2_training_plan_revisions
 SET calendar_start_date='2026-11-11',calendar_end_date='2026-11-11',
     calendar_timezone='America/Chicago'
 WHERE id=r1;
 UPDATE public.v2_training_plan_revisions
 SET calendar_start_date='2026-11-11',calendar_end_date='2026-11-12',
     calendar_timezone='America/Chicago'
 WHERE id=r2;
 INSERT INTO public.v2_training_session_slots(id,plan_id,user_id,slot_key)
 VALUES('30303030-3030-4030-8030-303030303030',p1,u,'bike-a'),
       ('40404040-4040-4040-8040-404040404040',p2,u,'run-b');
 INSERT INTO public.v2_training_revision_days
 (id,plan_revision_id,plan_id,user_id,athlete_local_date,timezone,day_state,sort_order)
 VALUES('50505050-5050-4050-8050-505050505050',r1,p1,u,'2026-11-11','America/Chicago','planned',0),
       ('60606060-6060-4060-8060-606060606060',r2,p2,u,'2026-11-11','America/Chicago','planned',0),
       ('70707070-7070-4070-8070-707070707070',r2,p2,u,'2026-11-12','America/Chicago','rest',1);
 INSERT INTO public.v2_training_revision_sessions
 (id,plan_revision_id,session_slot_id,plan_id,user_id,athlete_local_date,timezone,
  sport,session_kind,purpose,priority,intensity,intent_schema_version,intent,sort_order)
 VALUES
 (s1,r1,'30303030-3030-4030-8030-303030303030',p1,u,'2026-11-11','America/Chicago',
  'cycling','interval','Race A training','key','hard','session-intent-v1','{}',0),
 (s2,r2,'40404040-4040-4040-8040-404040404040',p2,u,'2026-11-11','America/Chicago',
  'running','easy','Race B training','supporting','easy','session-intent-v1','{}',0);
 PERFORM allin_private.v2_training_accept_plan_revision_candidate(
   u,p1,r1,'80808080-8080-4080-8080-808080808080',1);
 PERFORM allin_private.v2_training_accept_plan_revision_candidate(
   u,p2,r2,'90909090-9090-4090-8090-909090909090',1);
 INSERT INTO public.v2_training_session_instances
 (id,user_id,revision_session_id,status,source_kind,athlete_local_date,timezone,started_at)
 VALUES('aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa',u,s1,'active','phone',
 '2026-11-11','America/Chicago','2026-11-11 13:00+00');
END $fixture$;
-- No client privilege in candidate; grant only for disposable acceptance test.
GRANT EXECUTE ON FUNCTION public.v2_training_day_read_candidate(uuid,date) TO authenticated;
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
  '11111111-1111-4111-8111-111111111111',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
  '10101010-1010-4010-8010-101010101010',false);
DO $read$
DECLARE
 v jsonb;
BEGIN
 v:=public.v2_training_day_read_candidate(
   '11111111-1111-4111-8111-111111111111','2026-11-11');
 IF pg_catalog.jsonb_array_length(v->'calendarDays')<>2
 OR pg_catalog.jsonb_array_length(v->'plannedWorkouts')<>2
 OR v#>>'{liveWorkout,status}'<>'active'
 OR v#>>'{liveWorkout,revisionSessionId}'<>'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee'
 THEN RAISE EXCEPTION 'Two-plan canonical Today read failed: %',v; END IF;
 -- Tomorrow is not included in today's workout list.
 v:=public.v2_training_day_read_candidate(
   '11111111-1111-4111-8111-111111111111','2026-11-12');
 IF pg_catalog.jsonb_array_length(v->'plannedWorkouts')<>0
 OR pg_catalog.jsonb_array_length(v->'calendarDays')<>1
 OR v#>>'{calendarDays,0,dayState}'<>'rest'
 THEN RAISE EXCEPTION 'Rest-day / next-day leakage: %',v; END IF;
 BEGIN
  PERFORM public.v2_training_day_read_candidate(
    '22222222-2222-4222-8222-222222222222','2026-11-11');
  RAISE EXCEPTION 'Foreign owner could read Training';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id',
 'ffffffff-ffff-4fff-8fff-ffffffffffff',true);
 BEGIN
  PERFORM public.v2_training_day_read_candidate(
    '11111111-1111-4111-8111-111111111111','2026-11-11');
  RAISE EXCEPTION 'Revoked session could read Training';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-246: two race plans, current live session, rest day and Auth ownership';
END $read$;
RESET ROLE;
-- The caller's stale JWT must not read when its physical Auth session is gone.
DELETE FROM auth.sessions WHERE id='10101010-1010-4010-8010-101010101010';
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
  '10101010-1010-4010-8010-101010101010',false);
DO $revoked$
BEGIN
 BEGIN
  PERFORM public.v2_training_day_read_candidate(
    '11111111-1111-4111-8111-111111111111','2026-11-11');
  RAISE EXCEPTION 'Deleted Auth session read Training';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $revoked$;
RESET ROLE;
