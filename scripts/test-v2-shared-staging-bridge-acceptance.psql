\set ON_ERROR_STOP on
-- Assert preserved preexisting synthetic domain rows and exact canonical
-- profile Auth trigger behavior after the review bridge is installed.
DO $accept$
BEGIN
 IF (SELECT count(*) FROM public.v2_coach_threads)<>1
 OR (SELECT count(*) FROM public.v2_coach_messages)<>1
 OR (SELECT count(*) FROM public.v2_food_log_entries)<>1
 OR (SELECT count(*) FROM public.v2_ingredients)<>1
 OR (SELECT count(*) FROM allin_private.v2_account_export_requests_candidate)<>1
 OR (SELECT count(*) FROM allin_private.v2_account_deletion_requests)<>1
 OR (SELECT status FROM allin_private.v2_account_deletion_requests
     WHERE user_id='11111111-1111-4111-8111-111111111111')<>'cancelled'
 THEN RAISE EXCEPTION 'Old Coach/Nutrition/account-lifecycle rows changed'; END IF;
 IF (SELECT display_name FROM public.v2_profiles
     WHERE user_id='11111111-1111-4111-8111-111111111111')<>'preserved-staging-test'
 OR NOT EXISTS(SELECT 1 FROM public.v2_profile_settings
     WHERE user_id='11111111-1111-4111-8111-111111111111')
 OR NOT EXISTS(SELECT 1 FROM public.v2_onboarding_progress
     WHERE user_id='11111111-1111-4111-8111-111111111111')
 THEN RAISE EXCEPTION 'Preexisting Auth owner not safely backfilled'; END IF;
 IF NOT pg_catalog.has_function_privilege('authenticated',
  'public.v2_coach_read_messages()','EXECUTE')
 OR pg_catalog.has_function_privilege('anon',
  'public.v2_coach_read_messages()','EXECUTE')
 THEN RAISE EXCEPTION 'Existing Coach ACL changed'; END IF;
END $accept$;
-- Future Auth signup must create ONLY new canonical owner profile rows.
INSERT INTO auth.users(id,raw_user_meta_data)
VALUES('77777777-7777-4777-8777-777777777777','{"display_name":"new-staging-user"}');
DO $owner$
BEGIN
 IF (SELECT display_name FROM public.v2_profiles
     WHERE user_id='77777777-7777-4777-8777-777777777777')<>'new-staging-user'
 OR NOT EXISTS(SELECT 1 FROM public.v2_profile_settings
     WHERE user_id='77777777-7777-4777-8777-777777777777')
 OR NOT EXISTS(SELECT 1 FROM public.v2_onboarding_progress
     WHERE user_id='77777777-7777-4777-8777-777777777777')
 THEN RAISE EXCEPTION 'Canonical Auth trigger did not provision owner profile'; END IF;
 IF EXISTS(SELECT 1 FROM allin_private.v2_account_deletion_requests
   WHERE user_id='77777777-7777-4777-8777-777777777777')
 THEN RAISE EXCEPTION 'Signup unexpectedly created deletion request'; END IF;
 IF EXISTS(SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n
   ON n.oid=c.relnamespace WHERE n.nspname='public'
   AND c.relname IN ('v2_profiles','v2_profile_settings','v2_onboarding_progress',
     'v2_legal_documents','v2_legal_acceptances') AND NOT c.relrowsecurity)
 THEN RAISE EXCEPTION 'Canonical owner RLS absent'; END IF;
 IF (SELECT count(*) FROM public.v2_coach_threads)<>1
 OR (SELECT count(*) FROM public.v2_ingredients)<>1
 THEN RAISE EXCEPTION 'Future signup touched existing domains'; END IF;
 RAISE NOTICE 'PASS ALL-222: exact canonical profile bridge retains Coach, Nutrition, ALL-251 and provisions new owner';
END $owner$;
