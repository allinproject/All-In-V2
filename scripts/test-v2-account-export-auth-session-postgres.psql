\set ON_ERROR_STOP on
-- ALL-251: standalone Auth-session / deletion-state gate replay.
-- Run only in cloned disposable PG17 integrated candidate database.
CREATE TABLE IF NOT EXISTS allin_private.v2_account_deletion_requests(
 user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
 request_id uuid NOT NULL UNIQUE,
 status text NOT NULL CHECK(status IN ('requested','processing','completed','rejected','cancelled'))
);
DO $qa$
DECLARE
 owner_id uuid:='11111111-1111-4111-8111-111111111111';
 other_id uuid:='22222222-2222-4222-8222-222222222222';
 session_id uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 v jsonb;
BEGIN
 INSERT INTO auth.users(id) VALUES(other_id) ON CONFLICT DO NOTHING;
 INSERT INTO auth.sessions(id,user_id) VALUES(session_id,owner_id);
 v:=allin_private.v2_account_export_authorize_session_candidate(owner_id,session_id);
 IF v->>'ownerId'<>owner_id::text
   OR v->>'sessionId'<>session_id::text OR v->>'exportPermitted'<>'true'
   OR v->>'completeUserExport'<>'false' THEN
    RAISE EXCEPTION 'Trusted Auth session gate returned invalid approval'; END IF;
 BEGIN
   PERFORM allin_private.v2_account_export_authorize_session_candidate(other_id,session_id);
   RAISE EXCEPTION 'Foreign owner reused a different owner session';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 INSERT INTO allin_private.v2_account_deletion_requests(user_id,request_id,status)
 VALUES(owner_id,'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','requested');
 BEGIN
   PERFORM allin_private.v2_account_export_authorize_session_candidate(owner_id,session_id);
   RAISE EXCEPTION 'Pending deletion request authorized archive export';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE allin_private.v2_account_deletion_requests SET status='processing' WHERE user_id=owner_id;
 BEGIN
   PERFORM allin_private.v2_account_export_authorize_session_candidate(owner_id,session_id);
   RAISE EXCEPTION 'Processing deletion authorized archive export';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE allin_private.v2_account_deletion_requests SET status='cancelled' WHERE user_id=owner_id;
 v:=allin_private.v2_account_export_authorize_session_candidate(owner_id,session_id);
 IF v->>'activeSession'<>'true' THEN RAISE EXCEPTION 'Cancelled deletion did not restore eligible account'; END IF;
 -- A current, eligible session is NOT sufficient without an approved,
 -- exact durable export request in the owning account-export subsystem.
 INSERT INTO allin_private.v2_account_export_requests_candidate(
   request_id,user_id,session_id,expires_at
 ) VALUES('cccccccc-cccc-4ccc-8ccc-cccccccccccc',owner_id,session_id,
   now()+interval '1 hour');
 BEGIN
   PERFORM allin_private.v2_account_export_authorize_request_candidate(
    owner_id,session_id,'cccccccc-cccc-4ccc-8ccc-cccccccccccc');
   RAISE EXCEPTION 'Unapproved export request was accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE allin_private.v2_account_export_requests_candidate
   SET status='approved' WHERE user_id=owner_id;
 v:=allin_private.v2_account_export_authorize_request_candidate(
    owner_id,session_id,'cccccccc-cccc-4ccc-8ccc-cccccccccccc');
 -- SQL worker wrapper is service-only and delegates to exact owner request
 -- proof without exposing allin_private through the REST schema.
 v:=public.v2_account_export_worker_authorize_candidate(
    owner_id,session_id,'cccccccc-cccc-4ccc-8ccc-cccccccccccc');
 IF v->>'requestId'<>'cccccccc-cccc-4ccc-8ccc-cccccccccccc'
    OR v->>'ownerId'<>owner_id::text OR v->>'status'<>'approved'
 THEN RAISE EXCEPTION 'Exact owner request not authorized'; END IF;
 BEGIN
   PERFORM allin_private.v2_account_export_authorize_request_candidate(
    other_id,session_id,'cccccccc-cccc-4ccc-8ccc-cccccccccccc');
   RAISE EXCEPTION 'Foreign account claimed export request';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE allin_private.v2_account_export_requests_candidate
   SET status='cancelled' WHERE user_id=owner_id;
 BEGIN
   PERFORM allin_private.v2_account_export_authorize_request_candidate(
    owner_id,session_id,'cccccccc-cccc-4ccc-8ccc-cccccccccccc');
   RAISE EXCEPTION 'Cancelled request allowed';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 UPDATE allin_private.v2_account_export_requests_candidate
   SET status='approved',requested_at=now()-interval '2 hours',
    expires_at=now()-interval '1 minute'
   WHERE user_id=owner_id;
 BEGIN
   PERFORM allin_private.v2_account_export_authorize_request_candidate(
    owner_id,session_id,'cccccccc-cccc-4ccc-8ccc-cccccccccccc');
   RAISE EXCEPTION 'Expired request allowed';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 -- Revoking Auth session must also remove its pending/staged request.
 UPDATE allin_private.v2_account_export_requests_candidate
  SET requested_at=now(),expires_at=now()+interval '1 hour'
  WHERE user_id=owner_id;
 DELETE FROM auth.sessions WHERE id=session_id;
 BEGIN
   PERFORM allin_private.v2_account_export_authorize_session_candidate(owner_id,session_id);
   RAISE EXCEPTION 'Revoked Auth session authorized archive export';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 IF EXISTS(SELECT 1 FROM allin_private.v2_account_export_requests_candidate WHERE user_id=owner_id)
 THEN RAISE EXCEPTION 'Revoked Auth session left a durable export request'; END IF;
 IF pg_catalog.has_function_privilege('anon',
    'public.v2_account_export_worker_authorize_candidate(uuid,uuid,uuid)','EXECUTE')
 OR pg_catalog.has_function_privilege('authenticated',
    'public.v2_account_export_worker_authorize_candidate(uuid,uuid,uuid)','EXECUTE')
 OR pg_catalog.has_function_privilege('service_role',
    'public.v2_account_export_worker_authorize_candidate(uuid,uuid,uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'Unapproved service-only export worker RPC exposed'; END IF;
 IF pg_catalog.has_function_privilege('authenticated',
   'allin_private.v2_account_export_authorize_request_candidate(uuid,uuid,uuid)','EXECUTE')
 OR pg_catalog.has_function_privilege('service_role',
   'allin_private.v2_account_export_authorize_request_candidate(uuid,uuid,uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'Unapproved export request function exposed'; END IF;
 IF pg_catalog.has_function_privilege('authenticated',
   'allin_private.v2_account_export_authorize_session_candidate(uuid,uuid)','EXECUTE')
 OR pg_catalog.has_function_privilege('service_role',
   'allin_private.v2_account_export_authorize_session_candidate(uuid,uuid)','EXECUTE')
 THEN RAISE EXCEPTION 'Unreviewed Auth export gate exposed to clients/service'; END IF;
 RAISE NOTICE 'PASS ALL-251: active Auth session, owner binding, deletion state and revocation';
END $qa$;
