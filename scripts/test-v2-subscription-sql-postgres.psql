\set ON_ERROR_STOP on
-- ALL-252 isolated PostgreSQL 17 replay. DISPOSABLE CI DB ONLY.
-- This intentionally executes the review-only candidate in a fresh database.
-- Roles are cluster-wide: the earlier Community test may already have made
-- them, even though this script uses a completely separate database.
DO $roles$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='anon') THEN
    CREATE ROLE anon NOLOGIN;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN
    CREATE ROLE authenticated NOLOGIN;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN
    CREATE ROLE service_role NOLOGIN BYPASSRLS;
  ELSE
    ALTER ROLE service_role BYPASSRLS;
  END IF;
END
$roles$;
CREATE SCHEMA auth;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
CREATE TABLE public.v2_profiles(user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE);
CREATE SCHEMA allin_private;

\ir ../docs/architecture/sql/V2-SUBSCRIPTION-VERIFIED-LEDGER-CANDIDATE.sql

DO $catalog$
DECLARE r text;
BEGIN
  IF (SELECT count(*) FROM pg_tables WHERE schemaname='allin_private'
      AND tablename LIKE 'v2_subscription_%') <> 3 THEN
    RAISE EXCEPTION 'Expected exactly two private subscription tables';
  END IF;
  IF EXISTS (SELECT 1 FROM pg_tables WHERE schemaname='public'
             AND tablename LIKE 'v2_subscription_%') THEN
    RAISE EXCEPTION 'Subscription created an exposed public table';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_class WHERE oid='allin_private.v2_subscription_checkout_attempts'::regclass
                 AND relrowsecurity) OR
     NOT EXISTS (SELECT 1 FROM pg_class WHERE oid='allin_private.v2_subscription_purchases'::regclass
                 AND relrowsecurity) OR
     NOT EXISTS (SELECT 1 FROM pg_class WHERE oid='allin_private.v2_subscription_verified_events'::regclass
                 AND relrowsecurity) THEN
    RAISE EXCEPTION 'Subscription RLS not enabled';
  END IF;
  FOREACH r IN ARRAY ARRAY['anon','authenticated'] LOOP
    IF has_table_privilege(r,'allin_private.v2_subscription_checkout_attempts','SELECT') OR
       has_table_privilege(r,'allin_private.v2_subscription_checkout_attempts','INSERT') OR
       has_table_privilege(r,'allin_private.v2_subscription_purchases','SELECT') OR
       has_table_privilege(r,'allin_private.v2_subscription_verified_events','SELECT') OR
       has_table_privilege(r,'allin_private.v2_subscription_purchases','INSERT') OR
       has_table_privilege(r,'allin_private.v2_subscription_verified_events','INSERT') OR
       has_function_privilege(r,
       'public.v2_billing_read_owner_access(uuid,text)','EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_lookup_purchase(text)','EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_verify_checkout_reservation(uuid,uuid)','EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_claim_trial_checkout(uuid)','EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_claim_paid_checkout(uuid)','EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_register_pending_checkout(uuid,uuid,text)','EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_finalize_checkout(uuid,uuid,text,text)','EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_lookup_checkout(text)','EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_apply_current_subscription_event(uuid,text,text,text,timestamptz)','EXECUTE') OR
       has_function_privilege(r,
       'allin_private.v2_claim_paid_checkout_attempt(uuid,uuid,text,text)',
       'EXECUTE') OR
       has_function_privilege(r,
       'allin_private.v2_claim_trial_checkout_attempt(uuid,uuid,text,text)',
       'EXECUTE') OR
       has_function_privilege(r,
       'allin_private.v2_reserve_subscription_checkout(uuid,uuid,uuid,text,text)',
       'EXECUTE') OR
       has_function_privilege(r,
       'allin_private.v2_register_pending_subscription_checkout(uuid,uuid,uuid,text,text,text)',
       'EXECUTE') OR
       has_function_privilege(r,
       'allin_private.v2_confirm_pending_subscription_checkout(uuid,uuid,text,text,text,text)',
       'EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_find_native_purchase_owner(text,text,text)','EXECUTE') OR
       has_function_privilege(r,
       'public.v2_billing_commit_verified_native(uuid,text,text,text,text,text,timestamptz)','EXECUTE') OR
       has_function_privilege(r,
       'allin_private.v2_bind_verified_native_subscription(uuid,text,text,text,text,text,timestamptz)',
       'EXECUTE') OR
       has_function_privilege(r,
       'allin_private.v2_bind_confirmed_subscription_purchase(uuid)', 'EXECUTE') OR
       has_function_privilege(r,
       'allin_private.v2_finalize_verified_subscription_checkout(uuid,uuid,text,text,text,text)',
       'EXECUTE') OR
       has_function_privilege(r,
       'allin_private.v2_apply_verified_subscription_event(uuid,text,text,text,text,bigint,text,timestamptz)',
       'EXECUTE') THEN
      RAISE EXCEPTION 'Client role % has direct subscription privilege',r;
    END IF;
  END LOOP;
END
$catalog$;

INSERT INTO auth.users VALUES
  ('00000000-0000-0000-0000-000000000001'),
  ('00000000-0000-0000-0000-000000000002');
INSERT INTO public.v2_profiles VALUES
  ('00000000-0000-0000-0000-000000000001'),
  ('00000000-0000-0000-0000-000000000002');

-- CI-only explicit service grants needed to exercise security-invoker.
-- Production grants are still separate reviewed release decisions.
GRANT USAGE ON SCHEMA allin_private TO service_role;
GRANT SELECT,INSERT,UPDATE ON allin_private.v2_subscription_checkout_attempts TO service_role;
GRANT SELECT,INSERT,UPDATE ON allin_private.v2_subscription_purchases TO service_role;
GRANT SELECT,INSERT ON allin_private.v2_subscription_verified_events TO service_role;
GRANT USAGE,SELECT ON SEQUENCE allin_private.v2_subscription_verified_events_id_seq TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_read_owner_access(uuid,text) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_lookup_purchase(text) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_verify_checkout_reservation(uuid,uuid) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_claim_trial_checkout(uuid) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_claim_paid_checkout(uuid) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_register_pending_checkout(uuid,uuid,text) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_finalize_checkout(uuid,uuid,text,text) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_lookup_checkout(text) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_apply_current_subscription_event(uuid,text,text,text,timestamptz) TO service_role;
GRANT EXECUTE ON FUNCTION allin_private.v2_claim_paid_checkout_attempt(
  uuid,uuid,text,text) TO service_role;
GRANT EXECUTE ON FUNCTION allin_private.v2_claim_trial_checkout_attempt(
  uuid,uuid,text,text) TO service_role;
GRANT EXECUTE ON FUNCTION allin_private.v2_reserve_subscription_checkout(
  uuid,uuid,uuid,text,text) TO service_role;
GRANT EXECUTE ON FUNCTION allin_private.v2_register_pending_subscription_checkout(
  uuid,uuid,uuid,text,text,text) TO service_role;
GRANT EXECUTE ON FUNCTION allin_private.v2_confirm_pending_subscription_checkout(
  uuid,uuid,text,text,text,text) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_find_native_purchase_owner(
 text,text,text) TO service_role;
GRANT EXECUTE ON FUNCTION public.v2_billing_commit_verified_native(
 uuid,text,text,text,text,text,timestamptz) TO service_role;
GRANT EXECUTE ON FUNCTION allin_private.v2_bind_verified_native_subscription(
 uuid,text,text,text,text,text,timestamptz) TO service_role;
GRANT EXECUTE ON FUNCTION allin_private.v2_bind_confirmed_subscription_purchase(uuid) TO service_role;
GRANT EXECUTE ON FUNCTION allin_private.v2_finalize_verified_subscription_checkout(
  uuid,uuid,text,text,text,text) TO service_role;
GRANT EXECUTE ON FUNCTION allin_private.v2_apply_verified_subscription_event(
  uuid,text,text,text,text,bigint,text,timestamptz) TO service_role;

-- ALL-222: review the ACTUAL function catalog rather than a fixed list.
-- New billing RPCs must fail this test until privileges are explicitly reviewed.
-- Effective privileges include grants inherited through PUBLIC.
DO $billing_privilege_inventory$
DECLARE
  fn record;
  t record;
  api_role text;
BEGIN
  FOR fn IN
    SELECT p.oid, p.proname, n.nspname AS function_schema,
           p.prosecdef, p.proconfig
      FROM pg_proc p
      JOIN pg_namespace n ON n.oid = p.pronamespace
     WHERE (n.nspname='public' AND p.proname LIKE 'v2_billing_%')
        OR (n.nspname='allin_private' AND
            (p.proname LIKE 'v2_%subscription%' OR
             p.proname LIKE 'v2_%checkout%'))
  LOOP
    IF fn.prosecdef OR fn.proconfig IS NULL OR
       NOT ('search_path=""'=ANY(fn.proconfig)) THEN
      RAISE EXCEPTION 'Billing RPC % (%) not pinned invoker',
        fn.proname,fn.function_schema;
    END IF;
    FOREACH api_role IN ARRAY ARRAY['anon','authenticated'] LOOP
      IF has_function_privilege(api_role,fn.oid,'EXECUTE') THEN
        RAISE EXCEPTION 'Role % can execute billing RPC %.%',
          api_role,fn.function_schema,fn.proname;
      END IF;
    END LOOP;
    IF NOT has_function_privilege('service_role',fn.oid,'EXECUTE') THEN
      RAISE EXCEPTION 'Service role cannot execute billing RPC %.%',
        fn.function_schema,fn.proname;
    END IF;
  END LOOP;
  FOR t IN
    SELECT c.oid,c.relname,c.relrowsecurity
    FROM pg_class c
    JOIN pg_namespace n ON n.oid=c.relnamespace
    WHERE n.nspname='allin_private'
      AND c.relkind IN ('r','p')
      AND c.relname LIKE 'v2_subscription_%'
  LOOP
    IF NOT t.relrowsecurity THEN
      RAISE EXCEPTION 'Billing table % has RLS off',t.relname;
    END IF;
    -- Billing rows are intentionally service-only, with no client RLS
    -- policies. A future policy must trigger a deliberate security review.
    IF EXISTS (SELECT 1 FROM pg_policy WHERE polrelid=t.oid) THEN
      RAISE EXCEPTION 'Unexpected client-facing billing policy on %',t.relname;
    END IF;
    FOREACH api_role IN ARRAY ARRAY['anon','authenticated'] LOOP
      IF has_table_privilege(api_role,t.oid,'SELECT') OR
         has_table_privilege(api_role,t.oid,'INSERT') OR
         has_table_privilege(api_role,t.oid,'UPDATE') OR
         has_table_privilege(api_role,t.oid,'DELETE') OR
         has_table_privilege(api_role,t.oid,'TRUNCATE') OR
         has_table_privilege(api_role,t.oid,'REFERENCES') OR
         has_table_privilege(api_role,t.oid,'TRIGGER') THEN
        RAISE EXCEPTION 'Role % can directly access billing table %',
          api_role,t.relname;
      END IF;
    END LOOP;
  END LOOP;
  -- Sequence identity values are private receipt provenance too. Default
  -- privileges can accidentally expose them independently of table RLS.
  FOR t IN
    SELECT c.oid,c.relname
    FROM pg_class c
    JOIN pg_namespace n ON n.oid=c.relnamespace
    WHERE n.nspname='allin_private' AND c.relkind='S'
      AND c.relname LIKE 'v2_subscription_%'
  LOOP
    FOREACH api_role IN ARRAY ARRAY['anon','authenticated'] LOOP
      IF has_sequence_privilege(api_role,t.oid,'USAGE') OR
         has_sequence_privilege(api_role,t.oid,'SELECT') OR
         has_sequence_privilege(api_role,t.oid,'UPDATE') THEN
        RAISE EXCEPTION 'Role % can access billing sequence %',
          api_role,t.relname;
      END IF;
    END LOOP;
  END LOOP;
  FOREACH api_role IN ARRAY ARRAY['anon','authenticated'] LOOP
    IF has_schema_privilege(api_role,'allin_private','USAGE') OR
       has_schema_privilege(api_role,'allin_private','CREATE') THEN
      RAISE EXCEPTION 'Role % can access private billing schema',api_role;
    END IF;
  END LOOP;
END
$billing_privilege_inventory$;

SET ROLE service_role;
DO $no_prebind$
BEGIN
  BEGIN
    PERFORM allin_private.v2_apply_verified_subscription_event(
      '00000000-0000-0000-0000-000000000001','stripe_web','sandbox',
      'sub_1','evt_1',1,'trial','2026-12-01 UTC');
    RAISE EXCEPTION 'Unbound webhook unexpectedly created an owner';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
END
$no_prebind$;
RESET ROLE;

-- Simulate a distinct approved checkout/restore prebinding transaction;
-- no webhook is permitted to perform this initial INSERT itself.
SET ROLE service_role;
DO $checkout_lifecycle$
DECLARE v_result text;
BEGIN
  SELECT allin_private.v2_reserve_subscription_checkout(
    '10000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    'stripe_web','sandbox') INTO v_result;
  IF v_result <> 'reserved' THEN RAISE EXCEPTION 'Expected reserved: %',v_result; END IF;
  SELECT allin_private.v2_reserve_subscription_checkout(
    '10000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    'stripe_web','sandbox') INTO v_result;
  IF v_result <> 'already_reserved' THEN RAISE EXCEPTION 'Expected reserve replay: %',v_result; END IF;
  BEGIN
    PERFORM allin_private.v2_reserve_subscription_checkout(
      '10000000-0000-0000-0000-000000000001',
      '00000000-0000-0000-0000-000000000002',
      '00000000-0000-0000-0000-000000000002',
      'stripe_web','sandbox');
    RAISE EXCEPTION 'Cross-owner reservation unexpectedly succeeded';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
  SELECT allin_private.v2_register_pending_subscription_checkout(
    '10000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    'stripe_web','sandbox','cs_1') INTO v_result;
  IF v_result <> 'pending' THEN RAISE EXCEPTION 'Expected pending: %',v_result; END IF;
  SELECT allin_private.v2_register_pending_subscription_checkout(
    '10000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    'stripe_web','sandbox','cs_1') INTO v_result;
  IF v_result <> 'already_pending' THEN RAISE EXCEPTION 'Expected replay: %',v_result; END IF;

  BEGIN
    PERFORM allin_private.v2_register_pending_subscription_checkout(
      '10000000-0000-0000-0000-000000000002',
      '00000000-0000-0000-0000-000000000002',
      '00000000-0000-0000-0000-000000000001',
      'stripe_web','sandbox','cs_2');
    RAISE EXCEPTION 'Cross-account pending checkout unexpectedly accepted';
  EXCEPTION WHEN invalid_parameter_value THEN NULL;
  END;

  BEGIN
    PERFORM allin_private.v2_bind_confirmed_subscription_purchase(
      '10000000-0000-0000-0000-000000000001');
    RAISE EXCEPTION 'Unconfirmed pending checkout unexpectedly bound';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;

  BEGIN
    PERFORM allin_private.v2_confirm_pending_subscription_checkout(
      '10000000-0000-0000-0000-000000000001',
      '00000000-0000-0000-0000-000000000002',
      'stripe_web','sandbox','cs_1','sub_1');
    RAISE EXCEPTION 'Foreign owner confirmed pending checkout';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;

  SELECT allin_private.v2_confirm_pending_subscription_checkout(
    '10000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    'stripe_web','sandbox','cs_1','sub_1') INTO v_result;
  IF v_result <> 'confirmed' THEN RAISE EXCEPTION 'Expected confirmation: %',v_result; END IF;
  SELECT allin_private.v2_confirm_pending_subscription_checkout(
    '10000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    'stripe_web','sandbox','cs_1','sub_1') INTO v_result;
  IF v_result <> 'already_confirmed' THEN RAISE EXCEPTION 'Confirmation replay: %',v_result; END IF;

  BEGIN
    PERFORM allin_private.v2_confirm_pending_subscription_checkout(
      '10000000-0000-0000-0000-000000000001',
      '00000000-0000-0000-0000-000000000001',
      'stripe_web','sandbox','cs_1','sub_forged');
    RAISE EXCEPTION 'Confirmed subscription overwritten';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;

  SELECT allin_private.v2_reserve_subscription_checkout(
    '10000000-0000-0000-0000-000000000002',
    '00000000-0000-0000-0000-000000000002',
    '00000000-0000-0000-0000-000000000002',
    'stripe_web','sandbox') INTO v_result;
  IF v_result <> 'reserved' THEN RAISE EXCEPTION 'Second reservation: %',v_result; END IF;
  SELECT allin_private.v2_register_pending_subscription_checkout(
    '10000000-0000-0000-0000-000000000002',
    '00000000-0000-0000-0000-000000000002',
    '00000000-0000-0000-0000-000000000002',
    'stripe_web','sandbox','cs_2') INTO v_result;
  IF v_result <> 'pending' THEN RAISE EXCEPTION 'Second pending: %',v_result; END IF;
  SELECT allin_private.v2_confirm_pending_subscription_checkout(
    '10000000-0000-0000-0000-000000000002',
    '00000000-0000-0000-0000-000000000002',
    'stripe_web','sandbox','cs_2','sub_2') INTO v_result;
  IF v_result <> 'confirmed' THEN RAISE EXCEPTION 'Second confirmation: %',v_result; END IF;
END
$checkout_lifecycle$;
RESET ROLE;

DO $unverified_purchase$
BEGIN
  BEGIN
    INSERT INTO allin_private.v2_subscription_purchases
      (owner_id,provider,environment,provider_subscription_id,checkout_attempt_id)
    VALUES ('00000000-0000-0000-0000-000000000002','stripe_web','sandbox',
            'sub_stolen','10000000-0000-0000-0000-000000000001');
    RAISE EXCEPTION 'Foreign checkout provenance incorrectly accepted';
  EXCEPTION WHEN foreign_key_violation THEN NULL;
  END;
END
$unverified_purchase$;

-- Binding occurs through the only reviewed service-only function.
SET ROLE service_role;
DO $binding$
DECLARE r text;
BEGIN
  SELECT allin_private.v2_bind_confirmed_subscription_purchase(
    '10000000-0000-0000-0000-000000000001') INTO r;
  IF r <> 'bound' THEN RAISE EXCEPTION 'First binding: %',r; END IF;
  SELECT allin_private.v2_bind_confirmed_subscription_purchase(
    '10000000-0000-0000-0000-000000000001') INTO r;
  IF r <> 'already_bound' THEN RAISE EXCEPTION 'Idempotent binding: %',r; END IF;
  SELECT allin_private.v2_bind_confirmed_subscription_purchase(
    '10000000-0000-0000-0000-000000000002') INTO r;
  IF r <> 'bound' THEN RAISE EXCEPTION 'Second binding: %',r; END IF;
  BEGIN
    PERFORM allin_private.v2_bind_confirmed_subscription_purchase(
      '10000000-0000-0000-0000-000000000099');
    RAISE EXCEPTION 'Unknown checkout attempt was accepted';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
END
$binding$;
RESET ROLE;

SET ROLE service_role;
DO $updates$
DECLARE r text;
BEGIN
  SELECT allin_private.v2_apply_verified_subscription_event(
    '00000000-0000-0000-0000-000000000001','stripe_web','sandbox',
    'sub_1','evt_1',1,'trial','2026-12-01 UTC') INTO r;
  IF r <> 'applied' THEN RAISE EXCEPTION 'First trial update: %',r; END IF;
  SELECT allin_private.v2_apply_verified_subscription_event(
    '00000000-0000-0000-0000-000000000001','stripe_web','sandbox',
    'sub_1','evt_1',1,'trial','2026-12-01 UTC') INTO r;
  IF r <> 'duplicate' THEN RAISE EXCEPTION 'Replay: %',r; END IF;
  SELECT allin_private.v2_apply_verified_subscription_event(
    '00000000-0000-0000-0000-000000000001','stripe_web','sandbox',
    'sub_1','evt_old',1,'paid','2026-12-20 UTC') INTO r;
  IF r <> 'stale' THEN RAISE EXCEPTION 'Stale: %',r; END IF;

  BEGIN
    PERFORM allin_private.v2_apply_verified_subscription_event(
      '00000000-0000-0000-0000-000000000002','stripe_web','sandbox',
      'sub_1','evt_wrong',2,'paid','2026-12-20 UTC');
    RAISE EXCEPTION 'Cross-account theft unexpectedly succeeded';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;

  BEGIN
    PERFORM allin_private.v2_apply_verified_subscription_event(
      '00000000-0000-0000-0000-000000000002','stripe_web','sandbox',
      'sub_2','evt_1',2,'paid','2026-12-20 UTC');
    RAISE EXCEPTION 'Provider event collision unexpectedly succeeded';
  EXCEPTION WHEN unique_violation THEN NULL;
  END;

  SELECT allin_private.v2_apply_verified_subscription_event(
    '00000000-0000-0000-0000-000000000001','stripe_web','sandbox',
    'sub_1','evt_refund',3,'refunded',NULL) INTO r;
  IF r <> 'applied' THEN RAISE EXCEPTION 'Refund: %',r; END IF;
  IF EXISTS (SELECT 1 FROM allin_private.v2_subscription_purchases
             WHERE provider_subscription_id='sub_1'
               AND (phase <> 'refunded' OR access_until IS NOT NULL OR revision<>3)) THEN
    RAISE EXCEPTION 'Refund did not clear paid access';
  END IF;
  IF (SELECT count(*) FROM allin_private.v2_subscription_verified_events
      WHERE provider_event_id IN ('evt_1','evt_refund')) <> 2 THEN
    RAISE EXCEPTION 'Expected exactly two durable events';
  END IF;
END
$updates$;
RESET ROLE;

-- Atomic finalization has a single service RPC/transaction boundary.
INSERT INTO auth.users VALUES ('00000000-0000-0000-0000-000000000006');
INSERT INTO public.v2_profiles VALUES ('00000000-0000-0000-0000-000000000006');
SET ROLE service_role;
DO $finalize$
DECLARE r text;
BEGIN
  SELECT allin_private.v2_reserve_subscription_checkout(
    '10000000-0000-0000-0000-000000000006',
    '00000000-0000-0000-0000-000000000006',
    '00000000-0000-0000-0000-000000000006',
    'stripe_web','sandbox') INTO r;
  IF r <> 'reserved' THEN RAISE EXCEPTION 'Finalize reservation: %',r; END IF;
  SELECT allin_private.v2_register_pending_subscription_checkout(
    '10000000-0000-0000-0000-000000000006',
    '00000000-0000-0000-0000-000000000006',
    '00000000-0000-0000-0000-000000000006',
    'stripe_web','sandbox','cs_6') INTO r;
  IF r <> 'pending' THEN RAISE EXCEPTION 'Finalize pending: %',r; END IF;
  BEGIN
    PERFORM allin_private.v2_finalize_verified_subscription_checkout(
      '10000000-0000-0000-0000-000000000006',
      '00000000-0000-0000-0000-000000000002',
      'stripe_web','sandbox','cs_6','sub_6');
    RAISE EXCEPTION 'Foreign account wrongly finalized purchase';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
  IF EXISTS (SELECT 1 FROM allin_private.v2_subscription_purchases
             WHERE provider_subscription_id='sub_6') THEN
    RAISE EXCEPTION 'Rejected finalization committed a purchase';
  END IF;
  SELECT allin_private.v2_finalize_verified_subscription_checkout(
    '10000000-0000-0000-0000-000000000006',
    '00000000-0000-0000-0000-000000000006',
    'stripe_web','sandbox','cs_6','sub_6') INTO r;
  IF r <> 'finalized' THEN RAISE EXCEPTION 'Finalize: %',r; END IF;
  SELECT allin_private.v2_finalize_verified_subscription_checkout(
    '10000000-0000-0000-0000-000000000006',
    '00000000-0000-0000-0000-000000000006',
    'stripe_web','sandbox','cs_6','sub_6') INTO r;
  IF r <> 'already_finalized' THEN RAISE EXCEPTION 'Finalization replay: %',r; END IF;
  IF (SELECT count(*) FROM allin_private.v2_subscription_purchases
       WHERE provider_subscription_id='sub_6'
         AND owner_id='00000000-0000-0000-0000-000000000006') <> 1 THEN
    RAISE EXCEPTION 'Finalization did not commit exactly one owner-bound purchase';
  END IF;
END
$finalize$;
RESET ROLE;

-- Account-level claim is idempotent, generated by the database and shared
-- across all checkout entrypoints. No caller-provided trial entitlement.
INSERT INTO auth.users VALUES ('00000000-0000-0000-0000-000000000008');
INSERT INTO public.v2_profiles VALUES ('00000000-0000-0000-0000-000000000008');
SET ROLE service_role;
DO $trialclaim$
DECLARE v_first uuid;
  v_retry uuid;
  v_status text;
  v_owner uuid;
  v_eligible boolean;
  v_result text;
BEGIN
  SELECT status,attempt_id,owner_id,trial_eligible
    INTO v_status,v_first,v_owner,v_eligible
    FROM allin_private.v2_claim_trial_checkout_attempt(
       '00000000-0000-0000-0000-000000000008',
       '00000000-0000-0000-0000-000000000008','stripe_web','sandbox');
  IF v_status <> 'eligible_reserved' OR v_first IS NULL OR
      v_owner <> '00000000-0000-0000-0000-000000000008' OR NOT v_eligible THEN
    RAISE EXCEPTION 'Owner trial claim did not generate reserved identity';
  END IF;
  -- Direct privileged writes are still constrained by the unique
  -- account-active-checkout index, independent of RPC locks.
  BEGIN
    INSERT INTO allin_private.v2_subscription_checkout_attempts(
      attempt_id,owner_id,provider,environment,provider_checkout_id,
      provider_subscription_id,state,verified_at
    ) VALUES (
      '10000000-0000-0000-0000-000000000010',
      '00000000-0000-0000-0000-000000000008',
      'google_play','sandbox',null,null,'reserved',null);
    RAISE EXCEPTION 'Privileged direct insert bypassed one-active-checkout index';
  EXCEPTION WHEN unique_violation THEN NULL;
  END;
  SELECT status,attempt_id INTO v_status,v_retry
    FROM allin_private.v2_claim_trial_checkout_attempt(
       '00000000-0000-0000-0000-000000000008',
       '00000000-0000-0000-0000-000000000008','stripe_web','sandbox');
  IF v_status <> 'eligible_reserved' OR v_retry <> v_first THEN
    RAISE EXCEPTION 'Owner retry did not reuse durable UUID';
  END IF;
  BEGIN
    PERFORM allin_private.v2_reserve_subscription_checkout(
      '10000000-0000-0000-0000-000000000009',
      '00000000-0000-0000-0000-000000000008',
      '00000000-0000-0000-0000-000000000008',
      'stripe_web','sandbox');
    RAISE EXCEPTION 'Separate direct reservation bypassed owner lock';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
  SELECT status INTO v_status
    FROM allin_private.v2_claim_trial_checkout_attempt(
      '00000000-0000-0000-0000-000000000008',
      '00000000-0000-0000-0000-000000000008','app_store','sandbox');
  IF v_status <> 'trial_unavailable' THEN
    RAISE EXCEPTION 'Different provider created a parallel trial';
  END IF;
  SELECT allin_private.v2_register_pending_subscription_checkout(
      v_first,'00000000-0000-0000-0000-000000000008',
      '00000000-0000-0000-0000-000000000008',
      'stripe_web','sandbox','cs_8') INTO v_result;
  IF v_result <> 'pending' THEN RAISE EXCEPTION 'Claimed pending: %',v_result; END IF;
  SELECT allin_private.v2_finalize_verified_subscription_checkout(
      v_first,'00000000-0000-0000-0000-000000000008',
      'stripe_web','sandbox','cs_8','sub_8') INTO v_result;
  IF v_result <> 'finalized' THEN RAISE EXCEPTION 'Claim finalize: %',v_result; END IF;
  SELECT status,attempt_id,trial_eligible INTO v_status,v_retry,v_eligible
    FROM allin_private.v2_claim_trial_checkout_attempt(
      '00000000-0000-0000-0000-000000000008',
      '00000000-0000-0000-0000-000000000008','stripe_web','sandbox');
  IF v_status <> 'trial_ineligible' OR v_retry IS NOT NULL OR v_eligible THEN
    RAISE EXCEPTION 'Consumed trial was incorrectly reusable';
  END IF;
END
$trialclaim$;
RESET ROLE;

-- A previously refunded subscriber may start a new paid-only checkout,
-- not repeat their trial. An unreconciled new purchase blocks further checkout.
INSERT INTO auth.users VALUES ('00000000-0000-0000-0000-000000000007');
INSERT INTO public.v2_profiles VALUES ('00000000-0000-0000-0000-000000000007');
SET ROLE service_role;
DO $paid_reactivation$
DECLARE v_paid uuid;
  v_retry uuid;
  v_status text;
  v_owner uuid;
  v_trial boolean;
  v_result text;
BEGIN
  SELECT status INTO v_status FROM allin_private.v2_claim_paid_checkout_attempt(
    '00000000-0000-0000-0000-000000000007',
    '00000000-0000-0000-0000-000000000007','stripe_web','sandbox');
  IF v_status <> 'not_returning_customer' THEN
    RAISE EXCEPTION 'First-time customer bypassed trial policy through paid flow';
  END IF;
  SELECT status,attempt_id,owner_id,trial_eligible
    INTO v_status,v_paid,v_owner,v_trial
    FROM allin_private.v2_claim_paid_checkout_attempt(
    '00000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001','stripe_web','sandbox');
  IF v_status <> 'eligible_reserved' OR v_paid IS NULL OR v_trial OR
     v_owner <> '00000000-0000-0000-0000-000000000001' THEN
    RAISE EXCEPTION 'Former subscriber was not offered paid-only checkout';
  END IF;
  SELECT status,attempt_id INTO v_status,v_retry
    FROM allin_private.v2_claim_paid_checkout_attempt(
    '00000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001','stripe_web','sandbox');
  IF v_status <> 'eligible_reserved' OR v_retry <> v_paid THEN
    RAISE EXCEPTION 'Returning paid checkout retry used a new UUID';
  END IF;
  SELECT allin_private.v2_reserve_subscription_checkout(
    v_paid,'00000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    'stripe_web','sandbox') INTO v_result;
  IF v_result <> 'already_reserved' THEN
    RAISE EXCEPTION 'Paid checkout reservation was not reusable';
  END IF;
  SELECT allin_private.v2_register_pending_subscription_checkout(
    v_paid,'00000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001',
    'stripe_web','sandbox','cs_paid_1') INTO v_result;
  IF v_result <> 'pending' THEN RAISE EXCEPTION 'Paid pending: %',v_result; END IF;
  SELECT allin_private.v2_finalize_verified_subscription_checkout(
    v_paid,'00000000-0000-0000-0000-000000000001',
    'stripe_web','sandbox','cs_paid_1','sub_paid_1') INTO v_result;
  IF v_result <> 'finalized' THEN RAISE EXCEPTION 'Paid finalization: %',v_result; END IF;
  IF NOT EXISTS (
     SELECT 1 FROM allin_private.v2_subscription_checkout_attempts
     WHERE attempt_id=v_paid AND offer_kind='paid'
       AND state='server_confirmed') THEN
    RAISE EXCEPTION 'Paid checkout was not preserved as no-trial';
  END IF;
  SELECT status INTO v_status
    FROM allin_private.v2_claim_paid_checkout_attempt(
    '00000000-0000-0000-0000-000000000001',
    '00000000-0000-0000-0000-000000000001','stripe_web','sandbox');
  IF v_status <> 'subscription_unresolved' THEN
    RAISE EXCEPTION 'Second active/unreconciled subscription checkout allowed';
  END IF;
END
$paid_reactivation$;
RESET ROLE;

DELETE FROM auth.users WHERE id='00000000-0000-0000-0000-000000000001';
DO $cascade$
BEGIN
  IF EXISTS (SELECT 1 FROM allin_private.v2_subscription_purchases
             WHERE provider_subscription_id='sub_1') OR
     EXISTS (SELECT 1 FROM allin_private.v2_subscription_verified_events e
             JOIN allin_private.v2_subscription_purchases p ON p.id=e.purchase_id
             WHERE p.provider_subscription_id='sub_1') THEN
    RAISE EXCEPTION 'Account deletion left subscription data behind';
  END IF;
  IF EXISTS (SELECT 1 FROM allin_private.v2_subscription_checkout_attempts
                 WHERE owner_id='00000000-0000-0000-0000-000000000001') THEN
    RAISE EXCEPTION 'Account deletion left checkout provenance';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM allin_private.v2_subscription_purchases
                 WHERE provider_subscription_id='sub_2') THEN
    RAISE EXCEPTION 'Other account purchase was lost';
  END IF;
END
$cascade$;

-- Review-only public bridge: a normal user cannot execute any of these
-- exposed-schema functions, while only service_role can mutate same ledger.
INSERT INTO auth.users(id) VALUES('00000000-0000-0000-0000-000000000013');
INSERT INTO public.v2_profiles(user_id) VALUES('00000000-0000-0000-0000-000000000013');
SET ROLE service_role;
DO $bridge$
DECLARE a uuid; r text; st text; eligible boolean; lookup_owner uuid;
BEGIN
  SELECT attempt_id,status,trial_eligible INTO a,st,eligible
    FROM public.v2_billing_claim_trial_checkout(
      '00000000-0000-0000-0000-000000000013');
  IF a IS NULL OR st <> 'eligible_reserved' OR NOT eligible THEN
    RAISE EXCEPTION 'Service-only public trial bridge failed';
  END IF;
  SELECT public.v2_billing_verify_checkout_reservation(
    a,'00000000-0000-0000-0000-000000000013') INTO r;
  IF r <> 'already_reserved' THEN RAISE EXCEPTION 'Bridge reservation verify: %',r; END IF;
  BEGIN
    PERFORM public.v2_billing_verify_checkout_reservation(
      a,'00000000-0000-0000-0000-000000000002');
    RAISE EXCEPTION 'Bridge disclosed foreign reservation';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
  SELECT public.v2_billing_register_pending_checkout(
    a,'00000000-0000-0000-0000-000000000013','cs_bridge_13') INTO r;
  IF r <> 'pending' THEN RAISE EXCEPTION 'Bridge pending: %',r; END IF;
  SELECT owner_id INTO lookup_owner FROM public.v2_billing_lookup_checkout('cs_bridge_13');
  IF lookup_owner IS DISTINCT FROM '00000000-0000-0000-0000-000000000013'::uuid THEN
    RAISE EXCEPTION 'Bridge owner lookup changed owner';
  END IF;
  BEGIN
    PERFORM public.v2_billing_finalize_checkout(
      a,'00000000-0000-0000-0000-000000000002','cs_bridge_13','sub_bridge_13');
    RAISE EXCEPTION 'Bridge finalized foreign account';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
  SELECT public.v2_billing_finalize_checkout(
    a,'00000000-0000-0000-0000-000000000013','cs_bridge_13','sub_bridge_13') INTO r;
  IF r <> 'finalized' THEN RAISE EXCEPTION 'Bridge finalize: %',r; END IF;
  SELECT public.v2_billing_apply_current_subscription_event(
    '00000000-0000-0000-0000-000000000013',
    'sub_bridge_13','evt_bridge_13','paid','2027-01-01 UTC') INTO r;
  IF r <> 'applied' THEN RAISE EXCEPTION 'Bridge event: %',r; END IF;
  SELECT public.v2_billing_apply_current_subscription_event(
    '00000000-0000-0000-0000-000000000013',
    'sub_bridge_13','evt_bridge_13','paid','2027-01-01 UTC') INTO r;
  IF r <> 'duplicate' THEN RAISE EXCEPTION 'Bridge replay: %',r; END IF;
  IF NOT EXISTS (
    SELECT 1 FROM allin_private.v2_subscription_purchases
    WHERE owner_id='00000000-0000-0000-0000-000000000013'
      AND provider_subscription_id='sub_bridge_13' AND revision=1 AND phase='paid'
  ) THEN RAISE EXCEPTION 'Bridge failed to persist original owner and revision'; END IF;
  IF NOT EXISTS (
    SELECT 1 FROM public.v2_billing_lookup_purchase('sub_bridge_13')
    WHERE owner_id='00000000-0000-0000-0000-000000000013'
      AND provider_subscription_id='sub_bridge_13' AND revision=1
  ) THEN RAISE EXCEPTION 'Webhook purchase lookup returned wrong owner'; END IF;
  IF EXISTS (SELECT 1 FROM public.v2_billing_lookup_purchase('sub_unbound_13')) THEN
    RAISE EXCEPTION 'Webhook purchase lookup accepted unbound provider ID';
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM public.v2_billing_read_owner_access(
      '00000000-0000-0000-0000-000000000013','sandbox')
    WHERE entitled AND access_until='2027-01-01 UTC'::timestamptz
  ) THEN RAISE EXCEPTION 'Verified owner access missing'; END IF;
  IF EXISTS (
    SELECT 1 FROM public.v2_billing_read_owner_access(
      '00000000-0000-0000-0000-000000000013','production')
    WHERE entitled OR access_until IS NOT NULL
  ) THEN RAISE EXCEPTION 'Sandbox payment leaked production entitlement'; END IF;
  IF EXISTS (
    SELECT 1 FROM public.v2_billing_read_owner_access(
      '00000000-0000-0000-0000-000000000002','production')
    WHERE entitled
  ) THEN RAISE EXCEPTION 'Foreign production entitlement leaked'; END IF;
  SELECT public.v2_billing_apply_current_subscription_event(
    '00000000-0000-0000-0000-000000000013',
    'sub_bridge_13','evt_revoked_bridge_13','revoked',NULL) INTO r;
  IF r <> 'applied' THEN RAISE EXCEPTION 'Owner revocation not applied'; END IF;
  IF EXISTS (
    SELECT 1 FROM public.v2_billing_read_owner_access(
      '00000000-0000-0000-0000-000000000013','sandbox')
    WHERE entitled OR access_until IS NOT NULL
  ) THEN RAISE EXCEPTION 'Revoked purchase still entitled'; END IF;

END
$bridge$;
RESET ROLE;


-- Native store receipt already independently verified by a trusted worker:
-- bind its immutable subscription ID to the authenticated V2 owner.
INSERT INTO auth.users(id) VALUES
 ('00000000-0000-0000-0000-000000000014'),
 ('00000000-0000-0000-0000-000000000015');
INSERT INTO public.v2_profiles(user_id) VALUES
 ('00000000-0000-0000-0000-000000000014'),
 ('00000000-0000-0000-0000-000000000015');
SET ROLE service_role;
DO $native_purchase$
DECLARE r text;
BEGIN
  SELECT allin_private.v2_bind_verified_native_subscription(
    '00000000-0000-0000-0000-000000000014',
    'app_store','sandbox','123456789000014','apple_txn_14',
    'trial','2027-01-01 UTC') INTO r;
  IF r <> 'committed' THEN RAISE EXCEPTION 'Apple bind: %',r; END IF;
  IF NOT EXISTS (
    SELECT 1 FROM public.v2_billing_find_native_purchase_owner(
      'app_store','sandbox','123456789000014')
    WHERE owner_id='00000000-0000-0000-0000-000000000014'
  ) THEN RAISE EXCEPTION 'Native service lookup lost owner'; END IF;
  IF EXISTS (
    SELECT 1 FROM public.v2_billing_find_native_purchase_owner(
      'app_store','production','123456789000014')
  ) THEN RAISE EXCEPTION 'Sandbox Apple ownership leaked production'; END IF;

  SELECT allin_private.v2_bind_verified_native_subscription(
    '00000000-0000-0000-0000-000000000014',
    'app_store','sandbox','123456789000014','apple_txn_14',
    'trial','2027-01-01 UTC') INTO r;
  IF r <> 'duplicate' THEN RAISE EXCEPTION 'Apple duplicate: %',r; END IF;
  BEGIN
    PERFORM allin_private.v2_bind_verified_native_subscription(
      '00000000-0000-0000-0000-000000000015',
      'app_store','sandbox','123456789000014','apple_stolen_15',
      'paid','2027-01-01 UTC');
    RAISE EXCEPTION 'Apple purchase transferred to other owner';
  EXCEPTION WHEN insufficient_privilege THEN NULL;
  END;
  SELECT allin_private.v2_bind_verified_native_subscription(
    '00000000-0000-0000-0000-000000000014',
    'google_play','sandbox','sha256:google_token_14','google_event_14',
    'paid','2027-01-01 UTC') INTO r;
  IF r <> 'committed' THEN RAISE EXCEPTION 'Google bind: %',r; END IF;
  SELECT public.v2_billing_commit_verified_native(
    '00000000-0000-0000-0000-000000000014',
    'google_play','sandbox','sha256:google_token_14','google_event_14',
    'paid','2027-01-01 UTC') INTO r;
  IF r <> 'duplicate' THEN RAISE EXCEPTION 'Native public bridge replay: %',r; END IF;
  IF (SELECT count(*) FROM allin_private.v2_subscription_purchases
       WHERE owner_id='00000000-0000-0000-0000-000000000014') <> 2 THEN
    RAISE EXCEPTION 'Native independent purchase count changed';
  END IF;
  SELECT allin_private.v2_bind_verified_native_subscription(
    '00000000-0000-0000-0000-000000000014',
    'app_store','sandbox','123456789000014','apple_refund_14',
    'refunded',NULL) INTO r;
  IF r <> 'committed' THEN RAISE EXCEPTION 'Apple refund: %',r; END IF;
  IF NOT EXISTS (
    SELECT 1 FROM public.v2_billing_read_owner_access(
      '00000000-0000-0000-0000-000000000014','sandbox')
    WHERE entitled
  ) THEN RAISE EXCEPTION 'Independent Google access lost after Apple refund'; END IF;
  SELECT allin_private.v2_bind_verified_native_subscription(
    '00000000-0000-0000-0000-000000000014',
    'google_play','sandbox','sha256:google_token_14','google_revoke_14',
    'revoked',NULL) INTO r;
  IF r <> 'committed' THEN RAISE EXCEPTION 'Google revoke: %',r; END IF;
  IF EXISTS (
    SELECT 1 FROM public.v2_billing_read_owner_access(
      '00000000-0000-0000-0000-000000000014','sandbox')
    WHERE entitled OR access_until IS NOT NULL
  ) THEN RAISE EXCEPTION 'Native revoked account still entitled'; END IF;
  IF EXISTS (
    SELECT 1 FROM public.v2_billing_read_owner_access(
      '00000000-0000-0000-0000-000000000014','production')
    WHERE entitled
  ) THEN RAISE EXCEPTION 'Native sandbox purchase leaked production'; END IF;
END
$native_purchase$;
RESET ROLE;

SELECT 'PASS ALL-252 isolated PostgreSQL SQL candidate replay' AS outcome;
