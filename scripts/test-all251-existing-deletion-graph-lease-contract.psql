\set ON_ERROR_STOP on
-- Real SQL execution of existing deletion graph scanner. First prove it
-- refuses missing live lease fences, then prove enabling the exact triggers
-- clears ONLY those contract gaps, never the remaining bucket cleanup gate.
DO $missing$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE reason='missing_privileged_storage_deletion_or_auth_fence')
 OR NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE reason='missing_privileged_storage_metadata_write_fence')
 OR NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE reason='unreviewed_storage_bucket_cleanup')
 THEN RAISE EXCEPTION 'Missing Storage fences or bucket did not block deletion'; END IF;
END $missing$;
CREATE TRIGGER v2_privileged_storage_write_fence_review
 BEFORE INSERT OR UPDATE ON allin_private.v2_account_deletion_requests
 FOR EACH ROW EXECUTE FUNCTION allin_private.v2_test_fence();
CREATE TRIGGER v2_privileged_storage_auth_delete_fence_review
 BEFORE DELETE ON auth.users FOR EACH ROW
 EXECUTE FUNCTION allin_private.v2_test_fence();
CREATE TRIGGER v2_privileged_storage_metadata_write_fence_review
 BEFORE INSERT OR UPDATE ON storage.objects FOR EACH ROW
 EXECUTE FUNCTION allin_private.v2_test_fence();
DO $fences$
BEGIN
 IF EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE reason LIKE 'missing_privileged_storage%')
 OR NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE reason='unreviewed_storage_bucket_cleanup')
 THEN RAISE EXCEPTION 'Installed fences did not clear their gaps, or bucket coverage was mistakenly approved'; END IF;
END $fences$;
ALTER TABLE allin_private.v2_privileged_storage_write_leases_review DISABLE ROW LEVEL SECURITY;
DO $unsafe$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE reason='missing_or_unsecured_privileged_write_lease_ledger')
 THEN RAISE EXCEPTION 'Unsafe lease ledger RLS accepted'; END IF;
END $unsafe$;
ALTER TABLE allin_private.v2_privileged_storage_write_leases_review ENABLE ROW LEVEL SECURITY;
-- A future privileged grant is not an acceptable shortcut around the
-- reviewed writer/lease discipline, even when RLS itself stays enabled.
GRANT SELECT ON allin_private.v2_privileged_storage_write_leases_review TO authenticated;
DO $grant$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
   WHERE reason='missing_or_unsecured_privileged_write_lease_ledger')
 THEN RAISE EXCEPTION 'Direct authenticated lease access was silently accepted'; END IF;
END $grant$;
REVOKE SELECT ON allin_private.v2_privileged_storage_write_leases_review FROM authenticated;

ALTER TABLE storage.objects DISABLE TRIGGER v2_privileged_storage_metadata_write_fence_review;
DO $disabled$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
    WHERE reason='missing_privileged_storage_metadata_write_fence')
 THEN RAISE EXCEPTION 'Disabled privileged Storage metadata trigger accepted'; END IF;
END $disabled$;
ALTER TABLE storage.objects ENABLE TRIGGER v2_privileged_storage_metadata_write_fence_review;
CREATE TABLE public.v2_unreviewed_owner_history (
  id uuid PRIMARY KEY,
  owner_id uuid NOT NULL);
-- An owner-domain child with only a join FK still needs Auth cascade.
-- An unrelated global ingredient reference without such a join is not
-- automatically user data. This prevents false positives on global catalog.
CREATE TABLE public.v2_test_owned_parent(
 id uuid PRIMARY KEY,
 user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE);
CREATE TABLE public.v2_test_join_child(
 id uuid PRIMARY KEY,
 parent_id uuid NOT NULL REFERENCES public.v2_test_owned_parent(id));
CREATE TABLE public.v2_test_global_reference(id uuid PRIMARY KEY);
DO $join_missing$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
  WHERE table_name='v2_test_join_child'
   AND reason='join_only_owner_child_without_verified_auth_cascade')
 THEN RAISE EXCEPTION 'Join-only no-action FK escaped canonical deletion coverage'; END IF;
 IF EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
  WHERE table_name='v2_test_global_reference')
 THEN RAISE EXCEPTION 'Unrelated global reference incorrectly treated as owner data'; END IF;
END $join_missing$;
ALTER TABLE public.v2_test_join_child DROP CONSTRAINT v2_test_join_child_parent_id_fkey;
ALTER TABLE public.v2_test_join_child ADD CONSTRAINT v2_test_join_child_parent_id_fkey
 FOREIGN KEY(parent_id) REFERENCES public.v2_test_owned_parent(id) ON DELETE CASCADE;
DO $join_fixed$
BEGIN
 IF EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
  WHERE table_name='v2_test_join_child')
 THEN RAISE EXCEPTION 'Verified join-only Auth cascade was not recognized'; END IF;
END $join_fixed$;
DO $new_table$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM allin_private.v2_deletion_owner_graph_gaps_review()
    WHERE table_name='v2_unreviewed_owner_history'
      AND reason='no_verified_auth_cascade_path')
 THEN RAISE EXCEPTION 'Unexpected new owner table omitted from deletion inventory'; END IF;
 RAISE NOTICE 'PASS ALL-251: lease ledger ACL/cascade, all three live Storage fences and unknown owner tables fail closed';
END $new_table$;
