\set ON_ERROR_STOP on
-- ALL-244: pure candidate on disposable Supabase foundation. No hosted SQL.
BEGIN;
DO $event_qa$
DECLARE
 a uuid:='11111111-1111-4111-8111-111111111111';
 b uuid:='22222222-2222-4222-8222-222222222222';
 event_a uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 event_b uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 group_a uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 group_b uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
BEGIN
 INSERT INTO auth.users(id) VALUES(a),(b);
 INSERT INTO public.v2_events(id,name,sport,event_kind,start_local_date,
   event_timezone,source_verification)
 VALUES(event_a,'Spring Trail','running','ultra',DATE '2027-04-10',
         'America/Chicago','organizer_verified'),
       (event_b,'Local Triathlon','triathlon','multisport',DATE '2027-04-10',
         'America/Chicago','organizer_verified');
 INSERT INTO public.v2_event_url_aliases(
   id,event_id,canonical_url,evidence_kind,source_checked_at)
 VALUES('eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee',
        event_a,'https://example.org/events/spring-trail','organizer_verified',now()),
       ('ffffffff-ffff-4fff-8fff-ffffffffffff',
        event_b,'https://example.org/events/local-triathlon','organizer_verified',now());
 INSERT INTO public.v2_event_groups(id,event_id,state)
 VALUES(group_a,event_a,'active'),(group_b,event_b,'active');
 -- The athlete explicitly joins one matching group. This is NOT registration.
 INSERT INTO public.v2_event_group_memberships(
 user_id,event_id,group_id,state,joined_at,participant_visible)
 VALUES(a,event_a,group_a,'joined',now(),false),
       (b,event_b,group_b,'joined',now(),false);
 IF EXISTS(SELECT 1 FROM public.v2_event_participations WHERE user_id=a)
 THEN RAISE EXCEPTION 'Group join fabricated event registration'; END IF;
 -- Separate athlete-confirmed registration; no organizer-certified result.
 INSERT INTO public.v2_event_participations(
   user_id,event_id,state,source_kind,result_verified)
 VALUES(a,event_a,'registered','athlete_confirmed',false);
 IF (SELECT count(*) FROM public.v2_events WHERE start_local_date=DATE '2027-04-10')<>2
 THEN RAISE EXCEPTION 'Distinct same-day events were merged'; END IF;
 BEGIN
  INSERT INTO public.v2_event_url_aliases(id,event_id,canonical_url,evidence_kind)
  VALUES('33333333-3333-4333-8333-333333333333',event_b,
      'https://example.org/events/spring-trail','submitted');
  RAISE EXCEPTION 'One event URL alias assigned to two canonical events';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 BEGIN
  INSERT INTO public.v2_event_group_memberships(
    user_id,event_id,group_id,state,joined_at)
  VALUES(a,event_a,group_b,'joined',now());
  RAISE EXCEPTION 'Event group identity mismatch accepted';
 EXCEPTION WHEN foreign_key_violation THEN NULL; END;
 BEGIN
  UPDATE public.v2_event_participations
    SET state='completed',result_verified=true WHERE user_id=a AND event_id=event_a;
  RAISE EXCEPTION 'Registration falsely became verified race result';
 EXCEPTION WHEN check_violation THEN NULL; END;
 BEGIN
  INSERT INTO public.v2_events(id,name,sport,event_kind,source_verification)
  VALUES('44444444-4444-4444-8444-444444444444',
      'Undated purported official race','running','race','organizer_verified');
  RAISE EXCEPTION 'Verified event accepted without known date/timezone';
 EXCEPTION WHEN check_violation THEN NULL; END;
 BEGIN
  INSERT INTO public.v2_event_group_memberships(user_id,event_id,group_id,
    state,participant_visible,joined_at)
  VALUES('44444444-4444-4444-8444-444444444444',event_a,group_a,
    'not_joined',true,null);
  RAISE EXCEPTION 'Unjoined event was publicly visible as participant';
 EXCEPTION WHEN check_violation OR foreign_key_violation THEN NULL; END;
 IF EXISTS(
   SELECT 1 FROM pg_catalog.pg_class c
   WHERE c.oid IN (
    'public.v2_events'::regclass,'public.v2_event_url_aliases'::regclass,
    'public.v2_event_groups'::regclass,
    'public.v2_event_group_memberships'::regclass,
    'public.v2_event_participations'::regclass)
    AND NOT c.relrowsecurity)
 THEN RAISE EXCEPTION 'Canonical EventHub RLS disabled'; END IF;
 IF has_table_privilege('authenticated','public.v2_events','SELECT')
   OR has_table_privilege('authenticated','public.v2_event_participations','INSERT')
   OR has_table_privilege('anon','public.v2_event_groups','SELECT')
   OR has_table_privilege('service_role','public.v2_event_group_memberships','UPDATE')
 THEN RAISE EXCEPTION 'Candidate EventHub table grants leaked'; END IF;
 DELETE FROM auth.users WHERE id=a;
 IF EXISTS(SELECT 1 FROM public.v2_event_group_memberships WHERE user_id=a)
  OR EXISTS(SELECT 1 FROM public.v2_event_participations WHERE user_id=a)
 THEN RAISE EXCEPTION 'Auth deletion retained athlete event records'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.v2_event_group_memberships WHERE user_id=b)
 THEN RAISE EXCEPTION 'Unaffected athlete lost independent EventHub group'; END IF;
 RAISE NOTICE 'PASS ALL-244: canonical event aliases, private groups vs verified participation, all sport and owner isolation';
END $event_qa$;
ROLLBACK;
