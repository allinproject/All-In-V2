  (follower_id, followed_id, state, approved_at)
VALUES
  ('00000000-0000-0000-0000-000000000002',
   '00000000-0000-0000-0000-000000000001', 'approved', now());

DO $community_directional$
BEGIN
  BEGIN
    INSERT INTO allin_private.v2_community_follows
      (follower_id, followed_id, state)
    VALUES
      ('00000000-0000-0000-0000-000000000001',
       '00000000-0000-0000-0000-000000000001', 'pending');
    RAISE EXCEPTION 'Self-follow was accepted';
  EXCEPTION WHEN check_violation THEN
    NULL;
  END;

  BEGIN
    INSERT INTO allin_private.v2_community_follows
      (follower_id, followed_id, state, approved_at)
    VALUES
      ('00000000-0000-0000-0000-000000000001',
       '00000000-0000-0000-0000-000000000002', 'pending', now());
    RAISE EXCEPTION 'Pending follow with approval timestamp was accepted';
  EXCEPTION WHEN check_violation THEN
    NULL;
  END;
END
$community_directional$;

INSERT INTO allin_private.v2_community_blocks (blocker_id, blocked_id)
VALUES
  ('00000000-0000-0000-0000-000000000001',
   '00000000-0000-0000-0000-000000000002'),
  ('00000000-0000-0000-0000-000000000002',
   '00000000-0000-0000-0000-000000000001');

DO $community_blocks$
BEGIN
  BEGIN
    INSERT INTO allin_private.v2_community_blocks (blocker_id, blocked_id)
    VALUES
      ('00000000-0000-0000-0000-000000000001',
       '00000000-0000-0000-0000-000000000001');
    RAISE EXCEPTION 'Self-block was accepted';
  EXCEPTION WHEN check_violation THEN
