$community_blocks$;

INSERT INTO allin_private.v2_community_action_receipts
  (actor_id, action_id, target_id, action, expected_version,
   result_version, payload_sha256)
VALUES
  ('00000000-0000-0000-0000-000000000001',
   '10000000-0000-0000-0000-000000000001',
   '00000000-0000-0000-0000-000000000002',
   'request_follow', 1, 2,
   'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa');

DO $community_receipts$
BEGIN
  BEGIN
    INSERT INTO allin_private.v2_community_action_receipts
      (actor_id, action_id, target_id, action, expected_version,
       result_version, payload_sha256)
    VALUES
      ('00000000-0000-0000-0000-000000000001',
       '10000000-0000-0000-0000-000000000002',
       '00000000-0000-0000-0000-000000000002',
       'request_follow', 2, 2,
       'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa');
    RAISE EXCEPTION 'Non-increasing action receipt version was accepted';
  EXCEPTION WHEN check_violation THEN
    NULL;
  END;

  BEGIN
    INSERT INTO allin_private.v2_community_action_receipts
      (actor_id, action_id, target_id, action, expected_version,
       result_version, payload_sha256)
    VALUES
      ('00000000-0000-0000-0000-000000000001',
       '10000000-0000-0000-0000-000000000003',
       '00000000-0000-0000-0000-000000000002',
       'request_follow', 1, 2, 'bad-hash');
    RAISE EXCEPTION 'Invalid receipt fingerprint was accepted';
  EXCEPTION WHEN check_violation THEN
    NULL;
  END;
END
$community_receipts$;

-- Auth deletion must cascade through the owner profile and every dependent
-- Community relation/receipt, including rows where that athlete is the target.
DELETE FROM auth.users
WHERE id = '00000000-0000-0000-0000-000000000001';

DO $community_delete$
DECLARE
  table_name text;
  remaining bigint;
BEGIN
  IF EXISTS (
    SELECT 1 FROM public.v2_profiles
    WHERE user_id = '00000000-0000-0000-0000-000000000001'
  ) THEN
    RAISE EXCEPTION 'Deleted Auth identity still has a V2 profile';
  END IF;

  FOREACH table_name IN ARRAY ARRAY[
    'v2_community_visibility',
    'v2_community_pair_revisions',
    'v2_community_follows',
    'v2_community_blocks',
    'v2_community_action_receipts'
  ] LOOP
    EXECUTE format('SELECT count(*) FROM allin_private.%I', table_name)
      INTO remaining;
    IF remaining <> 0 THEN
      RAISE EXCEPTION 'Account deletion left % row(s) in %', remaining, table_name;
    END IF;
  END LOOP;
END
$community_delete$;

\echo PASS: Community privacy candidate executed on PostgreSQL and passed catalog, constraint, directional, and deletion-cascade checks.
