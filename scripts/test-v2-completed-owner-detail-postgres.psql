\set ON_ERROR_STOP on
-- ALL-243 owner-scoped Activity Details, disposable PostgreSQL 17 only.
DO $roles$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN; END IF;
END $roles$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
CREATE TABLE auth.sessions(id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id),
 not_after timestamptz);
-- Test the EXACT Auth session column type expected by the candidate function,
-- before invoking SECURITY DEFINER. A missing or non-timestamp field must
-- produce an actionable fixture-contract failure rather than a runtime 42703.
DO $auth_shape$
BEGIN
 IF NOT EXISTS(
  SELECT 1 FROM pg_catalog.pg_attribute a
  JOIN pg_catalog.pg_class c ON c.oid=a.attrelid
  JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
  WHERE n.nspname='auth' AND c.relname='sessions'
    AND a.attname='not_after' AND a.atttypid='timestamptz'::regtype
    AND a.attnum>0 AND NOT a.attisdropped
 ) THEN RAISE EXCEPTION 'Test Auth session expiry column missing or wrong type'
   USING ERRCODE='42703'; END IF;
END $auth_shape$;
CREATE TABLE public.v2_profiles(user_id uuid PRIMARY KEY REFERENCES auth.users(id));
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$
 SELECT nullif(pg_catalog.current_setting('request.jwt.claim.sub',true),'')::uuid
$$;
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETED-IDENTITY-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SCALAR-METRICS-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SEGMENTS-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-STRENGTH-SETS-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-EVIDENCE-OBJECTS-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SCALAR-READ-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-SEGMENT-SCALAR-READ-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-OWNER-DETAIL-READER-CANDIDATE.sql
DO $fixture$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 outsider uuid:='22222222-2222-4222-8222-222222222222';
 ride uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 strength uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 sensor uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 block uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 interval uuid:='eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee';
 lift_src uuid:='ffffffff-ffff-4fff-8fff-ffffffffffff';
BEGIN
 INSERT INTO auth.users VALUES(u),(outsider);
 INSERT INTO public.v2_profiles VALUES(u),(outsider);
 INSERT INTO auth.sessions(id,user_id,not_after) VALUES
 ('10101010-1010-4010-8010-101010101010',u,pg_catalog.clock_timestamp()+interval '1 hour'),
 ('20202020-2020-4020-8020-202020202020',outsider,pg_catalog.clock_timestamp()+interval '1 hour');
 INSERT INTO public.v2_completed_activities(
  id,user_id,sport,activity_kind,athlete_local_date,timezone,capture_kind,status)
 VALUES
 (ride,u,'cycling','workout','2026-11-11','America/Chicago','device_measured','needs_review'),
 (strength,u,'strength','workout','2026-11-11','America/Chicago','manual_only','needs_review');
 INSERT INTO public.v2_activity_sources(
  id,activity_id,user_id,provider,source_kind,source_record_id,quality,source_payload_hash)
 VALUES
 (sensor,ride,u,'supported_equipment','device_session','private-trainer-id','trusted',repeat('a',64)),
 (lift_src,strength,u,'manual','manual_record','private-manual-id','unverified',repeat('b',64));
 INSERT INTO public.v2_activity_segments(
  id,activity_id,user_id,segment_kind,sequence_number,sport,source_id)
 VALUES(block,ride,u,'interval',1,'cycling',sensor),
       (interval,ride,u,'interval',2,'cycling',sensor),
       ('30303030-3030-4030-8030-303030303030',strength,u,
        'strength_exercise',1,'strength',lift_src);
 INSERT INTO public.v2_activity_metric_definitions(
  metric_code,definition_version,display_name,canonical_unit,value_kind,
  sport_scope,measurement_kinds,display_group,privacy_class,status)
 VALUES('avg_power_w',1,'Power','W','numeric',ARRAY['cycling'],
  ARRAY['source_measured'],'power','private','published');
 INSERT INTO public.v2_activity_metric_values(
  id,activity_id,user_id,segment_id,source_id,metric_code,definition_version,
  value_numeric,measurement_kind,quality,source_payload_hash)
 VALUES('40404040-4040-4040-8040-404040404040',ride,u,block,sensor,'avg_power_w',1,
   200,'source_measured','trusted',repeat('a',64)),
 ('50505050-5050-4050-8050-505050505050',ride,u,interval,sensor,'avg_power_w',1,
   260,'source_measured','trusted',repeat('a',64));
 INSERT INTO public.v2_activity_strength_sets(
  id,activity_id,user_id,exercise_segment_id,source_id,
  set_index,set_kind,reps,load_value,load_unit,load_mode,quality,source_payload_hash)
 VALUES('60606060-6060-4060-8060-606060606060',strength,u,
  '30303030-3030-4030-8030-303030303030',lift_src,
  1,'working',8,45,'kg','external_load','unverified',repeat('b',64));
 INSERT INTO public.v2_activity_route_objects(
  id,activity_id,user_id,source_id,object_path,format,checksum_sha256,
  point_count,quality,state,privacy_state)
 VALUES('70707070-7070-4070-8070-707070707070',ride,u,sensor,
  u::text||'/'||repeat('r',64)||'/private.fit','fit',repeat('1',64),
  42,'trusted','ready','private');
END $fixture$;
-- Candidate grants are deliberately absent. Test-only permission.
GRANT EXECUTE ON FUNCTION public.v2_completed_activity_detail_candidate(uuid,uuid)
 TO authenticated;
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '11111111-1111-4111-8111-111111111111',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 '10101010-1010-4010-8010-101010101010',false);
DO $qa$
DECLARE
 v jsonb;
BEGIN
 v:=public.v2_completed_activity_detail_candidate(
   '11111111-1111-4111-8111-111111111111',
   'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa');
 IF v->>'sport'<>'cycling'
 OR v->>'status'<>'needs_review'
 OR pg_catalog.jsonb_array_length(v->'segments')<>2
 OR v#>>'{segments,0,sourceMetrics,metrics,0,valueNumeric}'<>'200'
 OR v#>>'{segments,1,sourceMetrics,metrics,0,valueNumeric}'<>'260'
 OR v#>>'{activityMetrics,metrics}' IS NULL
 OR v->>'readyPrivateRouteCount'<>'1'
 THEN RAISE EXCEPTION 'Owner details omitted distinct interval readings: %',v; END IF;
 IF v::text LIKE '%private-trainer-id%'
 OR v::text LIKE '%private.fit%'
 OR v::text LIKE '%11111111-1111-4111-8111-111111111111/rrrr%' THEN
  RAISE EXCEPTION 'Sensitive provider record or private route path leaked'; END IF;
 v:=public.v2_completed_activity_detail_candidate(
 '11111111-1111-4111-8111-111111111111',
 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb');
 IF pg_catalog.jsonb_array_length(v->'strengthSets')<>1
 OR v#>>'{strengthSets,0,reps}'<>'8'
 OR v#>>'{strengthSets,0,loadValue}'<>'45'
 OR v#>>'{strengthSets,0,quality}'<>'unverified' THEN
  RAISE EXCEPTION 'Strength owner details fabricated or lost source: %',v; END IF;
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate(
   '22222222-2222-4222-8222-222222222222',
   'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa');
  RAISE EXCEPTION 'Expected owner spoofing exposed Activity';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate(
   '11111111-1111-4111-8111-111111111111',
   '22222222-aaaa-4aaa-8aaa-aaaaaaaaaaaa');
  RAISE EXCEPTION 'Missing Activity returned synthetic detail';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id','',true);
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate(
   '11111111-1111-4111-8111-111111111111',
   'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa');
  RAISE EXCEPTION 'Revoked Auth session exposed completed history';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-243: canonical owner-only Activity Details, interval and strength evidence, route privacy';
END $qa$;
RESET ROLE;

-- Expired live Auth session rows must be denied, even when a valid-looking
-- JWT keeps presenting the same owner and session ID.
UPDATE auth.sessions SET not_after=pg_catalog.clock_timestamp()-interval '1 minute'
 WHERE id='10101010-1010-4010-8010-101010101010';
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '11111111-1111-4111-8111-111111111111',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 '10101010-1010-4010-8010-101010101010',false);
DO $expired$
BEGIN
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate(
   '11111111-1111-4111-8111-111111111111',
   'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa');
  RAISE EXCEPTION 'Expired session exposed completed activity';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-243: expired Auth sessions denied';
END $expired$;
RESET ROLE;
UPDATE auth.sessions SET not_after=pg_catalog.clock_timestamp()+interval '1 hour'
 WHERE id='10101010-1010-4010-8010-101010101010';

-- Large imported source collections must fail closed rather than returning
-- unbounded JSON. This uses only synthetic records in the disposable DB.
INSERT INTO public.v2_activity_sources(
 id,activity_id,user_id,provider,source_kind,source_record_id,quality)
SELECT pg_catalog.md5('v2-source-limit-'||g::text)::uuid,
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'::uuid,
 '11111111-1111-4111-8111-111111111111'::uuid,
 'supported_equipment','device_session','source-limit-'||g::text,'unverified'
FROM pg_catalog.generate_series(1,129) AS g;
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '11111111-1111-4111-8111-111111111111',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 '10101010-1010-4010-8010-101010101010',false);
DO $source_bound$
BEGIN
 BEGIN
  PERFORM public.v2_completed_activity_detail_candidate(
   '11111111-1111-4111-8111-111111111111',
   'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa');
  RAISE EXCEPTION 'Unbounded imported source list was returned to client';
 EXCEPTION WHEN program_limit_exceeded THEN NULL; END;
 RAISE NOTICE 'PASS ALL-243: excessive imported source count denied by owner detail';
END $source_bound$;
RESET ROLE;
