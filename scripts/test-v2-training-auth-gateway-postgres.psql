\set ON_ERROR_STOP on
-- ALL-246: disposable DB Auth ownership/invalidation regression only.
DO $roles$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN; END IF;
END $roles$;
CREATE SCHEMA auth;
CREATE SCHEMA allin_private;
CREATE TABLE auth.users(id uuid PRIMARY KEY);
CREATE TABLE auth.sessions(id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id));
CREATE TABLE public.v2_profiles(user_id uuid PRIMARY KEY REFERENCES auth.users(id));
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$
 SELECT nullif(pg_catalog.current_setting('request.jwt.claim.sub',true),'')::uuid
$$;
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-COMPLETED-IDENTITY-OWNER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-SESSION-LIFECYCLE-WRITER-CANDIDATE.sql
\i /tmp/allin/docs/architecture/sql/V2-TRAINING-AUTH-OWNER-GATEWAY-CANDIDATE.sql
INSERT INTO auth.users VALUES
 ('11111111-1111-4111-8111-111111111111'),
 ('22222222-2222-4222-8222-222222222222');
INSERT INTO public.v2_profiles VALUES
 ('11111111-1111-4111-8111-111111111111'),
 ('22222222-2222-4222-8222-222222222222');
INSERT INTO auth.sessions VALUES
 ('aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','11111111-1111-4111-8111-111111111111'),
 ('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','22222222-2222-4222-8222-222222222222');
-- A test-only grant permits proving the proposed gateway logic. The
-- committed gateway SQL deliberately grants NO user execution.
GRANT USAGE ON SCHEMA public TO authenticated;
GRANT USAGE ON SCHEMA auth TO authenticated;
GRANT EXECUTE ON FUNCTION public.v2_training_session_action_candidate(
 uuid,uuid,uuid,text,bigint,text,date,text,timestamptz) TO authenticated;
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '11111111-1111-4111-8111-111111111111',false);
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',false);
DO $qa$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 foreign_u uuid:='22222222-2222-4222-8222-222222222222';
 sess uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 action uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 result jsonb;
BEGIN
 BEGIN
   PERFORM allin_private.v2_training_apply_session_candidate(
     u,sess,action,'start',0,repeat('a',64),
     '2026-11-11','America/Chicago','2026-11-11 12:00+00');
   RAISE EXCEPTION 'Client reached private writer directly';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
   PERFORM public.v2_training_session_action_candidate(foreign_u,sess,action,'start',
      0,repeat('a',64),'2026-11-11','America/Chicago','2026-11-11 12:00+00');
   RAISE EXCEPTION 'Cross-account spoof accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 result:=public.v2_training_session_action_candidate(u,sess,action,'start',
    0,repeat('a',64),'2026-11-11','America/Chicago','2026-11-11 12:00+00');
 IF result->>'status'<>'active' THEN RAISE EXCEPTION 'Owner action did not start'; END IF;
 result:=public.v2_training_session_action_candidate(u,sess,action,'start',
    0,repeat('a',64),'2026-11-11','America/Chicago','2026-11-11 12:00+00');
 IF result->>'replayed'<>'true' THEN RAISE EXCEPTION 'Exact retry was not idempotent'; END IF;
 -- The same client action ID with a changed time is a different request.
 -- A caller-supplied duplicate fingerprint must NOT be trusted for replay.
 BEGIN
   PERFORM public.v2_training_session_action_candidate(u,sess,action,'start',
      0,repeat('a',64),'2026-11-11','America/Chicago','2026-11-11 12:01+00');
   RAISE EXCEPTION 'Changed request payload replayed as a success';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id',
    'ffffffff-ffff-4fff-8fff-ffffffffffff',true);
 BEGIN
   PERFORM public.v2_training_session_action_candidate(u,sess,
       'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee','pause',1,repeat('a',64),
       NULL,NULL,'2026-11-11 12:01+00');
   RAISE EXCEPTION 'Revoked/missing session permitted action';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 PERFORM pg_catalog.set_config('request.jwt.claim.session_id','',true);
 BEGIN
   PERFORM public.v2_training_session_action_candidate(u,sess,
       'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee','pause',1,repeat('a',64),
       NULL,NULL,'2026-11-11 12:01+00');
   RAISE EXCEPTION 'Missing session permitted action';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-246: expected-owner, active-session, idempotency and raw-writer isolation';
END $qa$;
RESET ROLE;
-- Physical session revocation is checked even when the client still presents
-- the same apparently valid JWT claim. Test before deleting the account.
DELETE FROM auth.sessions WHERE id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
SET ROLE authenticated;
SELECT pg_catalog.set_config('request.jwt.claim.session_id',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',false);
DO $revoked$
BEGIN
 BEGIN
  PERFORM public.v2_training_session_action_candidate(
   '11111111-1111-4111-8111-111111111111',
   'cccccccc-cccc-4ccc-8ccc-cccccccccccc',
   'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee','pause',1,
   repeat('a',64),NULL,NULL,'2026-11-11 12:01+00');
  RAISE EXCEPTION 'Deleted Auth session accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $revoked$;
RESET ROLE;
-- A deleted V2 identity also must not be reusable with stale claims.
DELETE FROM public.v2_profiles WHERE user_id='11111111-1111-4111-8111-111111111111';
SET ROLE authenticated;
DO $deleted$
BEGIN
 BEGIN
  PERFORM public.v2_training_session_action_candidate(
   '11111111-1111-4111-8111-111111111111',
   'cccccccc-cccc-4ccc-8ccc-cccccccccccc',
   'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee','pause',1,
   repeat('a',64),NULL,NULL,'2026-11-11 12:01+00');
  RAISE EXCEPTION 'Deleted V2 profile accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
END $deleted$;
RESET ROLE;
-- No production user data was affected.
