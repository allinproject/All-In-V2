\set ON_ERROR_STOP on
-- ALL-243: isolated PostgreSQL 17 operator / live Auth row / device registration.
-- Run after test-v2-device-ingest-two-owner-postgres.psql in a disposable DB.
CREATE TABLE auth.sessions(
 id uuid PRIMARY KEY,user_id uuid NOT NULL REFERENCES auth.users(id),
 not_after timestamptz
);
INSERT INTO auth.sessions(id,user_id,not_after) VALUES
 ('11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
  '11111111-1111-4111-8111-111111111111',now()+interval '1 day'),
 ('22222222-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
  '22222222-2222-4222-8222-222222222222',now()+interval '1 day'),
 ('33333333-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
  '11111111-1111-4111-8111-111111111111',now()-interval '1 day');
UPDATE public.v2_activity_sources SET source_device_ref='paired-trainer-42'
 WHERE id='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-DEVICE-REGISTRATION-CANDIDATE.sql
INSERT INTO allin_private.v2_device_registrations_candidate
 (id,user_id,device_ref,provider,certified_at,attestation_kind,attestation_reference_hash)
VALUES
 ('44444444-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
 '11111111-1111-4111-8111-111111111111','paired-trainer-42',
 'supported_equipment',now(),'equipment_paired',repeat('1',64)),
 ('55555555-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
 '22222222-2222-4222-8222-222222222222','other-device',
 'apple_watch',now(),'native_owner_verified',repeat('2',64));
\i /tmp/allin/docs/architecture/sql/V2-COMPLETED-ACTIVITY-DEVICE-OPERATOR-CANDIDATE.sql

-- Verify PostgreSQL role attributes rather than trusting comments.
DO $operator_contract$
BEGIN
 IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='allin_v2_ingest_operator'
    AND (rolsuper OR rolbypassrls OR rolinherit IS TRUE)) THEN
  RAISE EXCEPTION 'Ingest operator has elevated database capabilities';
 END IF;
 IF has_table_privilege('allin_v2_ingest_operator',
  'public.v2_activity_metric_values','INSERT') OR
  has_table_privilege('allin_v2_ingest_operator',
  'public.v2_completed_activities','UPDATE') OR
  has_table_privilege('authenticated',
  'allin_private.v2_device_registrations_candidate','SELECT') THEN
  RAISE EXCEPTION 'Ingest operator or client unexpectedly granted write/read';
 END IF;
END $operator_contract$;

SET ROLE allin_v2_ingest_operator;
SET request.jwt.claim.sub='11111111-1111-4111-8111-111111111111';
DO $auth_source$
DECLARE permitted integer;
BEGIN
 SELECT count(*) INTO permitted
 FROM auth.sessions s
 JOIN auth.users u ON u.id=s.user_id
 JOIN public.v2_completed_activities a ON a.user_id=u.id
 JOIN public.v2_activity_sources src ON src.activity_id=a.id AND src.user_id=a.user_id
 JOIN allin_private.v2_device_registrations_candidate r
  ON r.user_id=src.user_id AND r.device_ref=src.source_device_ref
  AND r.provider=src.provider AND r.revoked_at IS NULL
 WHERE s.id='11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
  AND s.user_id='11111111-1111-4111-8111-111111111111'
  AND (s.not_after IS NULL OR s.not_after>now())
  AND src.id='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 IF permitted<>1 THEN RAISE EXCEPTION 'Valid verified operator session/device missing'; END IF;
 IF EXISTS(
 SELECT 1 FROM public.v2_activity_sources
 WHERE user_id='22222222-2222-4222-8222-222222222222')
 OR EXISTS(
 SELECT 1 FROM allin_private.v2_device_registrations_candidate
 WHERE user_id='22222222-2222-4222-8222-222222222222') THEN
  RAISE EXCEPTION 'Another athlete data visible to operator';
 END IF;
 IF EXISTS(SELECT 1 FROM auth.sessions
  WHERE id='33333333-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
  AND (not_after IS NULL OR not_after>now())) THEN
  RAISE EXCEPTION 'Expired auth.sessions row accepted';
 END IF;
 BEGIN
  UPDATE public.v2_activity_sources SET quality='rejected'
   WHERE id='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
  RAISE EXCEPTION 'Operator could update source';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 RAISE NOTICE 'PASS ALL-243 live Auth-session lookup and registered-device ownership';
END $auth_source$;
-- Operator nonce is transactional and restricted to independently verified
-- owner; metric writer remains the existing NOLOGIN restricted role.
BEGIN;
INSERT INTO allin_private.v2_device_ingest_nonce_candidate
 (nonce_hash,owner_id,activity_id,source_id,callback_hash)
 VALUES(repeat('9',64),'11111111-1111-4111-8111-111111111111',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
 'cccccccc-cccc-4ccc-8ccc-cccccccccccc',repeat('8',64))
 ON CONFLICT(nonce_hash) DO NOTHING RETURNING nonce_hash;
SET LOCAL ROLE allin_v2_device_ingest;
SELECT pg_catalog.set_config('request.jwt.claim.sub',
 '11111111-1111-4111-8111-111111111111',true);
SELECT allin_private.v2_activity_append_scalar_candidate(
 '11111111-1111-4111-8111-111111111111',
 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
 'cccccccc-cccc-4ccc-8ccc-cccccccccccc',
 '99999999-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
 'draft_metric',1,'source_measured',121,NULL,NULL,repeat('a',64),'partial');
COMMIT;
RESET ROLE;
DO $proof$
BEGIN
 IF (SELECT count(*) FROM public.v2_activity_metric_values
  WHERE id='99999999-aaaa-4aaa-8aaa-aaaaaaaaaaaa')<>1 OR
 (SELECT count(*) FROM allin_private.v2_device_ingest_nonce_candidate
  WHERE nonce_hash=repeat('9',64))<>1 THEN
   RAISE EXCEPTION 'Operator nonce + canonical metric did not commit atomically';
 END IF;
END $proof$;
-- Expire session and revoke device; verify both state transitions are visible
-- to the operator's live DB authorization reader, without JWT-only trust.
UPDATE auth.sessions SET not_after=now()-interval '1 second'
 WHERE id='11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
UPDATE allin_private.v2_device_registrations_candidate
 SET revoked_at=now() WHERE id='44444444-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
SET ROLE allin_v2_ingest_operator;
SET request.jwt.claim.sub='11111111-1111-4111-8111-111111111111';
DO $revoked$
BEGIN
 IF EXISTS(SELECT 1 FROM auth.sessions
  WHERE id='11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
    AND (not_after IS NULL OR not_after>now()))
 OR EXISTS(SELECT 1 FROM allin_private.v2_device_registrations_candidate
  WHERE device_ref='paired-trainer-42' AND revoked_at IS NULL) THEN
   RAISE EXCEPTION 'Expired session or revoked device still eligible';
 END IF;
 RAISE NOTICE 'PASS ALL-243 expired session and revoked device fail closed';
END $revoked$;
RESET ROLE;
\echo 'PASS ALL-243 trusted operator and canonical scalar database transaction'
