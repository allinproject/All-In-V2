# V2 Supabase is an isolated, empty development project at present.
# Do not use it for existing-user sign-in until the identity/data migration strategy is approved.
EXPO_PUBLIC_SUPABASE_URL=https://xarhuczrtzuiljmtdaeu.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_V2_PUBLISHABLE_KEY

# ALL-247: canonical Fuel Food Log read is OFF until approved RPC schema,
# authenticated staging HTTP verification and device acceptance are completed.
# Never turn this on just to suppress an unavailable-state display.
EXPO_PUBLIC_V2_FUEL_DAY_READ_ENABLED=false
# ALL-247: manual Food writes are separately gated until native device acceptance.
EXPO_PUBLIC_V2_FUEL_MANUAL_WRITE_ENABLED=false

# ALL-248: Meal Plan/Pantry/Shopping and receipt/purchase RPCs are
# REVIEW-ONLY candidates, not deployed or device-accepted. Keep all disabled.
EXPO_PUBLIC_V2_KITCHEN_PLAN_ENABLED=false
EXPO_PUBLIC_V2_KITCHEN_STOCK_READ_ENABLED=false
EXPO_PUBLIC_V2_KITCHEN_MANUAL_SHOPPING_WRITE_ENABLED=false
EXPO_PUBLIC_V2_KITCHEN_PURCHASE_CONFIRM_ENABLED=false

# Never put service-role keys, production credentials, or provider secrets in the app.
# Optional Sentry client DSN (public identifier, not an auth token).
# Leave blank to disable Sentry event uploads until native acceptance is ready.
EXPO_PUBLIC_SENTRY_DSN=

# Set BOTH in a trusted native-build environment to activate the Sentry Expo plugin.
# Find slugs in Sentry Organization and Project Settings; do not guess values.
SENTRY_ORG=
SENTRY_PROJECT=

# SENTRY_AUTH_TOKEN is a private build secret; NEVER put it in EXPO_PUBLIC_*,
# this file, repository config, or screenshots. Source-map uploads remain gated.
