{
  "name": "@all-in-365/mobile-v2",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:auth": "node --experimental-strip-types --test src/auth/authRoute.test.ts src/auth/accessGateClient.test.ts src/auth/onboardingFlow.test.ts src/auth/authCallback.test.ts src/auth/passwordPolicy.test.ts",
    "test:calculator": "node --experimental-strip-types --test src/features/cookbook/recipeNutritionCalculator.test.ts src/features/cookbook/cookingYieldIntelligence.test.ts src/features/cookbook/cookingYieldReferenceCatalog.test.ts src/features/cookbook/foodDataCentral.test.ts src/features/cookbook/foodProductLookup.test.ts",
    "test:training-logic": "node --experimental-strip-types --test src/features/training/trainingPlanSynthesis.test.ts src/features/training/athleteHistoryContext.test.ts src/features/training/runningPerformancePrediction.test.ts src/features/training/trainingPlanLifecycle.test.ts src/features/training/raceCourseEvidence.test.ts",
    "test:provider-cache": "node --experimental-strip-types --test ../../supabase/functions/_shared/providerCache.node.test.mjs",
    "test:monitoring": "node --experimental-strip-types --test src/monitoring/sentryPrivacy.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "@sentry/react-native": "8.32.0",
    "expo-web-browser": "~58.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
